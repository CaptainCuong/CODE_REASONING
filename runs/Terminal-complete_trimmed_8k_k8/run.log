Sending keys: ['cat > index.html << \'EOF\'\n<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>Lydia Moreno - Research Profile</title>\n    <link rel="stylesheet" href="style/style.css">\n</head>\n<body>\n    <header>\n        <h1>Lydia Moreno</h1>\n        <p>Associate Professor of Computational Neuroscience</p>\n    </header>\n    <nav>\n        <ul>\n            <li><a href="about.html">About Me</a></li>\n            <li><a href="blog.html">Blog</a></li>\n            <li><a href="publications.html">Publications</a></li>\n        </ul>\n    </nav>\n    <main>\n        <section>\n            <h2>About Me</h2>\n            <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University\'s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n            <p><a href="about.html">Read more...</a></p>\n        </section>\n    </main>\n    <footer>\n        <p>Contact: <a href="mailto:lydia.moreno@riverbend.edu">lydia.moreno@riverbend.edu</a></p>\n    </footer>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > about.html << \'EOF\'\n<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>About Me</title>\n    <link rel="stylesheet" href="../style/style.css">\n</head>\n<body>\n    <header>\n        <h1>About Me</h1>\n    </header>\n    <main>\n        <section>\n            <h2>About Me</h2>\n            <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University\'s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n            <h3>Education</h3>\n            <ul>\n                <li><strong>Ph.D., Computational Biology</strong> - Baywood Institute of Technology, 2014–2019</li>\n                <li><strong>M.Sc., Bioinformatics</strong> - Riverbend University, 2012–2014</li>\n                <li><strong>B.Sc., Computer Science</strong> - Crestfield College of Engineering, 2008–2012</li>\n            </ul>\n            <h3>Research Interests</h3>\n            <ul>\n                <li>Neural Encoding & Decoding</li>\n                <li>Machine Learning for Biomedical Imaging</li>\n                <li>Single-Cell Omics</li>\n                <li>Explainable AI in Neuroscience</li>\n            </ul>\n            <h3>Skills</h3>\n            <ul>\n                <li>Python, R, C++</li>\n                <li>PyTorch, TensorFlow, scikit-learn, NetworkX</li>\n                <li>Nextflow, Snakemake, Docker, Kubernetes</li>\n                <li>MatLAB, Jupyter, Seurat, Scanpy</li>\n                <li>D3.js, Plotly, Matplotlib</li>\n            </ul>\n        </section>\n    </main>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
