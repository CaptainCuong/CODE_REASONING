Sending keys: ['cat > server.py << \'EOF\'\nimport flask\nfrom solana import Solana\nfrom solana.rpc import Client\nfrom solana.rpc.api import NetworkTypes\nfrom solana.rpc.request import Request\nfrom solana.rpc.response import Response\nfrom typing import Dict, Any, Optional, List\nimport json\nimport sys\n\napp = flask.Flask(__name__)\n\n# Connect to mainnet-beta network\nnetwork = NetworkTypes.mainnet_beta\nclient = Client(network)\n\n# Helper function to handle errors and return JSON with error key\ndef handle_error(error_msg: str) -> Dict[str, str]:\n    return {"error": error_msg}\n\n# /status endpoint\n@app.route(\'/status\')\ndef status():\n    try:\n        status_resp = client.get_status()\n        status_data = status_resp.data\n        # Convert slot number to int\n        slot = int(status_data[\'current_slot\'])\n        node_count = int(status_data[\'node_count\'])\n        return {\n            "status": status_data[\'status\'],\n            "network": status_data[\'network\'],\n            "current_slot": slot,\n            "node_count": node_count,\n            "version": status_data[\'version\']\n        }\n    except Exception as e:\n        return handle_error(f"Failed to get status: {e}")\n\n# /block/<slot_number>\n@app.route(\'/block/<int:slot_number>\')\ndef block_detail(slot_number):\n    try:\n        block_resp = client.get_block_by_slot(slot_number)\n        block_data = block_resp.data\n        # Convert to appropriate types\n        blockhash = block_data[\'blockhash\']\n        parent_slot = int(block_data[\'parent_slot\'])\n        previous_blockhash = block_data[\'previous_blockhash\']\n        block_height = int(block_data[\'block_height\'])\n        block_time = block_data[\'block_time\']\n        return {\n            "blockhash": blockhash,\n            "parent_slot": parent_slot,\n            "previous_blockhash": previous_blockhash,\n            "block_height": block_height,\n            "block_time": block_time\n        }\n    except Exception as e:\n        return handle_error(f"Failed to get block {slot_number}: {e}")\n\n# /transaction/<signature>\n@app.route(\'/transaction/<signature>\')\ndef transaction_detail(signature):\n    try:\n        tx_resp = client.get_transaction(signature)\n        tx_data = tx_resp.data\n        if tx_data is None:\n            return handle_error("Transaction not found")\n        # Convert to appropriate types\n        slot = int(tx_data[\'slot\'])\n        block_time = tx_data[\'block_time\']\n        success = tx_data[\'success\']\n        fee = float(tx_data[\'fee\']) if tx_data[\'fee\'] is not None else None\n        token_transfers = []\n        for transfer in tx_data[\'token_transfers\']:\n            token_transfers.append({\n                "account": transfer[\'account\'],\n                "mint": transfer[\'mint\'],\n                "amount": int(transfer[\'amount\'])\n            })\n        return {\n            "signature": signature,\n            "slot": slot,\n            "block_time": block_time,\n            "success": success,\n            "fee": fee,\n            "token_transfers": token_transfers\n        }\n    except Exception as e:\n        return handle_error(f"Failed to get transaction {signature}: {e}")\n\n# /account/<address>\n@app.route(\'/account/<address>\')\ndef account_detail(address):\n    try:\n        account_resp = client.get_account_info(address)\n        account_data = account_resp.data\n        if account_data is None:\n            return handle_error("Account not found")\n        # Convert to appropriate types\n        executable = account_data[\'executable\']\n        lamports = int(account_data[\'lamports\'])\n        owner = account_data[\'owner\']\n        rent_epoch = int(account_data[\'rent_epoch\'])\n        return {\n            "address": address,\n            "executable": executable,\n            "lamports": lamports,\n            "owner": owner,\n            "rent_epoch": rent_epoch\n        }\n    except Exception as e:\n        return handle_error(f"Failed to get account {address}: {e}")\n\n# /program/<program_id>/accounts\n@app.route(\'/program/<program_id>/accounts\')\ndef program_accounts(program_id):\n    try:\n        accounts_resp = client.get_program_accounts(program_id)\n        accounts_data = accounts_resp.data\n        total_accounts = int(accounts_data[\'total_accounts\'])\n        # Get default limit and offset from query parameters, else default\n        limit = int(request.args.get(\'limit\', 10))\n        offset = int(request.args.get(\'offset\', 0))\n        accounts_list = accounts_data[\'accounts\'][offset:offset+limit]\n        # Build accounts list with required details\n        accounts_list_return = []\n        for account in accounts_list:\n            accounts_list_return.append({\n                "pubkey": account[\'pubkey\'],\n                "account": {\n                    "executable": account[\'executable\'],\n                    "lamports": int(account[\'lamports\']),\n                    "owner": account[\'owner\'],\n                    "rent_epoch": int(account[\'rent_epoch\'])\n                }\n            })\n        return {\n            "program_id": program_id,\n            "total_accounts": total_accounts,\n            "limit": limit,\n            "offset": offset,\n            "accounts": accounts_list_return\n        }\n    except Exception as e:\n        return handle_error(f"Failed to get program accounts {program_id}: {e}")\n\nif __name__ == \'__main__\':\n    app.run(port=5000)\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
