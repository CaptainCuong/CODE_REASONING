Sending keys: ["cat > server.py << 'EOF'\nimport json\nimport sys\nfrom flask import Flask, request, abort\nfrom solana.rpc import client as rpc_client\nfrom solana.rpc.commitment import Commitment\nfrom solana.rpc.api import Namespace\nfrom solana import Solana\nfrom solana.account import Account\nfrom solana.block import Block\nfrom solana.signature import Signature\nfrom solana.transaction import Transaction\nfrom solana.token import Token\nfrom solana.token_account import TokenAccount\nfrom solana.program import Program\nfrom solana.pubkey import Pubkey\n\n# Set up Solana client\nsolana = Solana('https://rpc.mainnet-beta.solana.com', timeout=10)\n\napp = Flask(__name__)\n\n# Helper function to get network status\ndef get_network_status():\n    try:\n        status = solana.status()\n        # Extract network, current slot, node count, version\n        network = status['network']\n        current_slot = status['current_slot']\n        node_count = status['node_count']\n        version = status['version']\n        return {\n            'status': 'online',\n            'network': network,\n            'current_slot': current_slot,\n            'node_count': node_count,\n            'version': version\n        }\n    except Exception as e:\n        return {'error': str(e)}\n\n# /status endpoint\n@app.route('/status')\ndef status():\n    status_data = get_network_status()\n    if 'error' in status_data:\n        return json.dumps({'error': status_data['error']})\n    return json.dumps(status_data)\n\n# /block/<slot_number>\n@app.route('/block/<int:slot_number>')\ndef block_details(slot_number):\n    try:\n        block = Block(slot_number)\n        block_data = block.to_dict()\n        # Convert some fields to JSON-serializable\n        block_data['block_hash'] = block.block_hash\n        block_data['parent_slot'] = block.parent_slot\n        block_data['previous_block_hash'] = block.previous_block_hash\n        block_data['block_height'] = block.height\n        block_data['block_time'] = block.timestamp\n        return json.dumps(block_data)\n    except Exception as e:\n        return json.dumps({'error': str(e)})\n\n# /transaction/<signature>\n@app.route('/transaction/<signature>')\ndef transaction_details(signature):\n    try:\n        transaction = Transaction.from_signature(signature)\n        tx_data = transaction.to_dict()\n        # Convert some fields\n        tx_data['signature'] = transaction.signature\n        tx_data['slot'] = transaction.slot\n        tx_data['block_time'] = transaction.timestamp\n        tx_data['success'] = transaction.is_success\n        tx_data['fee'] = transaction.fee\n        # Token transfers\n        token_transfers = []\n        for transfer in transaction.token_transfers:\n            token_transfers.append({\n                'account': transfer.account.to_string(),\n                'mint': transfer.mint.to_string(),\n                'amount': str(transfer.amount)\n            })\n        tx_data['token_transfers'] = token_transfers\n        return json.dumps(tx_data)\n    except Exception as e:\n        return json.dumps({'error': str(e)})\n\n# /account/<address>\n@app.route('/account/<address>')\ndef account_details(address):\n    try:\n        account = Account(address)\n        account_data = account.to_dict()\n        return json.dumps(account_data)\n    except Exception as e:\n        return json.dumps({'error': str(e)})\n\n# /program/<program_id>/accounts\n@app.route('/program/<program_id>/accounts')\ndef program_accounts(program_id, limit=10, offset=0):\n    try:\n        program = Program(program_id)\n        accounts = program.get_accounts(limit, offset)\n        result = {\n            'program_id': program_id,\n            'total_accounts': len(accounts),\n            'limit': limit,\n            'offset': offset,\n            'accounts': []\n        }\n        for account in accounts:\n            account_info = account.to_dict()\n            result['accounts'].append(account_info)\n        return json.dumps(result)\n    except Exception as e:\n        return json.dumps({'error': str(e)})\n\nif __name__ == '__main__':\n    app.run(port=5000, debug=True)\nEOF\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
