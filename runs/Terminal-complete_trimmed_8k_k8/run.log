Sending keys: ["cat > run_sentiment.py << 'EOF'\nimport sys\nimport os\nimport json\nfrom flask import Flask, request, jsonify\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\n\n# Model and tokenizer paths\nmodel_path = '/app/model_cache/sentiment_model'\ntokenizer_path = model_path + '/tokenizer'\n\n# Load model and tokenizer\nmodel = AutoModelForSequenceClassification.from_pretrained(model_path)\ntokenizer = AutoTokenizer.from_pretrained(tokenizer_path)\n\nprint('Model loaded successfully')\n\n# Create Flask app\napp = Flask(__name__)\n\n@app.route('/sentiment', methods=['POST'])\ndef sentiment():\n    try:\n        data = request.get_json()\n        if 'text' not in data:\n            return {'error': 'Missing text field in request'}, 400\n        text = data['text']\n        # Tokenize\n        inputs = tokenizer(text, return_tensors='pt')\n        # Predict\n        outputs = model(**inputs)\n        # Get probabilities\n        probabilities = outputs.logits\n        # Assuming the model outputs two classes: positive and negative (order may vary)\n        # We'll map to positive/negative based on the highest probability\n        pos_prob = probabilities[0].item() if probabilities[0].item() > probabilities[1].item() else probabilities[1].item()\n        neg_prob = probabilities[1].item() if probabilities[1].item() > probabilities[0].item() else probabilities[0].item()\n        # Normalize to confidence scale 0-1\n        total = pos_prob + neg_prob\n        if total == 0:\n            confidence = {'positive': 0.5, 'negative': 0.5}\n        else:\n            confidence = {'positive': pos_prob / total, 'negative': neg_prob / total}\n        # Determine sentiment\n        if pos_prob > neg_prob:\n            sentiment = 'positive'\n        else:\n            sentiment = 'negative'\n        # Return\n        return {\n            'sentiment': sentiment,\n            'confidence': confidence\n        }\n    except Exception as e:\n        return {'error': str(e)}, 500\n\nif __name__ == '__main__':\n    # Run on port 5000, host 0.0.0.0\n    app.run(host='0.0.0.0', port=5000, debug=False)\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
