e:\n        results["G"]["x0"] = 0.0\n        results["G"]["gamma"] = 0.0\n        results["G"]["amplitude"] = 0.0\n        results["G"]["offset"] = 0.0\n    if params_2d:\n        x0, gamma, amp, offset = params_2d\n        results["2D"]["x0"] = x0\n        results["2D"]["gamma"] = gamma\n        results["2D"]["amplitude"] = amp\n        results["2D"]["offset"] = offset\n    else:\n        results["2D"]["x0"] = 0.0\n        results["2D"]["gamma"] = 0.0\n        results["2D"]["amplitude"] = 0.0\n        results["2D"]["offset"] = 0.0\n    with open(\'results.json\', \'w\') as f:\n        json.dump(results, f, indent=2)\n    print(\'Results written to results.json\')\n    print(json.dumps(results, indent=2))\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
