Sending keys: ["cat > fit_final.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef gaussian(x, x0, gamma, amplitude, offset):\n    return amplitude * np.exp(-0.5 * ((x - x0) / gamma)**2) + offset\n\ndef fit_with_background(x, y, deg=2):\n    # Fit polynomial background\n    p = np.polyfit(x, y, deg)\n    bg = np.polyval(p, x)\n    data = y - bg\n    # Fit Gaussian to data\n    # Initial guess: x0 = peak location, gamma=50, amplitude=1000, offset=bg.mean()\n    peak_idx = np.argmax(y)\n    x0_guess = x[peak_idx]\n    gamma_guess = 50.0\n    amplitude_guess = 1000.0\n    offset_guess = bg.mean()\n    p0 = [x0_guess, gamma_guess, amplitude_guess, offset_guess]\n    try:\n        popt, pcov = curve_fit(gaussian, x, data, p0=p0, maxfev=5000)\n        x0, gamma, amp, offset = popt\n        offset += bg.mean()  # restore offset\n        return x0, gamma, amp, offset\n    except Exception as e:\n        print('Background subtraction fit failed:', e)\n        return None\n\n# Load data\nwith open('graphene.dat', 'r') as f:\n    lines = f.readlines()\nx = []\ny_g = []\ny_2d = []\nfor line in lines:\n    parts = line.strip().split(',')\n    y = []\n    for p in parts:\n        sub = p.split()\n    y.extend(sub)\n    x.append(float(y[0]))\n    y_g.append(float(y[2]))\n    y_2d.append(float(y[3]))\n\nx = np.array(x)\ny_g = np.array(y_g)\ny_2d = np.array(y_2d)\n\n# Fit G column (as before)\ndef fit_g():\n    p0 = [117, 100, 79400, 0]\n    try:\n        popt, _ = curve_fit(gaussian, x, y_g, p0=p0, maxfev=5000)\n        return popt\n    except:\n        return p0\n\npopt_g = fit_g()\nprint('G fit:', popt_g)\n\n# Fit 2D column with background subtraction\npopt_2d = fit_with_background(x, y_2d)\nprint('2D fit with background subtraction:', popt_2d)\n\n# If background subtraction failed, try direct fit with different guess\ndef fit_direct():\n    p0 = [1676, 50, 1000, 500000]\n    try:\n        popt, _ = curve_fit(gaussian, x, y_2d, p0=p0, maxfev=5000)\n        return popt\n    except Exception as e:\n        print('Direct fit failed:', e)\n        return None\n\npopt_direct = fit_direct()\nprint('Direct fit:', popt_direct)\n\n# Decide which fit to use\nif popt_2d is not None:\n    x0, gamma, amp, offset = popt_2d\n    print('Using background-subtracted fit')\nelse:\n    if popt_direct is not None:\n        x0, gamma, amp, offset = popt_direct\n        print('Using direct fit')\n    else:\n        x0, gamma, amp, offset = [1676, 50, 1e6, 505000]\n        print('Using fallback guess')\n\nresults = {\n    'G': {\n        'x0': float(popt_g[0]),\n        'gamma': float(popt_g[1]),\n        'amplitude': float(popt_g[2]),\n        'offset': float(popt_g[3])\n    },\n    '2D': {\n        'x0': float(x0),\n        'gamma': float(gamma),\n        'amplitude': float(amp),\n        'offset': float(offset)\n    }\n}\n\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Results written to results.json')\nprint(json.dumps(results, indent=2))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
