Sending keys: ['cat > /app/intrusion_detector.sh << \'EOF\'\n#!/bin/bash\nset -euo pipefail\n\nLOG_DIR="/app/logs"\nRULES_FILE="/app/rules/detection_rules.json"\nREPORT_DIR="/app/reports"\n\n# Parse JSON rules\nfunction parse_rules() {\n    jq -r \'.rules[] | .id + "|" + .pattern + "|" + .severity + "|" + (.threshold|tostring) + "|" + (.timeframe|tostring)\' "$RULES_FILE\n}\n\n# Parse log line for auth.log\nfunction parse_auth_line() {\n    line="$1"\n    # Extract timestamp (format: Apr 10 08:12:33)\n    if [[ "$line" =~ (\\w{3}) (\\d{2}) (\\d{2}):(\\d{2}):(\\d{2}) ]]; then\n        date="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"\n        time="${BASH_REMATCH[3]}:${BASH_REMATCH[4]}:${BASH_REMATCH[5]}"\n        timestamp="$date $time"\n        # Extract IP: "from <IP>"\n        if [[ "$line" =~ from (\\S+) ]]; then\n            ip="${BASH_REMATCH[1]}"\n        else\n            ip=""\n        fi\n    else\n        timestamp=""\n        ip=""\n    fi\n    echo "$timestamp|$ip|$line"\n}\n\n# Parse log line for http.log\nfunction parse_http_line() {\n    line="$1"\n    # Extract timestamp: [10/Apr/2023:08:30:42 +0000]\n    if [[ "$line" =~ \\[(\\d{2}/\\w{3}/\\d{4}):(\\d{2}):(\\d{2}):(\\d{2}) ]]; then\n        date="${BASH_REMATCH[1]}"\n        time="${BASH_REMATCH[2]}:${BASH_REMATCH[3]}:${BASH_REMATCH[4]}"\n        timestamp="$date $time"\n        # Extract IP: first token after timestamp\n        ip=$(echo "$line" | awk \'{print $1}\')\n    else\n        timestamp=""\n        ip=""\n    fi\n    echo "$timestamp|$ip|$line"\n}\n\n# Main detection\nfunction main() {\n    # Ensure report directory exists\n    mkdir -p "$REPORT_DIR"\n    \n    # Get current time in epoch seconds\n    current_time=$(date +%s)\n    \n    # Parse rules\n    rules=$(parse_rules)\n    while IFS="|" read -r rule_id pattern severity threshold timeframe; do\n        # Initialize data for this rule\n        declare -A ip_counts\n        # Scan auth.log\n        while IFS= read -r auth_line; do\n            parsed=$(parse_auth_line "$auth_line")\n            if [[ -n "$parsed" ]]; then\n                ts_ip_line=$(echo "$parsed" | tr \'|\' \'\\n\')\n                timestamp=$(echo "$ts_ip_line" | head -1)\n                ip=$(echo "$ts_ip_line" | tail -1)\n                if [[ "$timestamp" =~ ^[A-Za-z]{3} [0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then\n                    # Convert timestamp to epoch seconds\n                    epoch=$(date -d "$timestamp" +%s 2>/dev/null || echo 0)\n                    if [[ $epoch -ge $((current_time - timeframe)) ]]; then\n                        if [[ "$line" =~ $pattern ]]; then\n                            ((ip_counts[$ip]++))\n                        fi\n                    fi\n                fi\n            fi\n        done < <(grep -h "$pattern" "$LOG_DIR/auth.log")\n        \n        # Scan http.log\n        while IFS= read -r http_line; do\n            parsed=$(parse_http_line "$http_line")\n            if [[ -n "$parsed" ]]; then\n                ts_ip_line=$(echo "$parsed" | tr \'|\' \'\\n\')\n                timestamp=$(echo "$ts_ip_line" | head -1)\n                ip=$(echo "$ts_ip_line" | tail -1)\n                if [[ "$timestamp" =~ ^[A-Za-z]{3} [0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then\n                    epoch=$(date -d "$timestamp" +%s 2>/dev/null || echo 0)\n                    if [[ $epoch -ge $((current_time - timeframe)) ]]; then\n                        if [[ "$http_line" =~ $pattern ]]; then\n                            ((ip_counts[$ip]++))\n                        fi\n                    fi\n                fi\n            fi\n        done < <(grep -h "$pattern" "$LOG_DIR/http.log")\n        \n        # Prepare data for JSON\n        # Build IPs list\n        ips=$(echo "${!ip_counts[@]}" | tr \'\\n\' \',\' | sed \'s/,$//\')\n        # Count total matches\n        total=$(echo "${#ip_counts[@]}" | awk \'{sum += $1} END {print sum}\')\n        \n        # Add to events array\n        # We\'ll store in temporary files for JSON generation\n        echo "$rule_id|$severity|$total|$ips" >> "$REPORT_DIR/events.txt"\n        \n        # For alert generation, we need to check threshold\n        if [[ $total -ge $threshold ]]; then\n            echo "$rule_id|$severity|$total|$ips" >> "$REPORT_DIR/alerts.txt"\n        fi\n    done <<< "$rules"\n    \n    # Generate report.json\n    if [[ -f "$REPORT_DIR/events.txt" ]]; then\n        # Build statistics dictionary\n        stats=$(while IFS="|" read -r rule_id severity total ips; do\n            echo "$rule_id:$total"\n        done < "$REPORT_DIR/events.txt" | tr \'\\n\' \',\' | sed \'s/,$//\')\n        \n        # Build events array\n        events=$(cat "$REPORT_DIR/events.txt" | while IFS="|" read -r rule_id severity total ips; do\n            echo "    {\\n      "id": \\"$rule_id\\",\\n      "severity": \\"$severity\\",\\n      "matches": $total,\\n      "ips": \\"$ips\\"\\n    },"\n        done | sed \'$s/,$//\')\n        \n        # Create report.json\n        cat > "$REPORT_DIR/report.json" << EOF\n{\n  "timestamp": "$(date -u +\'%Y-%m-%dT%H:%M:%SZ\')",\n  "events": [\n$events\n  ],\n  "statistics": {\n    $stats\n  }\n}\nEOF\n    fi\n    \n    # Generate alert.json\n    if [[ -f "$REPORT_DIR/alerts.txt" ]]; then\n        alerts=$(cat "$REPORT_DIR/alerts.txt" | while IFS="|" read -r rule_id severity total ips; do\n            echo "    {\\n      "id": \\"$rule_id\\",\\n      "severity": \\"$severity\\",\\n      "matches": $total,\\n      "ips": \\"$ips\\"\\n    },"\n        done | sed \'$s/,$//\')\n        \n        cat > "$REPORT_DIR/alert.json" << EOF\n{\n  "timestamp": "$(date -u +\'%Y-%m-%dT%H:%M:%SZ\')",\n  "alerts": [\n$alerts\n  ]\n}\nEOF\n    fi\n    \n    echo "Detection complete. Reports written to $REPORT_DIR/"\n}\n\n# Execute main\nmain\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
