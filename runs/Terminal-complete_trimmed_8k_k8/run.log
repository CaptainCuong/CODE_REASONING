Sending keys: ["cat > process.py << 'EOF'\nimport pandas as pd\nimport json\nfrom datetime import datetime, timezone\nimport os\n\n# Load data\ndepartments = pd.read_csv('data/departments.csv')\nemployees = pd.read_csv('data/employees.csv')\nprojects = pd.read_csv('data/projects.csv')\n\n# Helper to split string by semicolon\ndef split_list(val):\n    if pd.isna(val):\n        return []\n    return val.split(';')\n\n# Build department dict\ndept_dict = {}\nfor _, row in departments.iterrows():\n    dept_id = row['id']\n    dept_dict[dept_id] = {\n        'id': row['id'],\n        'name': row['name'],\n        'budget': float(row['budget']),\n        'employees': [],\n        'projects': []\n    }\n\n# Add employees\nfor _, emp in employees.iterrows():\n    dept_id = emp['department_id']\n    if dept_id in dept_dict:\n        emp_obj = {\n            'id': emp['id'],\n            'name': emp['name'],\n            'position': emp['position'],\n            'skills': split_list(emp['skills']),\n            'years_of_service': int(emp['years_of_service'])\n        }\n        dept_dict[dept_id]['employees'].append(emp_obj)\n\n# Add projects\nfor _, proj in projects.iterrows():\n    dept_id = proj['department_id']\n    if dept_id in dept_dict:\n        members = split_list(proj['member_ids'])\n        proj_obj = {\n            'name': proj['name'],\n            'status': proj['status'],\n            'members': members,\n            'deadline': proj['deadline']\n        }\n        dept_dict[dept_id]['projects'].append(proj_obj)\n\n# Build organization\norganization = {\n    'name': 'Organization',\n    'founded': '2024-01-01',\n    'departments': list(dept_dict.values())\n}\n\n# Statistics\nbudgets = [d['budget'] for d in organization['departments']]\naverage_department_budget = sum(budgets) / len(budgets) if budgets else 0\n\nemployees_all = []\nfor dept in organization['departments']:\n    employees_all.extend(dept['employees'])\ntotal_employees = len(employees_all)\n\nskill_distribution = {}\nfor emp in employees_all:\n    for skill in emp['skills']:\n        skill_distribution[skill] = skill_distribution.get(skill, 0) + 1\n\ndepartment_sizes = {}\nfor dept in organization['departments']:\n    department_sizes[dept['id']] = len(dept['employees'])\n\nproject_status_distribution = {}\nfor dept in organization['departments']:\n    for proj in dept['projects']:\n        status = proj['status']\n        project_status_distribution[status] = project_status_distribution.get(status, 0) + 1\n\naverage_years_of_service = sum(e['years_of_service'] for e in employees_all) / total_employees if total_employees else 0\n\nstatistics = {\n    'averageDepartmentBudget': average_department_budget,\n    'totalEmployees': total_employees,\n    'skillDistribution': skill_distribution,\n    'departmentSizes': department_sizes,\n    'projectStatusDistribution': project_status_distribution,\n    'averageYearsOfService': average_years_of_service\n}\n\n# Metadata\nmetadata = {\n    'version': '1.0',\n    'timestamp': datetime.now(timezone.utc).isoformat(),\n    'generator': 'csv_to_json'\n}\n\n# Final output\noutput = {\n    'metadata': metadata,\n    'organization': organization,\n    'statistics': statistics\n}\n\n# Write to file\nwith open('organization.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint('organization.json created')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
