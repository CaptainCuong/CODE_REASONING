Sending keys: ['cat > server.py << \'EOF\'\nimport json\nimport flask\nfrom solana import Solana\nfrom solana.rpc import RpcClient\nfrom solana.rpc.api import RpcMethod\nfrom solana.rpc.errors importRpcError\nfrom solana.utils import to_bytes, to_string\nfrom solana.web3 import Web3\nimport sys\n\napp = flask.Flask(__name__)\n\n# Connect to mainnet-beta\nsolana = Solana(\'https://mainnet-beta-rpc.cluster0001.solanafoundation.com\')\nweb3 = Web3(solana)\n\n# Helper to handle exceptions and return error JSON\ndef handle_error(e, endpoint):\n    return flask.jsonify({"error": str(e)})\n\n# /status endpoint\n@app.route(\'/status\')\ndef status():\n    try:\n        status = web3.cluster.status()\n        network = status[\'network\']\n        current_slot = status[\'current_slot\']\n        node_count = status[\'node_count\']\n        version = status[\'version\']\n        return flask.jsonify({\n            "status": "online",\n            "network": network,\n            "current_slot": current_slot,\n            "node_count": node_count,\n            "version": version\n        })\n    except Exception as e:\n        return handle_error(e, \'/status\')\n\n# /block/<slot_number>\n@app.route(\'/block/<int:slot>\')\ndef block_details(slot):\n    try:\n        block = web3.block.get_block_by_slot(slot)\n        # block is a dict with fields: blockhash, parent_slot, previous_blockhash, block_height, block_time\n        return flask.jsonify({\n            "blockhash": block[\'blockhash\'],\n            "parent_slot": block[\'parent_slot\'],\n            "previous_blockhash": block[\'previous_blockhash\'],\n            "block_height": block[\'block_height\'],\n            "block_time": block[\'block_time\']\n        })\n    except Exception as e:\n        return handle_error(e, f\'/block/{slot}\')\n\n# /transaction/<signature>\n@app.route(\'/transaction/<signature>\')\ndef transaction_details(signature):\n    try:\n        # The transaction might be in the ledger; we can get the transaction by signature.\n        # The Solana RPC provides transaction.get_transaction_by_signature\n        tx = web3.transaction.get_transaction_by_signature(signature)\n        # tx is a dict with fields: signature, slot, block_time, success, fee, token_transfers\n        # token_transfers is a list of dicts with account, mint, amount\n        return flask.jsonify({\n            "signature": tx[\'signature\'],\n            "slot": tx[\'slot\'],\n            "block_time": tx[\'block_time\'],\n            "success": tx[\'success\'],\n            "fee": tx[\'fee\'],\n            "token_transfers": tx[\'token_transfers\']\n        })\n    except Exception as e:\n        return handle_error(e, f\'/transaction/{signature}\')\n\n# /account/<address>\n@app.route(\'/account/<address>\')\ndef account_details(address):\n    try:\n        account = web3.account.get_account_by_address(address)\n        return flask.jsonify({\n            "address": account[\'address\'],\n            "executable": account[\'executable\'],\n            "lamports": account[\'lamports\'],\n            "owner": account[\'owner\'],\n            "rent_epoch": account[\'rent_epoch\']\n        })\n    except Exception as e:\n        return handle_error(e, f\'/account/{address}\')\n\n# /program/<program_id>/accounts\n@app.route(\'/program/<program_id>/accounts\')\ndef program_accounts(program_id):\n    try:\n        # The RPC endpoint for program accounts is: transaction.get_program_accounts_by_program_id\n        # It returns a list of accounts owned by the program.\n        # We need to implement pagination.\n        limit = flask.request.args.get(\'limit\', 10)\n        offset = flask.request.args.get(\'offset\', 0)\n        accounts = web3.transaction.get_program_accounts_by_program_id(program_id, limit, offset)\n        # accounts is a dict with: program_id, total_accounts, accounts\n        # each account has pubkey, account (with executable, lamports, owner, rent_epoch)\n        result = {\n            "program_id": accounts[\'program_id\'],\n            "total_accounts": accounts[\'total_accounts\'],\n            "limit": limit,\n            "offset": offset,\n            "accounts": accounts[\'accounts\']\n        }\n        return flask.jsonify(result)\n    except Exception as e:\n        return handle_error(e, f\'/program/{program_id}/accounts\')\n\nif __name__ == \'__main__\':\n    app.run(port=5000, debug=True)\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
