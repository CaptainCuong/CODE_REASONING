Sending keys: ["cat > evaluate.py << 'EOF'\nimport json\nfrom mteb import Task\nfrom mteb.models import SentenceTransformer\nfrom mteb.evaluation import Evaluator\nimport torch\n\n# Load model\nmodel = SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')\nprint('Model loaded')\nprint('Commit hash:', model.card.commit_hash)\nprint('Card:', model.card)\n\n# STS12 task\nsts = Task('sts', 'sts-12')\nevaluator = Evaluator(model, tasks=[sts])\nresults = evaluator.run()\n\n# Extract the cosine_spearman score\nscore = results[0]['score']\nprint('Score:', score)\n\n# Prepare output directory\nimport os\nos.makedirs('results', exist_ok=True)\n\n# Format: results/{{hf model org}__{hf model name}}/{model commit id}/{task name}.json\n# From model card:\n#   org = 'sentence-transformers'\n#   name = 'all-MiniLM-L6-v2'\n#   commit_id = model.card.commit_hash\n#   task = 'sts-12'\n#   task_name = 'sts'\n\noutput_path = f'results/{model.card.org}__{model.card.name}/{model.card.commit_hash}/{task}.json'\nprint('Output path:', output_path)\n\n# Create result dictionary\nresult_dict = {\n    'task': 'sts',\n    'dataset': 'sts-12',\n    'score': score,\n    'model': {\n        'name': model.card.name,\n        'org': model.card.org,\n        'commit_hash': model.card.commit_hash\n    }\n}\n\nwith open(output_path, 'w') as f:\n    json.dump(result_dict, f, indent=2)\n\nprint('Results written to', output_path)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
