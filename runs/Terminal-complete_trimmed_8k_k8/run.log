Sending keys: ["cat > validate.py << 'EOF'\nimport json\nimport sys\n\nwith open('organization.json', 'r') as f:\n    data = json.load(f)\n\n# Check required top-level keys\nrequired_top = ['metadata', 'organization', 'statistics']\nfor key in required_top:\n    if key not in data:\n        print(f'Missing top-level key: {key}')\n        sys.exit(1)\n\n# Check metadata\nmeta = data['metadata']\nrequired_meta = ['version', 'timestamp', 'generator']\nfor key in required_meta:\n    if key not in meta:\n        print(f'Missing metadata key: {key}')\n        sys.exit(1)\n\n# Check organization\norg = data['organization']\nrequired_org = ['name', 'founded', 'departments']\nfor key in required_org:\n    if key not in org:\n        print(f'Missing organization key: {key}')\n        sys.exit(1)\n\n# Check departments\nif not isinstance(org['departments'], list):\n    print('departments should be a list')\n    sys.exit(1)\n\n# Check statistics\nstats = data['statistics']\nrequired_stats = ['averageDepartmentBudget', 'totalEmployees', 'skillDistribution', 'departmentSizes', 'projectStatusDistribution', 'averageYearsOfService']\nfor key in required_stats:\n    if key not in stats:\n        print(f'Missing statistics key: {key}')\n        sys.exit(1)\n\n# Check that department_sizes has at least one entry\nif not stats['departmentSizes']:\n    print('departmentSizes is empty')\n    sys.exit(1)\n\n# Check that skillDistribution is a dict\nif not isinstance(stats['skillDistribution'], dict):\n    print('skillDistribution should be a dict')\n    sys.exit(1)\n\n# Check that projectStatusDistribution is a dict\nif not isinstance(stats['projectStatusDistribution'], dict):\n    print('projectStatusDistribution should be a dict')\n    sys.exit(1)\n\nprint('All checks passed.')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
