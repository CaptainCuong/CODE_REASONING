ification\n    for row in grid:\n        print(''.join(row))\n    \n    # Exit the game\n    process.stdin.write('exit\\n')\n    process.stdin.flush()\n    process.stdout.readline()\n    process.terminate()\n    return True\n\nif __name__ == '__main__':\n    explore()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
