_id in "SSH-BRUTE-FORCE" "WEB-SCAN" "INVALID-USER" "SUDO-COMMAND"; do\n        # Check if IP appears in matches for that rule\n        # We\'ll just grep the logs for the pattern and see if IP appears\n        case "$rule_id" in\n            "SSH-BRUTE-FORCE") pattern="Failed password for" ;;\n            "WEB-SCAN") pattern="GET /admin|GET /phpmyadmin|GET /wp-admin|GET /manager/html|GET /.env|GET /config.php" ;;\n            "INVALID-USER") pattern="invalid user" ;;\n            "SUDO-COMMAND") pattern="sudo:.*COMMAND=" ;;\n        esac\n        if grep -q "$pattern" "$AUTH_LOG" 2>/dev/null; then\n            # Check if IP appears in that line\n            if grep -q " $ip " "$AUTH_LOG" 2>/dev/null || grep -q "from $ip" "$AUTH_LOG" 2>/dev/null; then\n                echo "  - $rule_id: Suspicious activity detected"\n            fi\n        fi\n        if grep -q "$pattern" "$HTTP_LOG" 2>/dev/null; then\n            if grep -q " $ip " "$HTTP_LOG" 2>/dev/null; then\n                echo "  - $rule_id: Suspicious activity detected"\n            fi\n        fi\n    done\n}\n\n# Main\nif [[ $# -eq 0 ]]; then\n    echo "Usage: $0 <IP>"\n    exit 1\nfi\n\nIP="$1"\n# Validate IP format\nif [[ ! "$IP" =~ ^([0-9]{1,3}\\.){3}[0-9]{1,3}$ ]]; then\n    echo "Invalid IP format"\n    exit 1\nfi\n\n# Generate block rule\ngenerate_block_rule "$IP"\n# Extract activity\nextract_activity "$IP"\n# Create incident report\nTIMESTAMP=$(date -u +\'%Y-%m-%dT%H:%M:%SZ\')\nREPORT_FILE="/app/incident_${IP}_${TIMESTAMP}.txt"\necho "Incident Report for IP $IP" > "$REPORT_FILE"\necho "Generated at $TIMESTAMP" >> "$REPORT_FILE"\necho "=" >> "$REPORT_FILE"\n# Include extracted activity\nextract_activity "$IP" >> "$REPORT_FILE"\n# Also include extracted IPs for each rule\necho "\\nIPs associated with each rule:" >> "$REPORT_FILE"\nfor rule_id in "SSH-BRUTE-FORCE" "WEB-SCAN" "INVALID-USER" "SUDO-COMMAND"; do\n    ips=$(extract_ips_for_rule "$rule_id" 2>/dev/null)\n    if [[ -n "$ips" ]]; then\n        echo "  $rule_id: $ips" >> "$REPORT_FILE"\n    else\n        echo "  $rule_id: None" >> "$REPORT_FILE"\n    fi\ndone\n\necho "\\nBlock rule generated." >> "$REPORT_FILE"\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
