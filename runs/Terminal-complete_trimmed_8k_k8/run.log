Sending keys: ['cat > server.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nfrom flask import Flask, request, abort\nfrom solana import Solana\nfrom solana.rpc import RpcClient\nfrom solana.rpc.requests import GetBlockWithTransactions, GetTransaction, GetAccountInfo, GetProgramAccounts\nimport sys\n\napp = Flask(__name__)\n\n# Connect to mainnet-beta\nclient = RpcClient("https://api.mainnet-beta.solana.com")\nsolana = Solana(client)\n\n# Helper to get network status\ndef get_network_status():\n    # Get network info\n    network = "mainnet-beta"\n    # Get current slot\n    slot = solana.get_slot()\n    # Get node count (approximate via RPC)\n    # We can use get_nodes_in_cluster\n    nodes = solana.get_nodes_in_cluster()\n    node_count = len(nodes) if nodes else 0\n    # Get version\n    version = solana.get_version()\n    return {\n        "status": "online",  # assuming we can connect\n        "network": network,\n        "current_slot": slot,\n        "node_count": node_count,\n        "version": version\n    }\n\n# /status endpoint\n@app.route(\'/status\', methods=[\'GET\'])\ndef status():\n    try:\n        return json.dumps(get_network_status())\n    except Exception as e:\n        return json.dumps({"error": str(e)})\n\n# /block/<slot_number>\n@app.route(\'/block/<int:slot>\', methods=[\'GET\'])\ndef block_details(slot):\n    try:\n        block = solana.get_block_by_slot(slot)\n        if block is None:\n            return json.dumps({"error": f"Block not found for slot {slot}"})\n        blockhash = block.blockhash\n        parent_slot = block.parent_slot\n        previous_blockhash = block.previous_blockhash\n        block_height = block.block_height\n        block_time = block.block_time\n        return json.dumps({\n            "blockhash": blockhash,\n            "parent_slot": parent_slot,\n            "previous_blockhash": previous_blockhash,\n            "block_height": block_height,\n            "block_time": block_time\n        })\n    except Exception as e:\n        return json.dumps({"error": str(e)})\n\n# /transaction/<signature>\n@app.route(\'/transaction/<signature>\', methods=[\'GET\'])\ndef transaction_details(signature):\n    try:\n        tx = solana.get_transaction(signature)\n        if tx is None:\n            return json.dumps({"error": f"Transaction not found with signature {signature}"})\n        # Extract fields\n        slot = tx.slot\n        block_time = tx.block_time\n        success = tx.success\n        fee = tx.fee\n        # token_transfers\n        token_transfers = []\n        for transfer in tx.token_transfers:\n            token_transfers.append({\n                "account": transfer.account,\n                "mint": transfer.mint,\n                "amount": transfer.amount\n            })\n        return json.dumps({\n            "signature": signature,\n            "slot": slot,\n            "block_time": block_time,\n            "success": success,\n            "fee": fee,\n            "token_transfers": token_transfers\n        })\n    except Exception as e:\n        return json.dumps({"error": str(e)})\n\n# /account/<address>\n@app.route(\'/account/<address>\', methods=[\'GET\'])\ndef account_details(address):\n    try:\n        account = solana.get_account_info(address)\n        if account is None:\n            return json.dumps({"error": f"Account not found with address {address}"})\n        lamports = account.lamports\n        owner = account.owner\n        rent_epoch = account.rent_epoch\n        executable = account.executable\n        return json.dumps({\n            "address": address,\n            "executable": executable,\n            "lamports": lamports,\n            "owner": owner,\n            "rent_epoch": rent_epoch\n        })\n    except Exception as e:\n        return json.dumps({"error": str(e)})\n\n# /program/<program_id>/accounts\n@app.route(\'/program/<program_id>/accounts\', methods=[\'GET\'])\ndef program_accounts(program_id):\n    try:\n        # Default limit and offset\n        limit = request.args.get(\'limit\', 10)\n        offset = request.args.get(\'offset\', 0)\n        accounts = solana.get_program_accounts(program_id, limit=limit, offset=offset)\n        total = solana.get_program_accounts_count(program_id)\n        result = []\n        for acc in accounts:\n            result.append({\n                "pubkey": acc.pubkey,\n                "account": {\n                    "executable": acc.executable,\n                    "lamports": acc.lamports,\n                    "owner": acc.owner,\n                    "rent_epoch": acc.rent_epoch\n                }\n            })\n        return json.dumps({\n            "program_id": program_id,\n            "total_accounts": total,\n            "limit": limit,\n            "offset": offset,\n            "accounts": result\n        })\n    except Exception as e:\n        return json.dumps({"error": str(e)})\n\nif __name__ == \'__main__\':\n    app.run(port=5000, debug=True)\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
