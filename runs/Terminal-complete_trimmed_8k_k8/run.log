Sending keys: ["cat > bitcoin_service.py << 'EOF'\n#!/usr/bin/env python3\n\nfrom bitcoinlib.rpc import RPCClient\nfrom flask import Flask, request, json, abort, make_response\nimport sys\nfrom typing import Dict, Any, List, Optional\n\n# Create Flask app\napp = Flask(__name__)\n\n# RPC client configuration\nrpc_config = {\n    'host': 'localhost',\n    'port': 8333,\n    'user': '',\n    'password': '',\n}\n\n# Initialize RPC client\nrpc_client = RPCClient(rpc_config)\n\n# Connection status\nconnected = False\ntry:\n    # Test connection\n    result = rpc_client.getinfo()\n    connected = True\nexcept Exception as e:\n    connected = False\n\n# Helper function to get connection status\ndef get_connection_status() -> Dict[str, Any]:\n    return {\n        'status': 'online' if connected else 'offline',\n        'error': 'Connection to Bitcoin network failed' if not connected else None\n    }\n\n# Endpoint for block details\n@app.route('/block/<block_hash>', methods=['GET'])\ndef get_block(block_hash: str):\n    global connected\n    if not connected:\n        return make_response(json.dumps({'error': 'Not connected to Bitcoin network'}), 503)\n    try:\n        block = rpc_client.get_block(block_hash)\n        # Build response\n        response = {\n            'hash': block['hash'],\n            'height': block['height'],\n            'merkleroot': block['merkleroot'],\n            'time': block['timestamp'],\n            'nonce': block['nonce'],\n            'tx': [tx['txid'] for tx in block['tx']]\n        }\n        return make_response(json.dumps(response), 200)\n    except Exception as e:\n        # If block not found, return 404\n        return make_response(json.dumps({'error': f'Block {block_hash} not found'}), 404)\n\n# Endpoint for transaction details\n@app.route('/transaction/<txid>', methods=['GET'])\ndef get_transaction(txid: str):\n    global connected\n    if not connected:\n        return make_response(json.dumps({'error': 'Not connected to Bitcoin network'}), 503)\n    try:\n        tx = rpc_client.get_transaction(txid)\n        # Build response\n        vin = []\n        for vin_entry in tx['vin']:\n            vin.append({\n                'coinbase': vin_entry.get('coinbase', ''),\n                'sequence': vin_entry['sequence']\n            })\n        vout = []\n        for vout_entry in tx['vout']:\n            vout.append({\n                'value': vout_entry['value'],\n                'n': vout_entry['n'],\n                'scriptPubKey': {\n                    'asm': vout_entry['scriptPubKey']['asm'],\n                    'hex': vout_entry['scriptPubKey']['hex'],\n                    'type': vout_entry['scriptPubKey']['type']\n                }\n            })\n        response = {\n            'txid': tx['txid'],\n            'blockhash': tx['blockhash'],\n            'vin': vin,\n            'vout': vout\n        }\n        return make_response(json.dumps(response), 200)\n    except Exception as e:\n        return make_response(json.dumps({'error': f'Transaction {txid} not found'}), 404)\n\n# Endpoint for network status\n@app.route('/status', methods=['GET'])\ndef get_status():\n    status_info = get_connection_status()\n    return make_response(json.dumps(status_info), 200)\n\n# Main function\nif __name__ == '__main__':\n    app.run(host='0.0.0.0', port=5000, debug=False)\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
