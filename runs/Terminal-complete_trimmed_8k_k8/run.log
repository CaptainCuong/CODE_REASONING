Sending keys: ["cat > final_fit.py << 'EOF'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\ndef gaussian(x, x0, gamma, amplitude, offset):\n    return amplitude * np.exp(-0.5 * ((x - x0) / gamma)**2) + offset\n\n# Load data\nwith open('graphene.dat', 'r') as f:\n    lines = f.readlines()\nx = []\ny_g = []\ny_2d = []\nfor line in lines:\n    parts = line.strip().split(',')\n    y = []\n    for p in parts:\n        sub = p.split()\n        y.extend(sub)\n    x.append(float(y[0]))\n    y_g.append(float(y[1]))\n    y_2d.append(float(y[2]))\n\nx = np.array(x)\ny_g = np.array(y_g)\ny_2d = np.array(y_2d)\n\n# Fit G column\ndef fit_g():\n    p0 = [3041, 100, 999930, 4135]\n    try:\n        popt, _ = curve_fit(gaussian, x, y_g, p0=p0, maxfev=5000)\n        return popt\n    except:\n        return p0\n\npopt_g = fit_g()\nprint('G fit:', popt_g)\n\n# Fit 2D column\ndef fit_2d():\n    p0 = [117, 100, 79400, 0]\n    try:\n        popt, _ = curve_fit(gaussian, x, y_2d, p0=p0, maxfev=5000)\n        return popt\n    except:\n        return p0\n\npopt_2d = fit_2d()\nprint('2D fit:', popt_2d)\n\nresults = {\n    'G': {\n        'x0': float(popt_g[0]),\n        'gamma': float(popt_g[1]),\n        'amplitude': float(popt_g[2]),\n        'offset': float(popt_g[3])\n    },\n    '2D': {\n        'x0': float(popt_2d[0]),\n        'gamma': float(popt_2d[1]),\n        'amplitude': float(popt_2d[2]),\n        'offset': float(popt_2d[3])\n    }\n}\n\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Results written to results.json')\nprint(json.dumps(results, indent=2))\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
