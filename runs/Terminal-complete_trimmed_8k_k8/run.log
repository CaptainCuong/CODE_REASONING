Sending keys: ['cat > bitcoin_service.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nimport sys\nfrom flask import Flask, request, abort\nfrom bitcoinlib import RPCClient\nfrom bitcoinlib.transactions import Transaction\nfrom bitcoinlib.blocks import Block\nfrom bitcoinlib.scripts import Script\n\napp = Flask(__name__)\n\n# RPC client configuration\nrpc_config = {\n    \'host\': \'localhost\',\n    \'port\': 8333,\n    \'user\': \'\',\n    \'password\': \'\',\n    \'timeout\': 30\n}\n\ndef get_rpc_client():\n    """Return a connected RPC client."""\n    try:\n        client = RPCClient(rpc_config[\'host\'], rpc_config[\'port\'],\n                           user=rpc_config[\'user\'], password=rpc_config[\'password\'],\n                           timeout=rpc_config[\'timeout\'])\n        return client\n    except Exception as e:\n        raise ConnectionError(f"Failed to connect to RPC server: {e}")\n\ndef get_block(block_hash):\n    """Return block details as JSON dict."""\n    client = get_rpc_client()\n    block = client.get_block(block_hash)\n    # block is a Block object\n    return {\n        \'hash\': block.hash.hex(),\n        \'height\': int(block.height),\n        \'merkleroot\': block.merkleroot.hex(),\n        \'time\': int(block.time),\n        \'nonce\': int(block.nonce),\n        \'tx\': [tx.hash.hex() for tx in block.transactions]\n    }\n\ndef get_transaction(txid):\n    """Return transaction details as JSON dict."""\n    client = get_rpc_client()\n    transaction = client.get_transaction(txid)\n    # transaction is a Transaction object\n    vin = []\n    for inp in transaction.vin:\n        vin.append({\n            \'coinbase\': inp.coinbase.hex() if inp.is_coinbase else \'\',\n            \'sequence\': int(inp.sequence)\n        })\n    vout = []\n    for out in transaction.vout:\n        script = out.scriptPubKey\n        vout.append({\n            \'value\': out.value,\n            \'n\': out.n,\n            \'scriptPubKey\': {\n                \'asm\': script.asm,\n                \'hex\': script.hex,\n                \'type\': script.type\n            }\n        })\n    return {\n        \'txid\': transaction.hash.hex(),\n        \'blockhash\': transaction.block_hash.hex(),\n        \'vin\': vin,\n        \'vout\': vout\n    }\n\ndef get_status():\n    """Return network status."""\n    try:\n        client = get_rpc_client()\n        # Get network info\n        network = client.get_network_info()\n        return {\n            \'status\': \'online\'\n        }\n    except Exception as e:\n        return {\n            \'status\': \'offline\',\n            \'error\': str(e)\n        }\n\n@app.route(\'/block/<block_hash>\', methods=[\'GET\'])\ndef block_endpoint(block_hash):\n    try:\n        block = get_block(block_hash)\n        return json.dumps(block)\n    except ValueError:\n        # Invalid block hash\n        return json.dumps({\'error\': f"Block {block_hash} not found"}), 404\n    except Exception as e:\n        return json.dumps({\'error\': str(e)}), 500\n\n@app.route(\'/transaction/<txid>\', methods=[\'GET\'])\ndef transaction_endpoint(txid):\n    try:\n        transaction = get_transaction(txid)\n        return json.dumps(transaction)\n    except ValueError:\n        return json.dumps({\'error\': f"Transaction {txid} not found"}), 404\n    except Exception as e:\n        return json.dumps({\'error\': str(e)}), 500\n\n@app.route(\'/status\', methods=[\'GET\'])\ndef status_endpoint():\n    status = get_status()\n    return json.dumps(status)\n\nif __name__ == \'__main__\':\n    app.run(host=\'0.0.0.0\', port=5000, debug=False)\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
