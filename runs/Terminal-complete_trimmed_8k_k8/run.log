Sending keys: ['cat > train_fasttext.py << \'EOF\'\nimport fasttext\nimport pandas as pd\nimport numpy as np\nimport os\n\n# Load the data\ntrain_df = pd.read_parquet(\'data/train-00000-of-00001.parquet\')\ntest_df = pd.read_parquet(\'data/test-00000-of-00001.parquet\')\n\n# Convert to label text separated by a space\ntrain_lines = []\nfor idx, row in train_df.iterrows():\n    line = f"{row[\'label\']} {row[\'text\']}"\n    train_lines.append(line)\n\nwith open(\'train.txt\', \'w\') as f:\n    f.write(\'\\n\'.join(train_lines))\n\n# Similarly for test\ntest_lines = []\nfor idx, row in test_df.iterrows():\n    line = f"{row[\'label\']} {row[\'text\']}"\n    test_lines.append(line)\n\nwith open(\'test.txt\', \'w\') as f:\n    f.write(\'\\n\'.join(test_lines))\n\n# Split train into train/validation (80/20)\ntrain_lines = train_lines[:int(len(train_lines)*0.8)]\nvalid_lines = train_lines[int(len(train_lines)*0.8):]\n\nprint(f\'Train lines: {len(train_lines)}\')\nprint(f\'Validation lines: {len(valid_lines)}\')\n\n# Train a supervised model with default parameters\nmodel = fasttext.train_supervised(\'train.txt\', epoch=20, dim=100)\nprint(\'Model trained.\')\n\n# Evaluate on validation and test\nval_accuracy = model.test(valid_lines, k=1)\ntest_accuracy = model.test(test_lines, k=1)\nprint(f\'Validation accuracy: {val_accuracy}\')\nprint(f\'Test accuracy: {test_accuracy}\')\n\n# Save model\nmodel.save_model(\'model.bin\')\nprint(\'Model saved to model.bin\')\n\n# Check model size\nsize = os.path.getsize(\'model.bin\')\nprint(f\'Model size: {size} bytes ({size/1024/1024:.2f} MB)\')\nif size > 150 * 1024 * 1024:\n    print(\'WARNING: Model size exceeds 150 MB!\')\nelse:\n    print(\'Model size OK (<150 MB).\')\n\n# If accuracy < 0.62, we might need to adjust dimension\nif test_accuracy < 0.62:\n    print(f\'Test accuracy below 0.62: {test_accuracy}. Considering dimension reduction.\')\n    # Try dimension 50\n    model2 = fasttext.train_supervised(\'train.txt\', epoch=20, 