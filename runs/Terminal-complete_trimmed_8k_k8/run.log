Sending keys: ["cat > /app/recover3.py << 'EOF'\nimport json\nimport re\n\nwith open('/app/trunc.db', 'rb') as f:\n    data = f.read()\n\n# Split by newline\nlines = data.split(b'\\n')\nrows = []\nseen = set()\n\nfor line_num, line in enumerate(lines, 1):\n    line = line.decode('ascii', errors='ignore')\n    if not line:\n        continue\n    print(f'Line {line_num}: {line}')\n    # Try to find rows by splitting by whitespace\n    parts = line.split()\n    if len(parts) >= 2:\n        word = parts[0]\n        value = ' '.join(parts[1:])\n        rows.append({'word': word, 'value': value})\n        key = (word, value)\n        if key not in seen:\n            seen.add(key)\n    # Try to find rows by pattern !testword...\\d+\n    # We'll use regex to find all matches and then capture the value after each match\n    pattern = re.compile(r'!testword\\d+\\s*(\\S+)')\n    matches = pattern.findall(line)\n    for match in matches:\n        word, value = match\n        rows.append({'word': word, 'value': value})\n        key = (word, value)\n        if key not in seen:\n            seen.add(key)\n\n# Also, try to find rows by pattern !testword...\\d+ and then capture the value until a space or end of line\n# We'll use regex to capture the whole row\nrow_pattern = re.compile(r'!testword\\d+\\s*(\\S+)')\nfor match in row_pattern.findall(data.decode('ascii', errors='ignore')):\n    word, value = match\n    rows.append({'word': word, 'value': value})\n    key = (word, value)\n    if key not in seen:\n        seen.add(key)\n\n# Now, we have rows. We'll deduplicate by converting to set of tuples\nunique_rows = []\nfor r in rows:\n    key = (r['word'], r['value'])\n    if key not in seen:\n        seen.add(key)\n        unique_rows.append(r)\n\n# Sort by word\nunique_rows.sort(key=lambda x: x['word'])\n\nprint('Unique rows:', len(unique_rows))\nfor r in unique_rows:\n    print(r)\n\nwith open('/app/recover.json', 'w') as out:\n    json.dump(unique_rows, out, indent=2)\nEOF\n"] m