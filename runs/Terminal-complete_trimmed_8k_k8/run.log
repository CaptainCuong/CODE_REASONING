Sending keys: ['cat > analyze.py << \'EOF\'\nimport numpy as np\nimport scipy.optimize as opt\nimport json\n\n# Load data\nwith open(\'graphene.dat\', \'r\') as f:\n    lines = f.readlines()\n\nx_vals = []\ny_vals = []\nfor line in lines:\n    line = line.strip()\n    if not line:\n        continue\n    parts = line.split()\n    # parts[0] and parts[1] are first pair\n    # parts[2] and parts[3] are second pair\n    x1 = float(parts[0])\n    y1 = float(parts[1])\n    x2 = float(parts[2])\n    y2 = float(parts[3])\n    x_vals.append(x1)\n    y_vals.append(y2)\n\nx = np.array(x_vals)\ny = np.array(y_vals)\n\n# Print some info\nprint(\'First 10 x:\', x[:10])\nprint(\'First 10 y:\', y[:10])\nprint(\'Last 10 x:\', x[-10:])\nprint(\'Last 10 y:\', y[-10:])\nprint(\'Range x:\', x.min(), x.max())\nprint(\'Range y:\', y.min(), y.max())\nprint(\'Max y index:\', np.argmax(y), \'value:\', y.max())\nprint(\'Min y index:\', np.argmin(y), \'value:\', y.min())\n\n# Find peaks in y\n# We\'ll look for local maxima in y\n# Simple peak detection: where y[i] > y[i-1] and y[i] > y[i+1]\npeaks = []\nfor i in range(1, len(y)-1):\n    if y[i] > y[i-1] and y[i] > y[i+1]:\n        peaks.append((x[i], y[i]))\nprint(\'Found\', len(peaks), \'peaks\')\nfor xi, yi in peaks[:5]:\n    print(f\'  x={xi}, y={yi}\')\n\n# Now we need to fit Lorentzian to each peak.\n# Lorentzian: f(x) = A * gamma^2 / ((x - x0)^2 + gamma^2) + offset\n# We\'ll fit using scipy.optimize.curve_fit\n# Define function\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma**2 / ((x - x0)**2 + gamma**2) + offset\n\n# We\'ll fit each peak individually.\n# For G peak at ~1580 cm-1, we need to find x values around that.\n# Since x is too large, we need to scale x to cm-1.\n# Let\'s compute a factor: maybe x in cm-1 = x_data / factor\nfactor = 28025 / 1580  # from line 55\nprint(\'Suggested factor for x to cm-1:\', factor)\n\n# Scale x\nx_scaled = x / factor\n\n# Now find peaks in scaled x\npeaks_scaled = []\nfor i in range(1, len(y)-1):\n    if y[i] > y[i-1] and y[i] > y[i+1]:\n        peaks_scaled.append((x_scaled[i], y[i]))\nprint(\'Peaks in scaled x:\', peaks_scaled[:5])\n\n# We\'ll fit each peak.\n# We\'ll use initial guess based on the data.\n# For each peak, we\'ll fit a Lorentzian with initial x0 = peak x, gamma=100, amplitude=1, offset=0.\n# We\'ll do this for G and 2D peaks.\n# Let\'s identify which peaks are G and 2D.\n# G peak should be around 1580 cm-1, 2D around 2700 cm-1.\n# Find indices where x_scaled is around those values.\nidx_G = np.argmin(np.abs(x_scaled - 1580))\nidx_2D = np.argmin(np.abs(x_scaled - 2700))\nprint(\'G peak index:\', idx_G, \'x_scaled:\', x_scaled[idx_G], \'y:\', y[idx_G])\nprint(\'2D peak index:\', idx_2D, \'x_scaled:\', x_scaled[idx_2D], \'y:\', y[idx_2D])\n\n# Now fit.\n# Prepare data for G\nx_G = x_scaled[idx_G - 5: idx_G + 5]\ny_G = y[idx_G - 5: idx_G + 5]\n# Prepare data for 2D\nx_2D = x_scaled[idx_2D - 5: idx_2D + 5]\ny_2D = y[idx_2D - 5: idx_2D + 5]\n\n# Fit G\npopt_G, pcov_G = opt.curve_fit(lorentzian, x_G, y_G, p0=[1580, 100, 1, 0])\nprint(\'G fit:\', popt_G)\n# Fit 2D\npopt_2D, pcov_2D = opt.curve_fit(lorentzian, x_2D, y_2D, p0=[2700, 100, 1, 0])\nprint(\'2D fit:\', popt_2D)\n\n# Prepare results dictionary\nresults = {\n    "G": {\n        "x0": float(popt_G[0]),\n        "gamma": float(popt_G[1]),\n        "amplitude": float(popt_G[2]),\n        "offset": float(popt_G[3])\n    },\n    "2D": {\n        "x0": float(popt_2D[0]),\n        "gamma": float(popt_2D[1]),\n        "amplitude": float(popt_2D[2]),\n        "offset": float(popt_2D[3])\n    }\n}\n\n# Write to file\nwith open(\'results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\nprint(\'Results written to results.json\')\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
