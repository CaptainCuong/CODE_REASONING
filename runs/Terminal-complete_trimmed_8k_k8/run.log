Sending keys: ["cat > compute_sim2.py << 'EOF'\nimport struct\nimport sys\n\ndef read_ppm_p3(filename):\n    with open(filename, 'r') as f:\n        lines = f.readlines()\n    header = lines[0].strip()\n    if header != 'P3':\n        raise ValueError('Not P3 format')\n    width_height = lines[1].strip()\n    width, height = map(int, width_height.split())\n    max_val = int(lines[2].strip())\n    if max_val != 255:\n        raise ValueError('Max value not 255')\n    data = b''.join(struct.pack('<BBB', r, g, b) for line in lines[3:] for r,g,b in [map(int, line.strip().split())])\n    return width, height, data\n\ndef read_ppm_p6(filename):\n    with open(filename, 'rb') as f:\n        header = f.read(3)\n        if header != b'P6':\n            raise ValueError('Not P6 format')\n        width_height = f.read(6)\n        width, height = struct.unpack('<ii', width_height)\n        max_val = struct.unpack('<i', f.read(4))[0]\n        if max_val != 255:\n            raise ValueError('Max value not 255')\n        size = width * height * 3\n        data = f.read(size)\n    return width, height, data\n\ndef scale_down(data, width, height, new_width, new_height):\n    # simple box averaging\n    old_rows = data\n    new_rows = []\n    for i in range(new_height):\n        row = []\n        for j in range(new_width):\n            x0 = j * width / new_width\n            x1 = (j+1) * width / new_width\n            y0 = i * height / new_height\n            y1 = (i+1) * height / new_height\n            red_sum = 0\n            green_sum = 0\n            blue_sum = 0\n            count = 0\n            for y in range(y0, y1):\n                for x in range(x0, x1):\n                    idx = (y * width + x) * 3\n                    r, g, b = old_rows[idx], old_rows[idx+1], old_rows[idx+2]\n                    red_sum += r\n                    green_sum += g\n                    blue_sum += b\n                    count += 1\n            row.append((red_sum // count, green_sum // count, blue_sum // count))\n        new_rows.append(row)\n    new_data = b''\n    for row in new_rows:\n        for r, g, b in row:\n            new_data += struct.pack('<BBB', r, g, b)\n    return new_width, new_height, new_data\n\ndef l2_similarity(data1, data2, width1, height1, width2, height2):\n    # assume same dimensions\n    total = 0\n    for i in range(height1):\n        for j in range(width1):\n            idx1 = (i * width1 + j) * 3\n            idx2 = (i * width2 + j) * 3\n            r1, g1, b1 = data1[idx1], data1[idx1+1], data1[idx1+2]\n            r2, g2, b2 = data2[idx2], data2[idx2+1], data2[idx2+2]\n            total += (r1 - r2)**2 + (g1 - g2)**2 + (b1 - b2)**2\n    return total / (width1 * height1 * 3)\n\nif __name__ == '__main__':\n    width1, height1, data1 = read_ppm_p3('high_res.ppm')\n    width2, height2, data2 = read_ppm_p6('image.ppm')\n    print(f'High res dimensions: {width1}x{height1}')\n    print(f'Image dimensions: {width2}x{height2}')\n    # scale high_res down to 800x600\n    width1_down, height1_down, data1_down = scale_down(data1, width1, height1, 800, 600)\n    # similarity\n    sim = l2_similarity(data1_down, data2, 800, 600, 800, 600)\n    print(f'Similarity (L2): {sim}')\n    # Also compute similarity without scaling\n    sim_raw = l2_similarity(data1, data2, width1, height1, width2, height2)\n    print(f'Similarity (raw): {sim_raw}')\n    # Print some stats\n    import numpy as np\n    data1_arr = np.frombuffer(data1, dtype=np.uint8).reshape((height1, width1, 3))\n    data2_arr = np.frombuffer(data2, dtype=np.uint8).reshape((height2, width2, 3))\n    print(f'High res unique colors: {data1_arr.reshape(-1,3).unique().shape[0]}')\n    print(f'Image unique colors: {data2_arr.reshape(-1,3).unique().shape[0]}')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
