Sending keys: ["cat > process.py << 'EOF'\nimport csv\nimport json\nfrom datetime import datetime\nfrom collections import defaultdict, Counter\n\n# Read departments\ndepartments = []\nwith open('data/departments.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        dept = {\n            'id': row['id'],\n            'name': row['name'],\n            'budget': float(row['budget'])\n        }\n        departments.append(dept)\n\n# Read employees\nemployees_by_dept = defaultdict(list)\nwith open('data/employees.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        emp = {\n            'id': row['id'],\n            'name': row['name'],\n            'position': row['position'],\n            'skills': row['skills'].split(';'),\n            'years_of_service': int(row['years_of_service']),\n            'department_id': row['department_id']\n        }\n        employees_by_dept[row['department_id']].append(emp)\n\n# Read projects\nprojects_by_dept = defaultdict(list)\nwith open('data/projects.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        proj = {\n            'name': row['name'],\n            'status': row['status'],\n            'members': row['member_ids'].split(';'),\n            'deadline': row['deadline'],\n            'department_id': row['department_id']\n        }\n        projects_by_dept[row['department_id']].append(proj)\n\n# Build organization\ntotal_employees = 0\nall_skills = []\nall_years = []\nall_status = []\ndept_sizes = {}\nfor dept in departments:\n    dept_id = dept['id']\n    dept['employees'] = employees_by_dept[dept_id]\n    dept['projects'] = projects_by_dept[dept_id]\n    dept_sizes[dept['id']] = len(dept['employees'])\n    total_employees += len(dept['employees'])\n    for emp in dept['employees']:\n        all_skills.extend(emp['skills'])\n        all_years.append(emp['years_of_service'])\n    all_status.extend([p['status'] for p in dept['projects']])\n\n# Compute statistics\naverage_department_budget = sum(d['budget'] for d in departments) / len(departments)\nskill_distribution = Counter(all_skills)\nskill_dist_dict = {skill: count for skill, count in skill_distribution.items()}\nproject_status_distribution = Counter(all_status)\nproject_status_dict = {status: count for status, count in project_status_distribution.items()}\naverage_years_of_service = sum(all_years) / len(all_years)\n\n# Build final JSON\nmetadata = {\n    'version': '1.0',\n    'timestamp': datetime.utcnow().isoformat() + 'Z',\n    'generator': 'CSVProcessor'\n}\n\norganization = {\n    'name': 'Car Manufacturer Inc.',\n    'founded': '2020-01-01',\n    'departments': departments\n}\n\nstatistics = {\n    'averageDepartmentBudget': average_department_budget,\n    'totalEmployees': total_employees,\n    'skillDistribution': skill_dist_dict,\n    'departmentSizes': dept_sizes,\n    'projectStatusDistribution': project_status_dict,\n    'averageYearsOfService': average_years_of_service\n}\n\nresult = {\n    'metadata': metadata,\n    'organization': organization,\n    'statistics': statistics\n}\n\nwith open('organization.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint('organization.json created')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
