Sending keys: ["cat > train_model4.py << 'EOF'\nimport pandas as pd\nimport fasttext\nimport os\nimport sys\nimport numpy as np\n\n# Load data\ntrain_df = pd.read_parquet('data/train-00000-of-00001.parquet')\ntest_df = pd.read_parquet('data/test-00000-of-00001.parquet')\nprint(f'Train shape: {train_df.shape}, Test shape: {test_df.shape}')\n\n# Preprocessing: tokenize, lowercase, remove punctuation\ndef preprocess(text):\n    if pd.isna(text):\n        return []\n    # Convert to string and strip\n    text = str(text).strip()\n    # If the string is empty, return empty list\n    if not text:\n        return []\n    # Tokenize by whitespace and punctuation\n    import re\n    tokens = re.findall(r'\\w+', text.lower())\n    # Remove stop words (simple list)\n    stop_words = {'the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'by', 'is', 'are', 'was', 'were', 'be', 'been', 'being',\n'have', 'has', 'had', 'do', 'does', 'did', 'will', 'would', 'should', 'could', 'may', 'might', 'can'}\n    tokens = [t for t in tokens if t not in stop_words]\n    return tokens\n\n# Apply preprocessing\ntrain_tokens = train_df['text'].apply(preprocess, na_action='ignore')\ntest_tokens = test_df['text'].apply(preprocess, na_action='ignore')\n\n# Build vocabulary: word count 10\nall_words = []\nfor tokens in train_tokens + test_tokens:\n    all_words.extend(tokens)\nword_counts = {}\nfor w in all_words:\n    word_counts[w] = word_counts.get(w, 0) + 1\nsorted_words = sorted(word_counts.items(), key=lambda x: x[1], reverse=True)\ntop10_words = [w for w, _ in sorted_words[:10]]\nprint(f'Top 10 words: {top10_words}')\nprint(f'Number of unique tokens: {len(all_words)}')\n\n# Filter tokens to top 10 words only\ndef filter_tokens(tokens):\n    return [t for t in tokens if t in top10_words]\n\ntrain_tokens = train_tokens.apply(filter_tokens)\ntest_tokens = test_tokens.apply(filter_tokens)\n\n# Build label mapping\nlabel_to_int = {}\nint_to_label = {}\nfor idx, label in enumerate(train_df['label'].unique()):\n    label_to_int[label] = idx\n    int_to_label[idx] = label\nprint(f'Number of labels: {len(label_to_int)}')\n\n# Convert to fasttext format: each line: <label_index> <word> <word> ...\ntrain_lines = []\nfor tokens, label in zip(train_tokens, train_df['label']):\n    line = str(label_to_int[label]) + ' ' + ' '.join(tokens)\n    train_lines.append(line)\n\ntest_lines = []\nfor tokens, label in zip(test_tokens, test_df['label']):\n    line = str(label_to_int[label]) + ' ' + ' '.join(tokens)\n    test_lines.append(line)\n\n# Train model\nmodel = fasttext.SentenceSkipGram()\nmodel.set_word_count(10)\nmodel.set_negative_sample(5)\nmodel.set_learning_rate(0.1)\nmodel.set_loss('crossEntropy')\n# Set epochs to 5 to reduce training time\nmodel.set_epoch(5)\nmodel.train(train_lines)\n\n# Evaluate on test set\ntest_accuracy = 0\nfor line in test_lines:\n    parts = line.split()\n    label = parts[0]\n    tokens = parts[1:]\n    pred = model.predict(tokens)\n    if pred[0] == int(label):\n        test_accuracy += 1\n\nprint(f'Test accuracy: {test_accuracy/len(test_lines):.2f}')\n\n# Save model\nmodel.save_model('model.bin')\nprint('Model saved to model.bin')\n\n# Check model size\nimport os\nsize = os.path.getsize('model.bin')\nprint(f'Model size: {size} bytes ({size/1024/1024:.2f} MB)')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
