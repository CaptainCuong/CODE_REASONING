 look for regions within squares where pixel intensity is above threshold (e.g., >100)\n# For each square, find the piece by finding the most frequent color (black vs white)\n# But we need to classify piece type. Let's instead use a simple approach: if there is a piece, find its center.\n# We'll assume pieces are circles or rectangles.\n# We'll just print the positions of pieces.\npiece_centers = []\nfor v, h in squares:\n    # Extract square\n    square = arr[h:h+10, v:v+10]\n    # Find where intensity > 100\n    mask = square > 100\n    if mask.any():\n        # Find the center (row, col) of the mask\n        row, col = np.where(mask)[0], np.where(mask)[1]\n        # Compute average intensity of the piece\n        avg = square[mask].mean()\n        piece_centers.append((v+col, h+row, avg))\n\nprint(f'Found {len(piece_centers)} pieces')\nfor center, avg in piece_centers:\n    print(f'  Piece at ({center[0]}, {center[1]}) avg intensity {avg}')\n\n# Now we need to map to chess coordinates\n# Let's assume the square grid is 8x8 and the pieces are on dark squares.\n# We'll convert to algebraic notation.\n# We'll create a mapping from square index to algebraic.\nsquare_indices = []\nfor v, h in squares:\n    idx = (h // 10) * 8 + (v // 10)\n    square_indices.append(idx)\n\n# We'll print the position in algebraic notation\n# We'll assume the first square is a1 (bottom left).\n# Actually, we need to know which square is a1. Let's assume the square at (v=0, h=0) is a1.\n# But our squares are offset. Let's compute the offset of the first square.\n# We'll just assume the first square is a1 and compute relative coordinates.\n# For simplicity, we'll just output the piece positions in terms of square index.\nprint('Piece positions (square index):')\nfor idx, center, avg in zip(square_indices, piece_centers, [avg]*len(piece_centers)):\n    # Compute rank (1-8) and file (a-h)\n    rank = (7 - idx // 8)  # because rank 1 is at top? Let's assume rank 1 is top.\n    file_num = idx 