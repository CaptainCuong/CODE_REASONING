Sending keys: ['cat > grid_transform.py << \'EOF\'\nimport numpy as np\n\ndef solve(input_grid):\n    """\n    Transform the input grid according to the pattern.\n    \n    Args:\n        input_grid (List[List[int]]): 2D list of integers representing the input grid\n            0: Black     1: Blue       2: Red        3: Green     4: Yellow\n            5: Grey      6: Hot Pink   7: Orange     8: Light Blue 9: Maroon\n            \n    Returns:\n        List[List[int]]: 2D list of integers representing the transformed grid\n    """\n    # Assume input_grid is 2x2\n    h = len(input_grid)\n    w = len(input_grid[0])\n    output = [[0]*w for _ in range(h)]\n    for i in range(h):\n        for j in range(w):\n            r = i // 2          # row index of the 2x2 block (0,1,2)\n            c = j // 2          # column index of the 2x2 block (0,1,2)\n            if r % 2 == 0:\n                # even row index: use input row (r//2) and columns 0 and 1 as is\n                output[i][j] = input_grid[r//2][c%2]\n            else:\n                # odd row index: use input row (r//2) but swap columns\n                output[i][j] = input_grid[r//2][1 - (c%2)]\n    return output\n\nif __name__ == \'__main__\':\n    # Quick test\n    example_input = [[8,6],[6,4]]\n    example_output = solve(example_input)\n    print(\'Example input:\', example_input)\n    print(\'Computed output:\')\n    for row in example_output:\n        print(row)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
