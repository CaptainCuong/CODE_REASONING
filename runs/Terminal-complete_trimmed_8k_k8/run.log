lement a mapping function.\n    // This is a placeholder; we need to write proper loading.\n}\n\nint main(int argc, char* argv[]) {\n    if (argc != 3) {\n        fprintf(stderr, "Usage: %s weights.json image.png\\n", argv[0]);\n        return 1;\n    }\n    const char* weights_file = argv[1];\n    const char* image_file = argv[2];\n    \n    // Load weights\n    double*** weights = malloc(3 * sizeof(double**));\n    double*** biases = malloc(3 * sizeof(double**));\n    load_weights(weights_file, weights, biases);\n    \n    // Load image\n    unsigned char* image_data = NULL;\n    unsigned int width, height;\n    lodepng_decode_file(image_file, &image_data, &width, &height, LODEPNG_FORMAT_G8);\n    if (width != 28 || height != 28) {\n        fprintf(stderr, "Image must be 28x28\\n");\n        return 1;\n    }\n    \n    // Normalize to 0.0-1.0\n    double* image_flat = malloc(INPUT_DIM * sizeof(double));\n    for (int i = 0; i < INPUT_DIM; i++) {\n        image_flat[i] = (double)image_data[i] / 255.0;\n    }\n    \n    // Inference\n    double* output = inference(image_flat);\n    // Find the maximum output\n    int predicted = 0;\n    for (int i = 1; i < NUM_CLASSES; i++) {\n        if (output[i] > output[predicted]) {\n            predicted = i;\n        }\n    }\n    \n    // Clean up\n    free(image_flat);\n    free(output);\n    free(image_data);\n    \n    // Print prediction\n    printf("%d\\n", predicted);\n    return 0;\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
