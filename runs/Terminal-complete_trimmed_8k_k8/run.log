Sending keys: ["cat > server.js << 'EOF'\nconst http = require('http');\nconst url = require('url');\n\nfunction fib(n) {\n    if (n <= 0) return 0;\n    if (n === 1) return 1;\n    return fib(n - 1) + fib(n - 2);\n}\n\nhttp.createServer((req, res) => {\n    const parsed = url.parse(req.url, true);\n    const query = parsed.query;\n    \n    if (req.method === 'GET' && parsed.path === '/fib') {\n        if (!query || !query.n) {\n            res.writeHead(400, {'Content-Type': 'application/json'});\n            res.end(JSON.stringify({ error: 'Missing query parameter n' }));\n            return;\n        }\n        const nStr = query.n;\n        if (!nStr.match(/^-?\\d+$/)) {\n            res.writeHead(400, {'Content-Type': 'application/json'});\n            res.end(JSON.stringify({ error: 'Query parameter n must be an integer' }));\n            return;\n        }\n        const n = Number(nStr);\n        if (n < 0) {\n            res.writeHead(400, {'Content-Type': 'application/json'});\n            res.end(JSON.stringify({ error: 'Query parameter n must be a non-negative integer' }));\n            return;\n        }\n        const result = fib(n);\n        res.writeHead(200, {'Content-Type': 'application/json'});\n        res.end(JSON.stringify({ result: result }));\n    } else {\n        res.writeHead(400, {'Content-Type': 'application/json'});\n        res.end(JSON.stringify({ error: 'Invalid request' }));\n    }\n}).listen(3000, '0.0.0.0', () => {\n    console.log('Server listening on port 3000');\n});\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
