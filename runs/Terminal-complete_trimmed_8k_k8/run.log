Sending keys: ["cat > split_final.py << 'EOF'\nimport os\nimport shutil\n\nc4_sample_dir = 'c4_sample'\nc4_reshard_dir = 'c4_reshard'\nmax_files = 30\nmax_size = 15 * 1024 * 1024\n\n# Ensure c4_reshard directory exists\nos.makedirs(c4_reshard_dir, exist_ok=True)\n\n# Get list of all files in c4_sample\nall_files = []\nfor root, dirs, files in os.walk(c4_sample_dir):\n    for f in files:\n        full_path = os.path.join(root, f)\n        all_files.append(full_path)\n\nprint(f'Total files: {len(all_files)}')\n\n# Create subdirectories and assign files in groups of max_files\ndirs = []\nfor idx in range(0, len(all_files), max_files):\n    sub_dir = os.path.join(c4_reshard_dir, f'subdir_{len(dirs)}')\n    os.makedirs(sub_dir, exist_ok=True)\n    dirs.append(sub_dir)\n    for fpath in all_files[idx:idx+max_files]:\n        size = os.path.getsize(fpath)\n        if size > max_size:\n            print(f'Warning: file {fpath} size {size} exceeds 15MB')\n        shutil.copy2(fpath, os.path.join(sub_dir, os.path.basename(fpath)))\n\nprint(f'Created {len(dirs)} subdirectories')\nprint(f'Total files in c4_reshard: {len(all_files)}')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
