Sending keys: ['cat > /app/check_cert.py << \'EOF\'\nimport ssl\nimport subprocess\nimport sys\nfrom datetime import datetime\n\ndef verify_certificate():\n    cert_path = \'/app/ssl/server.crt\'\n    key_path = \'/app/ssl/server.key\'\n    \n    # Check if files exist\n    try:\n        with open(cert_path, \'r\') as f:\n            cert_data = f.read()\n    except FileNotFoundError:\n        print(f\'ERROR: Certificate file not found: {cert_path}\')\n        sys.exit(1)\n    \n    try:\n        with open(key_path, \'r\') as f:\n            key_data = f.read()\n    except FileNotFoundError:\n        print(f\'ERROR: Private key file not found: {key_path}\')\n        sys.exit(1)\n    \n    # Load certificate into SSL context to verify it can be loaded\n    context = ssl.SSLContext(ssl.PROTOCOL_SSLv23)  # Use SSLv23 which supports TLSv1.2\n    context.load_cert_chain(cert_path, key_path)\n    \n    # Get the subject and dates using OpenSSL subprocess\n    # Subject\n    result = subprocess.run([\'openssl\', \'x509\', \'-in\', cert_path, \'-noout\', \'-subject\'],\n                           capture_output=True, text=True)\n    subject = result.stdout.strip()\n    # Dates\n    result = subprocess.run([\'openssl\', \'x509\', \'-in\', cert_path, \'-noout\', \'-dates\'],\n                           capture_output=True, text=True)\n    dates = result.stdout.strip()\n    \n    # Parse expiration date for validation\n    # OpenSSL date format: "notBefore=2024-01-01 00:00:00 GMT, notAfter=2025-01-01 00:00:00 GMT"\n    # Extract notAfter date\n    not_after_str = dates.split(\'notAfter=\')[1].split(\',\')[0].strip()\n    try:\n        expiration_date = datetime.strptime(not_after_str, \'%Y-%m-%d %H:%M:%S %z\')\n    except ValueError:\n        expiration_date = datetime.strptime(not_after_str, \'%Y-%m-%d %H:%M:%S\')\n    \n    # Current date\n    now = datetime.now()\n    \n    # Verify certificate is not expired\n    if expiration_date < now:\n        print(\'ERROR: Certificate is expired\')\n        sys.exit(1)\n    \n    # Print Common Name (extract from subject)\n    # Subject format: "Subject: CN=dev-internal.company.local, O=DevOps Team, C=US"\n    # We\'ll split by commas and take the first part after \'CN=\'\n    # But we can also use OpenSSL to get Common Name directly\n    result = subprocess.run([\'openssl\', \'x509\', \'-in\', cert_path, \'-noout\', \'-subject\'],\n                           capture_output=True, text=True)\n    subject_lines = result.stdout.split(\'\\n\')\n    common_name = None\n    for line in subject_lines:\n        if line.startswith(\' CN=\'):\n            common_name = line[4:].strip()\n            break\n    \n    # Extract expiration date string in YYYY-MM-DD format\n    expiration_str = expiration_date.strftime(\'%Y-%m-%d\')\n    \n    # Print details\n    print(f\'Subject: {subject}\')\n    print(f\'Dates: {dates}\')\n    print(f\'Common Name: {common_name}\')\n    print(f\'Expiration Date: {expiration_str}\')\n    print(\'Certificate verification successful\')\n\nif __name__ == \'__main__\':\n    verify_certificate()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
