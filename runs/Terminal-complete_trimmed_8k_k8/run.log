tem(root, "hidden_layer.weight");\n    for (int i = 0; i < hidden_size; i++) {\n        for (int j = 0; j < hidden_size; j++) {\n            int idx = i * hidden_size + j;\n            float val = cJSON_GetArrayItemAtIndex(weight, j * hidden_size + i);\n            weights[1][idx] = val;\n        }\n    }\n    // hidden layer bias\n    weight = cJSON_GetObjectItem(root, "hidden_layer.bias");\n    for (int i = 0; i < hidden_size; i++) {\n        biases[1][i] = cJSON_GetArrayItemAtIndex(weight, i);\n    }\n    // output layer weight\n    weight = cJSON_GetObjectItem(root, "output_layer.weight");\n    for (int i = 0; i < hidden_size; i++) {\n        for (int j = 0; j < output_size; j++) {\n            int idx = i * output_size + j;\n            float val = cJSON_GetArrayItemAtIndex(weight, j * hidden_size + i);\n            weights[2][idx] = val;\n        }\n    }\n    // output layer bias\n    weight = cJSON_GetObjectItem(root, "output_layer.bias");\n    for (int i = 0; i < output_size; i++) {\n        biases[2][i] = cJSON_GetArrayItemAtIndex(weight, i);\n    }\n    \n    cJSON_Delete(root);\n    return 0;\n}\n\n// Load image and extract pixel data (grayscale)\nint load_image(const char* image_file, uint8_t** image_data, int* width, int* height) {\n    FILE* f = fopen(image_file, "rb");\n    if (!f) {\n        return 1;\n    }\n    fseek(f, 0, SEEK_END);\n    long file_size = ftell(f);\n    fseek(f, 0, SEEK_SET);\n    char* buffer = malloc(file_size);\n    size_t read = fread(buffer, 1, file_size, f);\n    fclose(f);\n    if (read != file_size) {\n        return 1;\n    }\n    // lodepng decode\n    lodepng_decode_memory(buffer, (size_t*)width, (size_t*)height, image_data, 0);\n    free(buffer);\n    return 0;\n}\n\n// ReLU function\nfloat relu(float x) {\n    return x > 0 ? x : 0.0f;\n}\n\n// Linear layer: input_vec, weights, bias, output_vec, size\nvoid linear_layer(float* input_vec, float* weights, float* bias, int input_size, int output_size, float* output_vec) {\n    for (int i = 0; i < output_size; i++) {\n        float sum = 0.0f;\n        for (int j = 0; j < input_size; j++) {\n            sum += input_vec[j] * weights[i * input_size + j];\n        }\n        sum += bias[i];\n        output_vec[i] = sum;\n    }\n}\n\n// Main inference\nint infer(float* input_vec, float** weights, float** biases, int* layer_sizes) {\n    int input_size = layer_sizes[0];\n    int hidden_size = layer_sizes[1];\n    int output_size = layer_sizes[2];\n    \n    float* hidden_vec = malloc(hidden_size * sizeof(float));\n    float* output_vec = malloc(output_size * sizeof(float));\n    \n    linear_layer(input_vec, weights[0], biases[0], input_size, hidden_size, hidden_vec);\n    // ReLU\n    for (int i = 0; i < hidden_size; i++) {\n        hidden_vec[i] = relu(hidden_vec[i]);\n    }\n    linear_layer(hidden_vec, weights[1], biases[1], hidden_size, hidden_size, hidden_vec);\n    // ReLU\n    for (int i = 0; i < hidden_size; i++) {\n        hidden_vec[i] = relu(hidden_vec[i]);\n    }\n    linear_layer(hidden_vec, weights[2], biases[2], hidden_size, output_size, output_vec);\n    \n    float max_val = 0.0f;\n    int predicted = 0;\n    for (int i = 0; i < output_size; i++) {\n        if (output_vec[i] > max_val) {\n            max_val = output_vec[i];\n            predicted = i;\n        }\n    }\n    \n    free(hidden_vec);\n    free(output_vec);\n    return predicted;\n}\n\nint main(int argc, char* argv[]) {\n    if (argc != 3) {\n        printf("Usage: %s weights.json image.png\\n", argv[0]);\n        return 1;\n    }\n    \n    const char* weights_file = argv[1];\n    const char* image_file = argv[2];\n    \n    // Load weights\n    float** weights = malloc(3 * sizeof(float*));\n    float** biases = malloc(3 * sizeof(float*));\n    int* layer_sizes = malloc(3 * sizeof(int));\n    \n    if (load_weights(weights_file, weights, biases, layer_sizes)) {\n        printf("Failed to load weights\\n");\n        return 1;\n    }\n    \n    // Load image\n    uint8_t* image_data = NULL;\n    int width, height;\n    if (load_image(image_file, &image_data, &width, &height)) {\n        printf("Failed to load image\\n");\n        return 1;\n    }\n    \n    // Flatten image (grayscale)\n    float* input_vec = malloc(width * height * sizeof(float));\n    for (int i = 0; i < width; i++) {\n        for (int j = 0; j < height; j++) {\n            int idx = i * width + j;\n            input_vec[idx] = (float)image_data[idx] / 255.0f;\n        }\n    }\n    \n    // Inference\n    int predicted = infer(input_vec, weights, biases, layer_sizes);\n    \n    // Output predicted digit\n    printf("%d\\n", predicted);\n    \n    // Write prediction.txt\n    FILE* out = fopen("prediction.txt", "w");\n    if (out) {\n        fprintf(out, "%d", predicted);\n        fclose(out);\n    }\n    \n    // Cleanup\n    free(weights[0]);\n    free(weights[1]);\n    free(weights[2]);\n    free(biases[0]);\n    free(biases[1]);\n    free(biases[2]);\n    free(input_vec);\n    free(image_data);\n    return 0;\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
