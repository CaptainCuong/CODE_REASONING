t i = 0; i < width * height; i++) {\n        pixel_data[i] = (float)image_data[i] / 255.0f;\n    }\n    free(image_data);\n}\n\nvoid forward(float* input, float* output) {\n    // Flatten input\n    float* x = input;\n    // Input to hidden\n    for (int i = 0; i < HIDDEN_DIM; i++) {\n        float s = biases_hidden[i];\n        for (int j = 0; j < INPUT_DIM; j++) {\n            s += weights_input_hidden[i * INPUT_DIM + j] * x[j];\n        }\n        x[i] = s;\n    }\n    // Apply ReLU\n    for (int i = 0; i < HIDDEN_DIM; i++) {\n        if (x[i] < 0) x[i] = 0;\n    }\n    // Hidden to output\n    for (int i = 0; i < OUTPUT_DIM; i++) {\n        float s = biases_output[i];\n        for (int j = 0; j < HIDDEN_DIM; j++) {\n            s += weights_hidden_output[i * HIDDEN_DIM + j] * x[j];\n        }\n        output[i] = s;\n    }\n}\n\nint main() {\n    // Load weights\n    load_weights("weights.json");\n    // Load image\n    float pixel_data[INPUT_DIM];\n    load_image("image.png", pixel_data);\n    // Run inference\n    float output[OUTPUT_DIM];\n    forward(pixel_data, output);\n    // Find predicted digit\n    int pred = 0;\n    for (int i = 1; i < OUTPUT_DIM; i++) {\n        if (output[i] > output[pred]) pred = i;\n    }\n    printf("%d", pred);\n    return 0;\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
