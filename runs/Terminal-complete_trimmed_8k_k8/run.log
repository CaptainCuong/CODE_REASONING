Sending keys: ['cat > bitcoin_service.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nBitcoin Service API\nConnects to local Bitcoin Core RPC server and provides blockchain data.\n"""\nimport json\nimport requests\nfrom flask import Flask, request, abort\nfrom urllib.parse import urlparse\nimport sys\n\ndef connect_to_rpc():\n    """Connect to local Bitcoin Core RPC server."""\n    # Default localhost:8333\n    host = \'localhost\'\n    port = 8333\n    url = f\'http://{host}:{port}\'\n    try:\n        # Test connection\n        resp = requests.get(url + \'/ping\', timeout=5)\n        if resp.status_code == 200:\n            return url\n        else:\n            return None\n    except Exception as e:\n        return None\n\ndef get_block(block_hash, rpc_url):\n    """Query RPC for block details."""\n    url = rpc_url + \'/getblock\'\n    params = {\'hash\': block_hash, \'verbose\': 1}\n    try:\n        resp = requests.get(url, params=params, timeout=10)\n        data = resp.json()\n        # Build block response\n        block = {\n            \'hash\': data[\'hash\'],\n            \'height\': data[\'height\'],\n            \'merkleroot\': data[\'merkleroot\'],\n            \'time\': data[\'time\'],\n            \'nonce\': data[\'nonce\'],\n            \'tx\': data[\'tx\']\n        }\n        return block\n    except Exception as e:\n        raise\n\ndef get_transaction(txid, rpc_url):\n    """Query RPC for transaction details."""\n    url = rpc_url + \'/gettransaction\'\n    params = {\'txid\': txid}\n    try:\n        resp = requests.get(url, params=params, timeout=10)\n        data = resp.json()\n        # Build transaction response\n        # Map inputs\n        vin = []\n        for inp in data[\'vin\']:\n            vin.append({\n                \'coinbase\': inp.get(\'coinbase\', \'\'),\n                \'sequence\': inp[\'sequence\']\n            })\n        vout = []\n        for out in data[\'vout\']:\n            script = out[\'scriptPubKey\']\n            vout.append({\n                \'value\': out[\'value\'],\n                \'n\': out[\'n\'],\n                \'scriptPubKey\': {\n                    \'asm\': script[\'asm\'],\n                    \'hex\': script[\'hex\'],\n                    \'type\': script[\'type\']\n                }\n            })\n        tx = {\n            \'txid\': data[\'txid\'],\n            \'blockhash\': data[\'blockhash\'],\n            \'vin\': vin,\n            \'vout\': vout\n        }\n        return tx\n    except Exception as e:\n        raise\n\ndef get_status(rpc_url):\n    """Check if RPC server is connected."""\n    try:\n        resp = requests.get(rpc_url + \'/ping\', timeout=5)\n        if resp.status_code == 200:\n            return \'online\'\n        else:\n            return \'offline\'\n    except Exception:\n        return \'offline\'\n\ndef main():\n    """Main entry point."""\n    app = Flask(__name__)\n    rpc_url = connect_to_rpc()\n    if rpc_url is None:\n        print(\'ERROR: RPC server not available\')\n        sys.exit(1)\n    \n    @app.route(\'/status\')\n    def status():\n        status_msg = get_status(rpc_url)\n        return {\'status\': status_msg}\n    \n    @app.route(\'/block/<block_hash>\')\n    def block(block_hash):\n        block = get_block(block_hash, rpc_url)\n        return block\n    \n    @app.route(\'/transaction/<txid>\')\n    def transaction(txid):\n        tx = get_transaction(txid, rpc_url)\n        return tx\n    \n    # Error handling for missing endpoints\n    @app.errorhandler(404)\n    def handle_404(e):\n        return {\'error\': \'Resource not found\'}, 404\n    \n    @app.errorhandler(503)\n    def handle_503(e):\n        return {\'error\': \'Service unavailable\'}, 503\n    \n    # Start server on port 5000\n    app.run(host=\'0.0.0.0\', port=5000, debug=False)\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
