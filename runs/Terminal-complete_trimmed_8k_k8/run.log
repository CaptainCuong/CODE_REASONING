amma**2 ) + offset\n\nresults = {}\nfor i, idx in enumerate(peak_indices):\n    xi = x[idx]\n    yi = y[idx]\n    # Use a window around the peak to avoid fitting noise too much\n    start = max(0, idx - 100)\n    end = min(len(x), idx + 100)\n    xi_window = x[start:end]\n    yi_window = y[start:end]\n    popt = fit_peak(xi_window, yi_window, xi, yi)\n    if popt is None:\n        print('Could not fit peak at x=', xi)\n        continue\n    x0_arb, gamma_arb, amp_arb, offset_arb = popt\n    # Convert to cm-1\n    x0_cm = x0_arb * scaling_factor\n    gamma_cm = gamma_arb * scaling_factor\n    # Keep amplitude and offset as intensity units\n    results[f'Peak{i+1}'] = {\n        'x0': float(x0_cm),\n        'gamma': float(gamma_cm),\n        'amplitude': float(amp_arb),\n        'offset': float(offset_arb)\n    }\n\n# Rename keys to 'G' and '2D' (assuming peak1 is G, peak2 is 2D)\n# Actually G is at 1580, 2D at 2700. So peak1 (lower x) is G, peak2 is 2D.\nresults['G'] = results.pop('Peak1')\nresults['2D'] = results.pop('Peak2')\n\n# Write results\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('Results written to results.json')\nprint(json.dumps(results, indent=2))\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
