Sending keys: ["cat > evaluate.py << 'EOF'\nimport mteb\nimport json\nimport os\n\n# Get model details from Hugging Face\nimport requests\n\ncommit = '5c38ec7c405ec4b44b94cc5a9bb96e735b38267a'\nmodel_name = 'bge-small-en-v1.5'\nurl = f'https://huggingface.co/api/models/{model_name}/commit/{commit}'\nresp = requests.get(url)\ndata = resp.json()\norg = data['organization']\nmodel_name = data['name']\nprint(f'Organization: {org}')\nprint(f'Model name: {model_name}')\n\n# Create results directory structure\nresults_dir = f'results/{org}__{model_name}/{commit}/STS12'\nos.makedirs(results_dir, exist_ok=True)\n\n# Load dataset\ndataset = mteb.datasets.STS12()\n\n# Load model\nfrom transformers import AutoModel, AutoTokenizer\nmodel = AutoModel.from_pretrained(model_name)\ntokenizer = AutoTokenizer.from_pretrained(model_name)\n\n# Function to compute embedding\ndef embed(texts):\n    inputs = tokenizer(texts, padding=True, truncation=True, return_tensors='pt')\n    outputs = model(inputs['input_ids'], attention_mask=inputs['attention_mask'])\n    return outputs['pooler_output'].numpy()\n\n# Compute on dataset\ntimes = mteb.utils.Times()\nwith times:\n    dataset = dataset.load_data()\n    X = dataset['text1']\n    X2 = dataset['text2']\n    y = dataset['score']\n    X_enc = embed(X)\n    X2_enc = embed(X2)\n    scores = (X_enc * X2_enc).sum(axis=1)\n\nprint('Scores computed')\n\n# Prepare results\nresults = {\n    'task_name': 'STS12',\n    'dataset_name': 'sts12',\n    'model_name': model_name,\n    'commit': commit,\n    'organization': org,\n    'results': {\n        'scores': scores.tolist(),\n        'times': times.get_dict()\n    }\n}\n\n# Save\noutput_path = os.path.join(results_dir, 'results.json')\nwith open(output_path, 'w') as f:\n    json.dump(results, f, indent=2)\n\nprint('Results saved to', output_path)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
