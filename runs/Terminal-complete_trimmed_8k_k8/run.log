Sending keys: ["cat > create_spreadsheet_final2.py << 'EOF'\nimport requests\nimport json\n\nprint('Creating spreadsheet Financial Report...')\nresp = requests.post('http://api:8000/spreadsheets/', json={'title': 'Financial Report'})\nif resp.status_code == 200:\n    spreadsheet_id = resp.json()['id']\n    print(f'Spreadsheet created with ID: {spreadsheet_id}')\nelse:\n    print('Error creating spreadsheet:', resp.text)\n    exit(1)\n\nprint('Creating sheet Q1 Data...')\nresp = requests.post(f'http://api:8000/spreadsheets/{spreadsheet_id}/sheets/', json={'title': 'Q1 Data'})\nif resp.status_code == 200:\n    sheet_id = resp.json()['id']\n    print(f'Sheet created with ID: {sheet_id}')\nelse:\n    print('Error creating sheet:', resp.text)\n    exit(1)\n\nprint('Adding data to sheet...')\n# We'll create a batch update\nupdates = {}\n# Row 1: header\nupdates['A1'] = {'value': 'Month'}\nupdates['B1'] = {'value': 'Revenue'}\nupdates['C1'] = {'value': 'Expenses'}\nupdates['D1'] = {'value': 'Profit'}\n# Row 2: January\nupdates['A2'] = {'value': 'January'}\nupdates['B2'] = {'value': 10000}\nupdates['C2'] = {'value': 8000}\nupdates['D2'] = {'value': 2000}\n# Row 3: February\nupdates['A3'] = {'value': 'February'}\nupdates['B3'] = {'value': 12000}\nupdates['C3'] = {'value': 9000}\nupdates['D3'] = {'value': 3000}\n# Row 4: March\nupdates['A4'] = {'value': 'March'}\nupdates['B4'] = {'value': 15000}\nupdates['C4'] = {'value': 10000}\nupdates['D4'] = {'value': 5000}\n\n# Check the documentation to see the correct method\n# We'll try POST first, if fails, try PUT\nbatch_update = {'updates': updates}\nresp = requests.post(f'http://api:8000/sheets/{sheet_id}/cells/batch-update', json=batch_update)\nif resp.status_code == 200:\n    print('Data added successfully via POST.')\nelse:\n    print('POST failed:', resp.text)\n    # Try PUT\n    resp = requests.put(f'http://api:8000/sheets/{sheet_id}/cells/batch-update', json=batch_update)\n    if resp.status_code == 200:\n        print('Data added successfully via PUT.')\n    else:\n        print('PUT also failed:', resp.text)\n        # Fallback: update each cell individually\n        for cell, cell_data in updates.items():\n            resp = requests.post(f'http://api:8000/sheets/{sheet_id}/cells/{cell}/update', json=cell_data)\n            if resp.status_code != 200:\n                print(f'Failed to update {cell}: {resp.text}')\n                exit(1)\n        print('Data added successfully via individual updates.')\n\nprint('Done.')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
