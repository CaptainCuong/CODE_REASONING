Sending keys: ["cat > process.py << 'EOF'\nimport csv\nimport json\nfrom datetime import datetime\nimport os\n\n# Load CSV data\ndef load_csv(filepath):\n    with open(filepath, 'r') as f:\n        reader = csv.DictReader(f)\n        return list(reader)\n\ndepartments = load_csv('/app/data/departments.csv')\nemployees = load_csv('/app/data/employees.csv')\nprojects = load_csv('/app/data/projects.csv')\n\n# Convert data types\ndef to_int(val):\n    try:\n        return int(val)\n    except:\n        return val\n\ndef to_float(val):\n    try:\n        return float(val)\n    except:\n        return val\n\nfor d in departments:\n    d['budget'] = to_float(d['budget'])\n\nfor e in employees:\n    e['years_of_service'] = to_int(e['years_of_service'])\n    e['department_id'] = e['department_id']\n    e['skills'] = e['skills'].split(';')\n\nfor p in projects:\n    p['member_ids'] = p['member_ids'].split(';')\n    p['deadline'] = p['deadline']\n    p['department_id'] = p['department_id']\n\n# Build organization structure\norganization = {\n    'metadata': {\n        'version': '1.0',\n        'timestamp': datetime.now().isoformat(),\n        'generator': 'csv_to_json'\n    },\n    'organization': {\n        'name': 'Organization',  # placeholder\n        'founded': '2020-01-01',  # placeholder\n        'departments': []\n    },\n    'statistics': {}\n}\n\n# Map departments to objects with employees and projects\nfor dept in departments:\n    dept_id = dept['id']\n    dept_name = dept['name']\n    budget = dept['budget']\n    \n    # Get employees for this department\n    dept_employees = [e for e in employees if e['department_id'] == dept_id]\n    # Build employees list\n    employees_list = []\n    for emp in dept_employees:\n        employees_list.append({\n            'id': emp['id'],\n            'name': emp['name'],\n            'position': emp['position'],\n            'skills': emp['skills'],\n            'years_of_service': emp['years_of_service']\n        })\n    \n    # Get projects for this department\n    dept_projects = [p for p in projects if p['department_id'] == dept_id]\n    projects_list = []\n    for proj in dept_projects:\n        projects_list.append({\n            'name': proj['name'],\n            'status': proj['status'],\n            'members': proj['member_ids'],\n            'deadline': proj['deadline']\n        })\n    \n    organization['organization']['departments'].append({\n        'id': dept_id,\n        'name': dept_name,\n        'budget': budget,\n        'employees': employees_list,\n        'projects': projects_list\n    })\n\n# Compute statistics\ndept_budgets = [d['budget'] for d in organization['organization']['departments']]\navg_budget = sum(dept_budgets) / len(dept_budgets) if dept_budgets else 0\n\n# Total employees\ntotal_employees = len(employees)\n\n# Skill distribution: count of each skill across all employees\nskill_dist = {}\nfor emp in employees:\n    for skill in emp['skills']:\n        skill_dist[skill] = skill_dist.get(skill, 0) + 1\n\n# Department sizes: count of employees per department\ndept_sizes = {}\nfor dept in organization['organization']['departments']:\n    dept_sizes[dept['id']] = len(dept['employees'])\n\n# Project status distribution\nstatus_dist = {}\nfor proj in projects:\n    status = proj['status']\n    status_dist[status] = status_dist.get(status, 0) + 1\n\n# Average years of service\navg_years = sum(e['years_of_service'] for e in employees) / total_employees if total_employees else 0\n\norganization['statistics'] = {\n    'averageDepartmentBudget': avg_budget,\n    'totalEmployees': total_employees,\n    'skillDistribution': skill_dist,\n    'departmentSizes': dept_sizes,\n    'projectStatusDistribution': status_dist,\n    'averageYearsOfService': avg_years\n}\n\n# Write output\nwith open('/app/organization.json', 'w') as f:\n    json.dump(organization, f, indent=2)\n\nprint('organization.json generated')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
