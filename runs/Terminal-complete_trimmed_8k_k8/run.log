Sending keys: ['cat > bitcoin_service.py << \'EOF\'\n#!/usr/bin/env python3\nimport sys\nimport json\nfrom flask import Flask, request, abort\nfrom bitcoinlib.services import bitcoind\n\n# Configuration\nRPC_ENDPOINT = \'http://testnet.bitcoinrpc.org\'  # fallback if we can\'t connect\nNETWORK = \'testnet\'\n\ndef get_client():\n    """Get a connected bitcoind client."""\n    try:\n        client = bitcoind.BitcoindClient(base_url=RPC_ENDPOINT, network=NETWORK)\n        return client\n    except Exception as e:\n        raise ConnectionError(f\'Cannot connect to RPC endpoint: {e}\')\n\nclient = None\n\ndef connect():\n    global client\n    try:\n        client = get_client()\n    except Exception as e:\n        raise SystemExit(f\'Error: {e}\')\n\napp = Flask(__name__)\n\n@app.route(\'/status\')\ndef status():\n    if client is None:\n        return {\'status\': \'offline\'}, 503\n    return {\'status\': \'online\'}, 200\n\n@app.route(\'/block/<block_hash>\')\ndef block(block_hash):\n    try:\n        block = client.getblock(block_hash)\n        # Convert to required format\n        block_info = {\n            \'hash\': block[\'hash\'],\n            \'height\': block[\'height\'],\n            \'merkleroot\': block[\'merkleroot\'],\n            \'time\': block[\'time\'],\n            \'nonce\': block[\'nonce\'],\n            \'tx\': block[\'tx\']\n        }\n        return block_info, 200\n    except Exception as e:\n        return {\'error\': str(e)}, 404\n\n@app.route(\'/transaction/<txid>\')\ndef transaction(txid):\n    try:\n        tx = client.gettransaction(txid)\n        # Convert to required format\n        tx_inputs = []\n        for inp in tx[\'vin\']:\n            tx_inputs.append({\n                \'coinbase\': inp[\'coinbase\'] if \'vin\' in inp else \'\',\n                \'sequence\': inp[\'sequence\']\n            })\n        tx_outputs = []\n        for out in tx[\'vout\']:\n            tx_outputs.append({\n                \'value\': out[\'value\'],\n                \'n\': out[\'n\'],\n                \'scriptPubKey\': {\n                    \'asm\': out[\'scriptPubKey\'][\'asm\'],\n                    \'hex\': out[\'scriptPubKey\'][\'hex\'],\n                    \'type\': out[\'scriptPubKey\'][\'type\']\n                }\n            })\n        tx_info = {\n            \'txid\': tx[\'txid\'],\n            \'blockhash\': tx[\'blockhash\'],\n            \'vin\': tx_inputs,\n            \'vout\': tx_outputs\n        }\n        return tx_info, 200\n    except Exception as e:\n        return {\'error\': str(e)}, 404\n\nif __name__ == \'__main__\':\n    connect()\n    app.run(host=\'0.0.0.0\', port=5000)\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
