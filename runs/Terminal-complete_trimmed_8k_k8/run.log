Sending keys: ["cat > server.py << 'EOF'\nimport http.server\nimport urllib.parse\nimport json\nimport sys\n\nclass FibonacciHandler(http.server.BaseHTTPRequestHandler):\n    def do_GET(self):\n        # Parse the path and query string\n        path = self.path\n        if '?' in path:\n            path, query = path.split('?', 1)\n            query = '?' + query\n        else:\n            query = ''\n        \n        # Extract n from query string\n        params = urllib.parse.parse_qs(query, keep_blank_values=True)\n        n_str = params.get('n', [None])[0]\n        \n        if n_str is None:\n            self.send_error(400, 'Missing query parameter n')\n            return\n        \n        try:\n            n = int(n_str)\n        except ValueError:\n            self.send_error(400, 'Query parameter n must be an integer')\n            return\n        \n        # Compute Fibonacci number\n        # We'll compute iteratively for large n up to 10000\n        # Fibonacci sequence: F(0)=0, F(1)=1\n        if n == 0:\n            fib = 0\n        elif n == 1:\n            fib = 1\n        else:\n            a, b = 0, 1\n            for _ in range(2, n + 1):\n                a, b = b, a + b\n            fib = b\n        \n        # Prepare response\n        response = {'result': fib}\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.end_headers()\n        self.wfile.write(json.dumps(response).encode('utf-8'))\n\nif __name__ == '__main__':\n    server = http.server.HTTPServer(('0.0.0.0', 3000), FibonacciHandler)\n    print('Server started on port 3000')\n    server.serve_forever()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
