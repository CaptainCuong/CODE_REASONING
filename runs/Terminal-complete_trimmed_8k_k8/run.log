Sending keys: ["cat > extract_weights.py << 'EOF'\nimport torch\nimport numpy as np\nimport json\n\n# Load model\nmodel = torch.load('model.pth')\nprint('Model type:', type(model))\nprint('Model keys:', list(model.keys()))\n\n# If model is an OrderedDict, we need to extract weights differently\nif isinstance(model, torch.nn.Module):\n    weights = model.state_dict()\nelse:\n    # It's an OrderedDict\n    # We'll map layer names to parameters\n    # Let's assume the OrderedDict contains 'input_layer', 'hidden_layer', 'output_layer'\n    # with 'weight' and 'bias' subkeys.\n    weights = {}\n    for key, value in model.items():\n        if isinstance(value, torch.nn.Module):\n            # recursively extract\n            sub = value.named_parameters()\n            for subkey, subparam in sub.items():\n                weights[key + '.' + subkey] = subparam\n        else:\n            # assume it's a parameter dict\n            for subkey, subparam in value.items():\n                weights[key + '.' + subkey] = subparam\n\nprint('Extracted weights:', list(weights.keys()))\n\n# Convert to Python dict of lists\nconverted = {}\nfor key, tensor in weights.items():\n    converted[key] = tensor.tolist()\n\nwith open('weights.json', 'w') as f:\n    json.dump(converted, f, indent=2)\n\nprint('Weights saved to weights.json')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
