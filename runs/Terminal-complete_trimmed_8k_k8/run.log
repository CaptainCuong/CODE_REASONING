Sending keys: ["cat > create_reshard2.py << 'EOF'\nimport os\nimport json\nimport hashlib\n\nsample_dir = 'c4_sample'\nreshard_dir = 'c4_reshard'\n\n# Ensure reshard_dir exists\nos.makedirs(reshard_dir, exist_ok=True)\n\n# Dictionary to store mapping\nmapping = {}\n\n# For each original file\nfor root, dirs, files in os.walk(sample_dir):\n    for f in files:\n        original_path = os.path.join(root, f)\n        # Compute a key for sharding: split by line number modulo 30\n        with open(original_path, 'r') as fp:\n            lines = fp.readlines()\n        # Each line block is a file of up to 30 lines\n        for i in range(0, len(lines), 30):\n            block = lines[i:i+30]\n            # Create a filename: original basename + block index\n            basename = f'{f}_{i//30:02d}'\n            # Compute a unique identifier for this block\n            content = ''.join(block)\n            block_hash = hashlib.md5(content.encode()).hexdigest()\n            # Create subdirectory based on block_hash modulo 1000\n            subdir = block_hash[:3]  # use first three chars\n            subdirectory = os.path.join(reshard_dir, subdir)\n            os.makedirs(subdirectory, exist_ok=True)\n            resharded_path = os.path.join(subdirectory, basename)\n            # Write the block to the new file\n            with open(resharded_path, 'w') as fp:\n                fp.writelines(block)\n            # Record mapping\n            mapping.setdefault(original_path, []).append({\n                'resharded_path': resharded_path,\n                'subdirectory': subdir,\n                'basename': basename,\n                'block_hash': block_hash\n            })\n\n# Write mapping to a file\nwith open('reshard_mapping.json', 'w') as fp:\n    json.dump(mapping, fp, indent=2)\n\nprint(f'Created {reshard_dir} with mapping saved to reshard_mapping.json')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
