e_pattern" "$AUTH_LOG")\n        # Count matches in http.log\n        http_count=$(grep -c -E "$rule_pattern" "$HTTP_LOG")\n        total_matches=$((auth_count + http_count))\n        \n        # If total matches >= threshold, record\n        if [[ $total_matches -ge $rule_threshold ]]; then\n            # Collect unique IPs\n            auth_ips=$(grep -oEo "([0-9]{1,3}\\.){3}[0-9]{1,3}" "$AUTH_LOG" | grep -E "$rule_pattern" | sort -u)\n            http_ips=$(grep -oEo "([0-9]{1,3}\\.){3}[0-9]{1,3}" "$HTTP_LOG" | grep -E "$rule_pattern" | sort -u)\n            # Combine unique IPs\n            all_ips=$(echo "$auth_ips" "$http_ips" | sort -u)\n            # Build IPs string\n            ips_str=""\n            if [[ -n "$all_ips" ]]; then\n                ips_str=$(echo "$all_ips" | tr \'\\n\' \',\' | sed \'s/,$//\')\n            fi\n            # Add to alerts array\n            alerts+=("$rule_id $rule_severity $total_matches $ips_str")\n            # For statistics\n            stats+=("$rule_id $total_matches")\n        fi\n    done < /tmp/rules.txt\n\n    # Generate alert.json\n    generate_alert_json\n    # Generate report.json\n    generate_report_json\n}\n\n# Generate alert.json\ngenerate_alert_json() {\n    local timestamp=$(date -u +\'%Y-%m-%dT%H:%M:%SZ\')\n    echo \'{"timestamp":"\'$timestamp\'","alerts":[\' > "$ALERT_OUTPUT"\n    local first=1\n    for alert in "${alerts[@]}"; do\n        if [[ $first -eq 1 ]]; then\n            first=0\n        else\n            echo \',\' >> "$ALERT_OUTPUT"\n        fi\n        # Split alert into parts\n        local id=${alert%% *}\n        local severity=${alert#* }\n        local severity=${severity%% *}\n        local matches=${alert#* }\n        local matches=${matches%% *}\n        local ips=${alert#* }\n        ips=${ips%% *}\n        echo \'  {"id":"\'$id\'","severity":"\'$severity\'","matches":\'$matches\',"ips":"\'$ips\'"}\' >> "$ALERT_OUTPUT"\n    done\n    echo \'  ]}\' >> "$ALERT_OUTPUT"\n}\n\n# Generate report.json\ngenerate_report_json() {\n    local timestamp=$(date -u +\'%Y-%m-%dT%H:%M:%SZ\')\n    echo \'{"timestamp":"\'$timestamp\'","events":[\' > "$REPORT_OUTPUT"\n    local first=1\n    for alert in "${alerts[@]}"; do\n        if [[ $first -eq 1 ]]; then\n            first=0\n        else\n            echo \',\' >> "$REPORT_OUTPUT"\n        fi\n        local id=${alert%% *}\n        local severity=${alert#* }\n        local severity=${severity%% *}\n        local matches=${alert#* }\n        local matches=${matches%% *}\n        local ips=${alert#* }\n        ips=${ips%% *}\n        echo \'  {"id":"\'$id\'","severity":"\'$severity\'","matches":\'$matches\',"ips":"\'$ips\'"}\' >> "$REPORT_OUTPUT"\n    done\n    echo \'  ],"statistics":{\' >> "$REPORT_OUTPUT"\n    local first_stat=1\n    for stat in "${stats[@]}"; do\n        if [[ $first_stat -eq 1 ]]; then\n            first_stat=0\n        else\n            echo \',\' >> "$REPORT_OUTPUT"\n        fi\n        local rule_id=${stat%% *}\n        local count=${stat#* }\n        count=${count%% *}\n        echo \'    "\'$rule_id\'":\'$count >> "$REPORT_OUTPUT"\n    done\n    echo \'  }}\' >> "$REPORT_OUTPUT"\n}\n\n# Execute detection\ndetect\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
