Sending keys: ["cat > load_graph.py << 'EOF'\nimport tensorflow as tf\nimport os\n\n# Check if there are .bin files in the current directory\nbin_files = [f for f in os.listdir('.') if f.endswith('.bin')]\nif bin_files:\n    print('Found', bin_files)\n    # Create a graph and load the graph from the .bin files\n    g = tf.Graph()\n    with g.as_default():\n        # Load the graph from the .bin files\n        # TensorFlow 1.x checkpoints are stored in separate .bin files\n        # We can use tf.load_graph_def to load the graph from the .bin files.\n        # But we need to know the graph structure. Let's try to load the graph from the .bin files by using tf.load_graph_def.\n        # We'll read the file as binary and parse the graph.\n        # However, the .bin files are binary and not a single graph definition.\n        # We'll use tf.load_checkpoint to load the checkpoint.\n        tf.load_checkpoint('gpt2-124M.ckpt', checkpoint_name='gpt2')\n    print('Loaded checkpoint')\n    # Print the nodes\n    for node in g.as_graph_def().node:\n        print(node.name, node.op, node.input[:5])\nelse:\n    print('No .bin files found')\n    # Try to load the graph from the .ckpt file as a single graph definition\n    with open('gpt2-124M.ckpt', 'rb') as f:\n        data = f.read()\n    graph_def = tf.GraphDef()\n    graph_def.ParseFromString(data)\n    print('Graph loaded')\n    for node in graph_def.node:\n        print(node.name, node.op)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
