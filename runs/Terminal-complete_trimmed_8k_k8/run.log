Sending keys: ['cat > create_spreadsheet_api.py << \'EOF\'\nimport requests\nimport json\n\n# API endpoints\nbase_url = \'http://api:8000\'\n\n# 1. Create a new spreadsheet with title "Financial Report"\nspreadsheet_title = \'Financial Report\'\nresponse = requests.post(f\'{base_url}/spreadsheets/\', json={\'title\': spreadsheet_title})\nif response.status_code == 200:\n    spreadsheet_id = response.json()[\'id\']\n    print(f\'Spreadsheet created with id: {spreadsheet_id}\')\nelse:\n    print(f\'Error creating spreadsheet: {response.text}\')\n    exit(1)\n\n# 2. Create a new sheet with title "Q1 Data" in the spreadsheet\nsheet_title = \'Q1 Data\'\nresponse = requests.post(f\'{base_url}/spreadsheets/{spreadsheet_id}/sheets/\', json={\'title\': sheet_title})\nif response.status_code == 200:\n    sheet_id = response.json()[\'id\']\n    print(f\'Sheet created with id: {sheet_id}\')\nelse:\n    print(f\'Error creating sheet: {response.text}\')\n    exit(1)\n\n# 3. Add data to the sheet\n# We\'ll create a dictionary of cells with A1 notation\ndata = [\n    [\'A1\', \'Month\'],\n    [\'A2\', \'January\'],\n    [\'A3\', \'February\'],\n    [\'A4\', \'March\'],\n    [\'B1\', \'Revenue\'],\n    [\'B2\', 10000],\n    [\'B3\', 12000],\n    [\'B4\', 15000],\n    [\'C1\', \'Expenses\'],\n    [\'C2\', 8000],\n    [\'C3\', 9000],\n    [\'C4\', 10000],\n    [\'D1\', \'Profit\'],\n    [\'D2\', 2000],\n    [\'D3\', 3000],\n    [\'D4\', 5000],\n]\n\nfor cell_id, value in data:\n    cell = {\'value\': value, \'format\': None}\n    response = requests.put(f\'{base_url}/sheets/{sheet_id}/cells/{cell_id}\', json=cell)\n    if response.status_code != 200:\n        print(f\'Error updating cell {cell_id}: {response.text}\')\n\nprint(\'Data added successfully.\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
