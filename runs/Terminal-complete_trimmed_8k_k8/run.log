Sending keys: ['cat > index.html << \'EOF\'\n<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>Lydia Moreno - Research Profile</title>\n    <link rel="stylesheet" href="style.css" type="text/css">\n</head>\n<body>\n    <header>\n        <h1>Lydia Moreno</h1>\n        <p>Associate Professor of Computational Neuroscience</p>\n        <nav>\n            <a href="index.html">Home</a>\n            <a href="about.html">About Me</a>\n            <a href="blog.html">Blog</a>\n            <a href="publications.html">Publications</a>\n        </nav>\n    </header>\n    <main>\n        <section id="home">\n            <p>Welcome to my research profile. I am an associate professor of Computational Neuroscience at Riverbend University. My work bridges machine learning, systems neuroscience, and bioinformatics to decode neural circuits and develop interpretable models.</p>\n        </section>\n    </main>\n    <footer>\n        <p>&copy; 2025 Lydia Moreno. All rights reserved.</p>\n    </footer>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > about.html << \'EOF\'\n<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>About Me</title>\n    <link rel="stylesheet" href="style.css" type="text/css">\n</head>\n<body>\n    <header>\n        <h1>About Me</h1>\n        <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University\'s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information.</p>\n    </header>\n    <main>\n        <section id="about-me">\n            <h2>Education</h2>\n            <ul>\n                <li><strong>Ph.D., Computational Biology</strong><br>Baywood Institute of Technology, 2014–2019</li>\n                <li><strong>M.Sc., Bioinformatics</strong><br>Riverbend University, 2012–2014</li>\n                <li><strong>B.Sc., Computer Science</strong><br>Crestfield College of Engineering, 2008–2012</li>\n            </ul>\n            <h2>Research Interests</h2>\n            <ul>\n                <li>Neural Encoding & Decoding</li>\n                <li>Machine Learning for Biomedical Imaging</li>\n                <li>Single-Cell Omics</li>\n                <li>Explainable AI in Neuroscience</li>\n            </ul>\n            <h2>Selected Projects</h2>\n            <ul>\n                <li><strong>DeepVision</strong>: High-Resolution Neural Activity Mapping</li>\n                <li><strong>NeuroGraph</strong>: Graph Neural Networks for Circuit Analysis</li>\n                <li><strong>CellMap</strong>: Multi-Modal Single-Cell Atlas</li>\n            </ul>\n            <h2>Teaching & Mentorship</h2>\n            <ul>\n                <li><strong>Undergraduate Course</strong>: "Introduction to Computational Neuroscience" (Spring 2025)</li>\n                <li><strong>Graduate Seminar</strong>: "Advanced Machine Learning Methods in Biology" (Fall 2024)</li>\n                <li><strong>Mentorship</strong>: Supervised 8 Ph.D. students and 12 Master’s theses</li>\n            </ul>\n            <h2>Skills & Tools</h2>\n            <ul>\n                <li>Languages: Python, R, C++</li>\n                <li>Frameworks: PyTorch, TensorFlow, scikit-learn, NetworkX</li>\n                <li>Data Tools: Nextflow, Snakemake, Docker, Kubernetes</li>\n                <li>Analysis: MATLAB, Jupyter, Seurat, Scanpy</li>\n                <li>Visualization: D3.js, Plotly, Matplotlib</li>\n            </ul>\n            <h2>Contact</h2>\n            <ul>\n                <li>Email: <a href="mailto:lydia.moreno@riverbend.edu">lydia.moreno@riverbend.edu</a></li>\n                <li>Office: Blakely Hall, Room 312, Riverbend University</li>\n                <li>Twitter: <a href="https://twitter.com/LydiaNeuroLab" target="_blank">@LydiaNeuroLab</a></li>\n                <li>GitHub: <a href="https://github.com/lydia-moreno" target="_blank">github.com/lydia‑moreno</a></li>\n            </ul>\n        </section>\n    </main>\n    <footer>\n        <p>&copy; 2025 Lydia Moreno. All rights reserved.</p>\n    </footer>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > blog.html << \'EOF\'\n<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>Blog</title>\n    <link rel="stylesheet" href="style.css" type="text/css">\n</head>\n<body>\n    <header>\n        <h1>Blog</h1>\n        <p>Latest updates from my research and teaching activities.</p>\n    </header>\n    <main>\n        <section id="blog-posts">\n            <h2>Latest Posts</h2>\n            <article>\n                <h3>March 2025: Building Interpretable Deep Learning Models for Neuroscience</h3>\n                <p>A deep dive into the challenges of interpretability in deep learning for neural decoding. This post explores recent advances and open problems.</p>\n            </article>\n            <article>\n                <h3>January 2025: Bridging Machine Learning and Single-Cell Genomics</h3>\n                <p> Discusses the integration of machine learning techniques with single-cell omics to uncover cellular heterogeneity and functional states. </p>\n            </article>\n            <article>\n                <h3>November 2024: Scaling Graph Neural Networks for Connectomics</h3>\n                <p> Reviews the application of graph neural networks in connectomics, focusing on large-scale brain networks and their modeling. </p>\n            </article>\n            <p><a href="index.html">Back to Home</a></p>\n        </section>\n    </main>\n    <footer>\n        <p>&copy; 2025 Lydia Moreno. All rights reserved.</p>\n    </footer>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > publications.html << \'EOF\'\n<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>Publications</title>\n    <link rel="stylesheet" href="style.css" type="text/css">\n</head>\n<body>\n    <header>\n        <h1>Publications</h1>\n        <p>My research has been published in leading journals and conferences in computational neuroscience and bioinformatics.</p>\n    </header>\n    <main>\n        <section id="publications-list">\n            <h2>Recent Publications</h2>\n            <ul>\n                <li>\n                    <p>Moreno, L., & Patel, A. (2024). "Temporal Convolutional Networks Decode Visual Stimuli from Two‐Photon Signals." <i>Journal of Computational Neuroscience</i>, 45(2), 123–137.</p>\n                </li>\n                <li>\n                    <p>Moreno, L., Zhang, W., & Singh, R. (2023). "Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets." <i>Neuroinformatics</i>, 21(4), 299–312.</p>\n                </li>\n                <li>\n                    <p>Moreno, L. et al. (2022). "Integrative Single‐Cell Atlas of Human Cerebral Organoids." <i>Cell Systems</i>, 9(1), 67–82.</p>\n                </li>\n                <li>\n                    <p>Chen, J., Moreno, L., & Russo, M. (2021). "Explainable AI Techniques in Neural Decoding." <i>Frontiers in Neuroscience</i>, 15, 756843.</p>\n                </li>\n            </ul>\n        </section>\n    </main>\n    <footer>\n        <p>&copy; 2025 Lydia Moreno. All rights reserved.</p>\n    </footer>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
