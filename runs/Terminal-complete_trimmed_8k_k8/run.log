Sending keys: ["cat > create_spreadsheet_fixed.py << 'EOF'\nimport requests\nimport json\n\n# Create spreadsheet\nresp = requests.post('http://api:8000/spreadsheets/', json={'title': 'Financial Report'})\nsheet_id = resp.json()['id']\nprint('Spreadsheet ID:', sheet_id)\n\n# Create sheet\nresp = requests.post(f'http://api:8000/spreadsheets/{sheet_id}/sheets/', json={'title': 'Q1 Data', 'data': {}})\nsheet_id = resp.json()['id']\nprint('Sheet ID:', sheet_id)\n\n# Data to add\ndata = {\n    'A1': 'Month',\n    'B1': 'Revenue',\n    'C1': 'Expenses',\n    'D1': 'Profit',\n    'A2': 'January',\n    'B2': 10000,\n    'C2': 8000,\n    'D2': 2000,\n    'A3': 'February',\n    'B3': 12000,\n    'C3': 9000,\n    'D3': 3000,\n    'A4': 'March',\n    'B4': 15000,\n    'C4': 10000,\n    'D4': 5000\n}\n\n# Build updates dict\nupdates = {}\nfor cell_id, value in data.items():\n    updates[cell_id] = {'value': value, 'format': None}\n\n# Update cells in batch\nresp = requests.post(f'http://api:8000/sheets/{sheet_id}/cells/batch', json={'updates': updates})\nprint('Data added')\n\n# Retrieve the sheet data\nresp = requests.get(f'http://api:8000/sheets/{sheet_id}')\nsheet_data = resp.json()\nprint('Sheet data:')\nprint(json.dumps(sheet_data, indent=2))\n\n# Verify profit column values\nprofit_sum = sum(v for k, v in sheet_data['data'].items() if k.startswith('D'))\nprint(f'Total profit: {profit_sum}')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
