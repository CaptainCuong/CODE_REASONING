Sending keys: ['cat > bitcoin_service.py << \'EOF\'\n#!/usr/bin/env python3\nimport sys\nimport json\nimport requests\nfrom bitcoinlib.client import RPCClient\nfrom bitcoinlib.transactions import Transaction\nfrom bitcoinlib.blockchain import Block\nfrom flask import Flask, abort, make_response\n\napp = Flask(__name__)\n\n# Configuration\nRPC_HOST = \'127.0.0.1\'\nRPC_PORT = 8333\nRPC_USER = \'\'\nRPC_PASS = \'\'\nAPI_HOST = \'0.0.0.0\'\nAPI_PORT = 5000\n\nclient = RPCClient(host=RPC_HOST, port=RPC_PORT, user=RPC_USER, password=RPC_PASS)\n\ndef get_block(block_hash):\n    """Return block details as dict."""\n    block = client.get_block(block_hash)\n    return {\n        \'hash\': block.hash,\n        \'height\': block.height,\n        \'merkleroot\': block.merkleroot,\n        \'time\': block.time,\n        \'nonce\': block.nonce,\n        \'tx\': [tx.hash for tx in block.transactions]\n    }\n\ndef get_transaction(txid):\n    """Return transaction details as dict."""\n    tx = Transaction.from_hex(txid, client=client)\n    return {\n        \'txid\': tx.hash,\n        \'blockhash\': tx.block_hash,\n        \'vin\': [\n            {\n                \'coinbase\': vin[\'prev_out\'][\'hash\'] if \'prev_out\' in vin else \'\',\n                \'sequence\': vin[\'sequence\']\n            }\n            for vin in tx.vin\n        ],\n        \'vout\': [\n            {\n                \'value\': out[\'value\'],\n                \'n\': out[\'n\'],\n                \'scriptPubKey\': {\n                    \'asm\': out[\'scriptPubKey\'][\'asm\'],\n                    \'hex\': out[\'scriptPubKey\'][\'hex\'],\n                    \'type\': out[\'scriptPubKey\'][\'type\']\n                }\n            }\n            for out in tx.vout\n        ]\n    }\n\ndef get_status():\n    """Return network status."""\n    try:\n        # Try to get network info\n        info = client.get_network_info()\n        return {\'status\': \'online\'}\n    except Exception as e:\n        return {\'error\': f\'Not connected to network: {e}\'}\n\n@app.route(\'/block/<block_hash>\', methods=[\'GET\'])\ndef block_endpoint(block_hash):\n    try:\n        data = get_block(block_hash)\n        return json.dumps(data)\n    except Exception as e:\n        return json.dumps({\'error\': f\'Invalid block hash: {e}\'})\n\n@app.route(\'/transaction/<txid>\', methods=[\'GET\'])\ndef transaction_endpoint(txid):\n    try:\n        data = get_transaction(txid)\n        return json.dumps(data)\n    except Exception as e:\n        return json.dumps({\'error\': f\'Invalid transaction ID: {e}\'})\n\n@app.route(\'/status\', methods=[\'GET\'])\ndef status_endpoint():\n    data = get_status()\n    return json.dumps(data)\n\nif __name__ == \'__main__\':\n    app.run(host=API_HOST, port=API_PORT, debug=False)\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
