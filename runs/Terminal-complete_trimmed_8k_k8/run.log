Sending keys: ['cat > cli_tool.c << \'EOF\'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include "cJSON.h"\n#include "lodepng.h"\n#include "weights.h"\n\n// Load image from PNG file\ndefault void load_image(const char* filename, uint8_t** out_image, size_t* out_width, size_t* out_height) {\n    unsigned int width, height;\n    unsigned char* image_data;\n    lodepng_decode_file(filename, &image_data, &width, &height, 0, 0);\n    *out_image = image_data;\n    *out_width = width;\n    *out_height = height;\n}\n\n// Convert image to flat array of floats\ndefault void image_to_array(const uint8_t* image_data, size_t width, size_t height, float* out_array) {\n    // Normalize to [0,1]\n    for (size_t i = 0; i < width * height; i++) {\n        out_array[i] = (float)image_data[i] / 255.0f;\n    }\n}\n\n// Neural network inference\ndefault int predict(float* input_array) {\n    // Flatten input array (width*height) -> input_dim\n    size_t input_dim = 784;\n    size_t hidden_dim = 16;\n    size_t num_classes = 10;\n    \n    // Hidden layer weights and biases\n    const float* input_weights = input_weights;\n    const float* input_bias = input_bias;\n    const float* hidden_weights = hidden_weights;\n    const float* hidden_bias = hidden_bias;\n    const float* output_weights = output_weights;\n    const float* output_bias = output_bias;\n    \n    // Hidden layer\n    float hidden[hidden_dim];\n    for (size_t i = 0; i < hidden_dim; i++) {\n        float sum = 0.0f;\n        for (size_t j = 0; j < input_dim; j++) {\n            sum += input_weights[i * input_dim + j] * input_array[j];\n        }\n        hidden[i] = sum + input_bias[i];\n        if (hidden[i] < 0.0f) {\n            hidden[i] = 0.0f;\n        }\n    }\n    \n    // Output layer\n    float output[num_classes];\n    for (size_t i = 0; i < num_classes; i++) {\n        float sum = 0.0f;\n        for (size_t j = 0; j < hidden_dim; j++) {\n            sum += output_weights[i * hidden_dim + j] * hidden[j];\n        }\n        output[i] = sum + output_bias[i];\n    }\n    \n    // Find max\n    int predicted = 0;\n    float max_val = output[0];\n    for (size_t i = 1; i < num_classes; i++) {\n        if (output[i] > max_val) {\n            max_val = output[i];\n            predicted = i;\n        }\n    }\n    return predicted;\n}\n\n// Main function\ndefault int main(int argc, char* argv[]) {\n    if (argc != 3) {\n        fprintf(stderr, "Usage: %s <weights.json> <image.png>\\n", argv[0]);\n        return 1;\n    }\n    \n    const char* weights_file = argv[1];\n    const char* image_file = argv[2];\n    \n    // Load weights from JSON\n    FILE* f = fopen(weights_file, "rb");\n    if (!f) {\n        fprintf(stderr, "Cannot open weights file: %s\\n", weights_file);\n        return 1;\n    }\n    fseek(f, 0, SEEK_END);\n    long file_size = ftell(f);\n    fseek(f, 0, SEEK_SET);\n    char* json_data = malloc(file_size);\n    if (!json_data) {\n        fclose(f);\n        fprintf(stderr, "Cannot allocate memory for JSON\\n");\n        return 1;\n    }\n    size_t read = fread(json_data, 1, file_size, f);\n    fclose(f);\n    if (read != (size_t)file_size) {\n        free(json_data);\n        fprintf(stderr, "Cannot read weights file\\n");\n        return 1;\n    }\n    \n    // Parse JSON\n    cJSON* json = cJSON_Parse(json_data);\n    if (!json) {\n        free(json_data);\n        fprintf(stderr, "Invalid JSON in weights file\\n");\n        return 1;\n    }\n    \n    // Extract weights and biases\n    const char* key;\n    for (cJSON* item = json->child; item; item = item->next) {\n        key = item->string;\n        if (!strcmp(key, "input_layer.weight")) {\n            cJSON* val = item->value;\n            if (cJSON_IsArray(val)) {\n                // Convert to array\n                // We\'ll assume the values are in the correct format\n                // For simplicity, we\'ll just copy the values into the global arrays\n                // but we 