Sending keys: ["cat > extract_cv2.py << 'EOF'\nimport cv2\nimport tesseract\nimport urllib.request\nimport os\nimport tempfile\n\n# Download video\nurl = 'https://www.youtube.com/watch?v=ZCbvyPbhRfA'\nvideo_path = 'video.mp4'\nwith urllib.request.urlopen(url) as response:\n    with open(video_path, 'wb') as f:\n        f.write(response.read())\nprint('Video saved')\n\n# Load video with cv2\nclip = cv2.VideoCapture(video_path)\nframes = []\nwhile clip.isOpened():\n    ret, frame = clip.read()\n    if not ret:\n        break\n    frames.append(frame)\nprint(f'Found {len(frames)} frames')\n\n# Process each frame\nlines = []\nfor i, frame in enumerate(frames):\n    # Convert to PIL Image for tesseract\n    # We'll use tesseract's image_to_string\n    text = tesseract.image_to_string(frame)\n    for line in text.split('\\n'):\n        line = line.strip()\n        if line and not line.startswith(' '):\n            lines.append(line)\nprint(f'Extracted {len(lines)} lines')\n\n# Write to file\nwith open('solution.txt', 'w') as f:\n    for line in lines:\n        f.write(line + '\\n')\nprint('Written to solution.txt')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
