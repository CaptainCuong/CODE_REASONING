Sending keys: ["cat > fit_peaks_final.py << 'EOF'\nimport numpy as np\nimport scipy.signal as signal\nimport scipy.optimize as opt\nimport json\n\n# Load and preprocess data\nwith open('graphene.dat', 'r') as f:\n    lines = f.readlines()\n\ndata = []\nfor line in lines:\n    line = line.strip('\\r\\n')\n    parts = line.split(',')\n    if len(parts) != 3:\n        continue\n    intensity = float(parts[2])\n    x = float(parts[0])\n    data.append([x, intensity])\n\ndata = np.array(data)\nx = data[:, 0]\ny = data[:, 1]\nprint('Data shape:', x.shape)\nprint('x min, max:', x.min(), x.max())\nprint('y min, max:', y.min(), y.max())\n\n# Find peaks with prominence to avoid noise\npeaks, props = signal.find_peaks(y, prominence=50)\nprint('Number of peaks:', len(peaks))\nprint('Peak indices:', peaks)\nprint('Peak heights:', props['heights'])\n\n# Compute scaling factor using known peak positions\n# We'll assume the two highest peaks are G and 2D, but need to assign correctly.\n# Sort peaks by prominence\nsorted_indices = np.argsort(props['heights'])[::-1]\npeak_indices = peaks[sorted_indices[:2]]\nprint('Top 2 peaks indices:', peak_indices)\nprint('Corresponding x values:', x[peak_indices])\nprint('Corresponding heights:', props['heights'][sorted_indices[:2]])\n\n# Assign G to lower x, 2D to higher x\nx_peak1 = x[peak_indices[0]]  # lower x\nx_peak2 = x[peak_indices[1]]  # higher x\nprint('Assuming G at x=', x_peak1, 'and 2D at x=', x_peak2)\n\n# Compute scaling factor\nexpected_diff_cm = 2700 - 1580\nscaling_factor = expected_diff_cm / (x_peak2 - x_peak1)\nprint('Scaling factor (cm per arbitrary unit):', scaling_factor)\n\n# Define Lorentzian function\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma / ( (x - x0)**2 + gamma**2 ) + offset\n\n# Fit each peak\ndef fit_peak(x, y, x0_guess, y0_guess, peak_idx):\n    # Use a window around the peak to avoid fitting noise too much\n    start = max(0, peak_idx - 50)\n    end = min(len(x), peak_idx + 50)\n    xi_window = x[start:end]\n    yi_window = y[start:end]\n    # Initial guess: amplitude = peak intensity, gamma = 10, offset = 0\n    p0 = (x0_guess, 10, y0_guess, 0)\n    try:\n        popt, pcov = opt.curve_fit(lorentzian, xi_window, yi_window, p0=p0, maxfev=5000)\n        return popt\n    except Exception as e:\n        print('Fit failed for peak at x=', x0_guess, e)\n        return None\n\nresults = {}\nfor idx, peak_idx in enumerate(peak_indices):\n    xi = x[peak_idx]\n    yi = y[peak_idx]\n    popt = fit_peak(x, y, xi, yi, peak_idx)\n    if popt is None:\n        print('Could not fit peak at x=', xi)\n        continue\n    x0_arb, gamma_arb, amp_arb, offset_arb = popt\n    # Convert to cm-1\n    x0_cm = x0_arb * scaling_factor\n    gamma_cm = gamma_arb * scaling_factor\n    results[f'Peak{idx+1}'] = {\n        'x0': float(x0_cm),\n        'gamma': float(gamma_cm),\n        'amplitude': float(amp_arb),\n        'offset': float(offset_arb)\n    }\n\n# Assign G to the lower x peak, 2D to the higher x peak\nresults['G'] = results['Peak1']\nresults['2D'] = results['Peak2']\n\n# Write results\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('Results written to results.json')\nprint(json.dumps(results, indent=2))\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
