Sending keys: ["cat > fit_peaks.py << 'EOF'\nimport numpy as np\nimport scipy.signal as signal\nfrom scipy.optimize import curve_fit\n\n# Load data\nx_vals = []\ny_vals = []\nwith open('/app/graphene.dat', 'r') as f:\n    for line in f:\n        parts = line.strip().split(',')\n        if len(parts) != 3:\n            continue\n        for part in parts:\n            subparts = part.split('\\t')\n            if len(subparts) != 2:\n                continue\n            x_vals.append(float(subparts[0]))\n            y_vals.append(float(subparts[1]))\nx = np.array(x_vals)\ny = np.array(y_vals)\nprint('Data shape:', x.shape, y.shape)\nprint('x min/max:', x.min(), x.max())\nprint('y min/max:', y.min(), y.max())\n\n# Find peaks\npeaks, _ = signal.find_peaks(y, height=0)\nprint('Number of peaks:', len(peaks))\nfor i, peak in enumerate(peaks):\n    print(f'Peak {i}: x={x[peak]}, y={y[peak]}')\n\n# We'll fit each peak with a Gaussian function\ndef gaussian(x, x0, gamma, amplitude, offset):\n    return amplitude * np.exp(-0.5 * ((x - x0) / gamma) ** 2) + offset\n\n# For each peak, fit a Gaussian\nresults = {}\nfor i, peak in enumerate(peaks):\n    # Get a window around the peak\n    window = int(0.5 * 1000)  # 500 points\n    left = max(0, peak - window)\n    right = min(len(x), peak + window)\n    x_window = x[left:right]\n    y_window = y[left:right]\n    # Initial guess: x0 = peak, gamma = 10, amplitude = y_window.max() - y_window.min(), offset = y_window.min()\n    guess = [x[peak], 10.0, y_window.max() - y_window.min(), y_window.min()]\n    try:\n        popt, pcov = curve_fit(gaussian, x_window, y_window, p0=guess, maxfev=5000)\n        results[f'peak_{i}'] = popt\n        print(f'Peak {i} fitted: x0={popt[0]}, gamma={popt[1]}, amplitude={popt[2]}, offset={popt[3]}')\n    except Exception as e:\n        print(f'Peak {i} fit failed: {e}')\n        results[f'peak_{i}'] = None\n\n# Now we have two peaks. We need to assign G and 2D.\n# Let's compute the positions and see which one is closer to typical values.\n# We'll assume the x values are in some arbitrary unit, but we can still label based on amplitude.\n# The G peak is usually narrower and larger? Let's compare.\nif len(results) == 2:\n    peak0 = results['peak_0']\n    peak1 = results['peak_1']\n    # Determine which peak is G (Gaussian) and which is 2D\n    # We'll use the width: larger gamma is wider.\n    gamma0 = peak0[1]\n    gamma1 = peak1[1]\n    if gamma0 > gamma1:\n        # Peak 0 is wider -> 2D, Peak 1 is narrower -> G\n        results['G'] = peak1\n        results['2D'] = peak0\n    else:\n        results['G'] = peak0\n        results['2D'] = peak1\n    print('Assigning G and 2D based on gamma.')\n    print('G:', results['G'])\n    print('2D:', results['2D'])\n    # Output JSON\n    import json\n    with open('/app/results.json', 'w') as f:\n        json.dump(results, f, indent=2)\n    print('Results written to /app/results.json')\nelse:\n    print('Could not fit two peaks.')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
