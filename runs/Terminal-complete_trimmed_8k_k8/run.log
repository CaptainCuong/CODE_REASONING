op(heap)\n        if (x, y) in visited:\n            continue\n        visited.add((x, y))\n        \n        # Try to move in all directions\n        directions = [('N', -1, 0), ('E', 0, 1), ('S', 1, 0), ('W', 0, -1)]\n        for dir_name, dx, dy in directions:\n            nx, ny = x + dx, y + dy\n            # Send a command to move in that direction\n            cmd = f'move {dir_name}\\n'\n            # We'll send the command and capture the response\n            response = send_command(cmd, process)\n            if response == 'hit wall':\n                # wall in that direction\n                walls.add((nx, ny))\n            elif response == 'moved':\n                # successfully moved\n                visited.add((nx, ny))\n                heap.heappush((nx, ny))\n            elif response == 'reached exit':\n                # found exit\n                exit_pos = (nx, ny)\n                visited.add((nx, ny))\n                heap.heappush((nx, ny))\n            else:\n                print(f'Unexpected response: {response}')\n                sys.exit(1)\n    \n    # After BFS, we have visited all cells.\n    # We need to determine the dimensions of the grid.\n    # We'll find min and max x and y.\n    if visited:\n        min_x = min(x for (x, y) in visited)\n        max_x = max(x for (x, y) in visited)\n        min_y = min(y for (x, y) in visited)\n        max_y = max(y for (x, y) in visited)\n    else:\n        min_x = max_x = min_y = max_y = 0\n    \n    # Create a grid of characters\n    grid = [[' ' for _ in range(max_x - min_x + 1)] for __ in range(max_y - min_y + 1)]\n    # Map absolute coordinates to grid indices\n    offset_x = -min_x\n    offset_y = -min_y\n    \n    # Mark start and exit\n    start_grid = (start_pos[0] - min_x, start_pos[1] - min_y)\n    grid[start_grid[0]][start_grid[1]] = 'S'\n    if exit_pos:\n        exit_grid = (exit_pos[0] - min_x, exit_pos[1] - min_y)\n        grid[exit_grid[0]][exit_grid[1]] = 'E'\n    \n    # Mark walls\n    for (wx, wy) in walls:\n        gwx = wx - min_x\n        gwy = wy - min_y\n        grid[gwx][gwy] = '#'\n    \n    # Write to file\n    with open('/app/maze_map.txt', 'w') as f:\n        for row in grid:\n            f.write(''.join(row) + '\\n')\n    \n    # Also print to stdout for verification\n    for row in grid:\n        print(''.join(row))\n    \n    # Exit the game\n    process.stdin.write('exit\\n')\n    process.stdin.flush()\n    process.stdout.readline()\n    process.terminate()\n    return True\n\nif __name__ == '__main__':\n    explore()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
