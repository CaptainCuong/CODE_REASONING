Sending keys: ["cat > generate_json.py << 'EOF'\nimport csv\nimport json\nfrom datetime import datetime\nfrom collections import defaultdict\n\n# Load schema (optional, but we can use it for validation)\nwith open('schema.json', 'r') as f:\n    schema = json.load(f)\n\n# Read departments\ndepts = {}\nwith open('data/departments.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        dept_id = row['id']\n        dept = {\n            'id': dept_id,\n            'name': row['name'],\n            'budget': float(row['budget']),\n            'employees': [],\n            'projects': []\n        }\n        depts[dept_id] = dept\n\n# Read employees\nemployees = []\nwith open('data/employees.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        # strip whitespace from keys\n        row = {k.strip(): v for k, v in row.items()}\n        emp = {\n            'id': row['id'],\n            'name': row['name'],\n            'position': row['position'],\n            'skills': row['skills'].split(';'),\n            'years_of_service': int(row['years_of_service'])\n        }\n        employees.append(emp)\n        dept_id = row['department_id']\n        depts[dept_id]['employees'].append(emp)\n\n# Read projects\nwith open('data/projects.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        row = {k.strip(): v for k, v in row.items()}\n        project = {\n            'name': row['name'],\n            'status': row['status'],\n            'members': row['member_ids'].split(';'),\n            'deadline': row['deadline']\n        }\n        dept_id = row['department_id']\n        depts[dept_id]['projects'].append(project)\n\n# Build organization object\norganization = {\n    'name': 'Organization',  # placeholder, could be derived from data\n    'founded': '2020-01-01',  # placeholder\n    'departments': list(depts.values())\n}\n\n# Compute statistics\ntotal_budget = sum(d['budget'] for d in depts.values())\naverage_department_budget = total_budget / len(depts)\n\ntotal_employees = len(employees)\n\n# skill distribution\nskill_counts = defaultdict(int)\nfor emp in employees:\n    for skill in emp['skills']:\n        skill_counts[skill] += 1\n\n# department sizes\ndept_sizes = defaultdict(int)\nfor emp in employees:\n    dept_sizes[emp['department_id']] += 1\n\n# project status distribution\nstatus_counts = defaultdict(int)\nfor proj in [p for d in depts.values() for p in d['projects']]:\n    status_counts[proj['status']] += 1\n\n# average years of service\naverage_years = sum(e['years_of_service'] for e in employees) / total_employees\n\n# Build statistics object\nstatistics = {\n    'averageDepartmentBudget': average_department_budget,\n    'totalEmployees': total_employees,\n    'skillDistribution': dict(skill_counts),\n    'departmentSizes': dict(dept_sizes),\n    'projectStatusDistribution': dict(status_counts),\n    'averageYearsOfService': average_years\n}\n\n# Build final JSON\noutput = {\n    'metadata': {\n        'version': '1.0',\n        'timestamp': datetime.utcnow().isoformat() + 'Z',\n        'generator': 'CSV to JSON Processor'\n    },\n    'organization': organization,\n    'statistics': statistics\n}\n\n# Write to file\nwith open('organization.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint('organization.json created')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
