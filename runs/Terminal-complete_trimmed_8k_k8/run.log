Sending keys: ["cat > create_constrained.py << 'EOF'\n#!/usr/bin/env python3\nimport os\nimport shutil\nimport math\n\nc4_sample_dir = 'c4_sample'\nc4_reshard_dir = 'c4_reshard'\nmax_files_per_dir = 30\nmax_filesize = 15 * 1024 * 1024  # 15MB in bytes\n\n# Ensure c4_reshard directory exists\nos.makedirs(c4_reshard_dir, exist_ok=True)\n\n# Get list of files in c4_sample\nfiles = []\nfor root, dirs, filenames in os.walk(c4_sample_dir):\n    for f in filenames:\n        files.append(os.path.join(root, f))\n\nprint(f'Total files: {len(files)}')\n\n# Calculate number of subdirectories needed\nnum_subdirs = math.ceil(len(files) / max_files_per_dir)\nprint(f'Number of subdirectories: {num_subdirs}')\n\n# Create subdirectories\nfor i in range(num_subdirs):\n    subdir = os.path.join(c4_reshard_dir, f'mini_{i:06d}')\n    os.makedirs(subdir, exist_ok=True)\n\n# Copy files with splitting\nfor f in files:\n    # Get filename\n    filename = os.path.basename(f)\n    # Determine subdirectory index\n    idx = (os.path.getsize(f) // max_filesize)  # use size to avoid load imbalance\n    if idx >= num_subdirs:\n        idx = num_subdirs - 1\n    subdir = os.path.join(c4_reshard_dir, f'mini_{idx:06d}')\n    # Copy file\n    shutil.copy2(f, os.path.join(subdir, filename))\n    # Truncate if size > max_filesize\n    dest_path = os.path.join(subdir, filename)\n    if os.path.getsize(dest_path) > max_filesize:\n        # Truncate to max_filesize\n        with open(dest_path, 'r+b') as src, open(dest_path, 'wb') as dst:\n            dst.write(src.read(max_filesize))\n        print(f'Truncated file {filename} to {max_filesize} bytes')\n\nprint('c4_reshard created successfully')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
