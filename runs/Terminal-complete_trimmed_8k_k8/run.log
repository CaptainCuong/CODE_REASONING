Sending keys: ["cat > inference.py << 'EOF'\nimport json\nimport lodepng\nimport sys\nimport math\n\n# Load weights\nwith open('weights.json', 'r') as f:\n    weights = json.load(f)\n\n# Define network parameters\ninput_dim = 28 * 28\nhidden_dim = 128\nnum_classes = 10\n\n# Extract weights and biases\ninput_weight = weights['input_layer.weight']\ninput_bias = weights['input_layer.bias']\nhidden_weight = weights['hidden_layer.weight']\nhidden_bias = weights['hidden_layer.bias']\noutput_weight = weights['output_layer.weight']\noutput_bias = weights['output_layer.bias']\n\n# Flatten image to 784\nimage = [0.0] * input_dim\n\n# Load image\nif len(sys.argv) > 1:\n    png_path = sys.argv[1]\nelse:\n    png_path = 'test.png'\ntry:\n    with open(png_path, 'rb') as f:\n        data = f.read()\nexcept FileNotFoundError:\n    print('Image file not found:', png_path)\n    sys.exit(1)\n\ndecoded, info = lodepng.decode(data)\n# decoded is a list of rows, each row list of cols\n# Convert to list of pixels\nfor i in range(info[0]):\n    for j in range(info[1]):\n        image[i * info[1] + j] = decoded[i][j] / 255.0\n\n# Function to apply linear layer\ndef linear(x, w, b):\n    n = len(x)\n    m = len(w)\n    res = [0.0] * m\n    for i in range(m):\n        s = 0.0\n        for k in range(n):\n            s += x[k] * w[k][i]\n        res[i] = s + b[i]\n    return res\n\n# Apply input layer\nx = linear(image, input_weight, input_bias)\n# ReLU\nfor i in range(len(x)):\n    if x[i] < 0:\n        x[i] = 0.0\n\n# Apply hidden layer\nx = linear(x, hidden_weight, hidden_bias)\nfor i in range(len(x)):\n    if x[i] < 0:\n        x[i] = 0.0\n\n# Apply output layer\ny = linear(x, output_weight, output_bias)\n# Softmax\nmax_y = max(y)\ny = [yi - max_y for yi in y]\nexp_y = [math.exp(yi) for yi in y]\nprob = [yi / sum(exp_y) for yi in exp_y]\n\n# Find predicted digit\npred = max(range(num_classes), key=lambda i: prob[i])\nprint(pred)\n# Write prediction.txt\nwith open('prediction.txt', 'w') as f:\n    f.write(str(pred))\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
