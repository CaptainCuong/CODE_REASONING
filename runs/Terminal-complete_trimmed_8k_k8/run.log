Sending keys: ['cat > index.html << \'EOF\'\n<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>Lydia Moreno - Research Profile</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n        }\n        header {\n            background-color: #2c3e50;\n            color: white;\n            padding: 20px 0;\n            text-align: center;\n        }\n        header h1 {\n            margin: 0;\n        }\n        .section {\n            padding: 40px 20px;\n            max-width: 1200px;\n            margin: auto;\n        }\n        a {\n            color: #2c3e50;\n            text-decoration: none;\n        }\n        a:hover {\n            text-decoration: underline;\n        }\n        footer {\n            background-color: #2c3e50;\n            color: white;\n            padding: 20px 0;\n            text-align: center;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <h1>Lydia Moreno</h1>\n        <p>Associate Professor of Computational Neuroscience</p>\n    </header>\n    <nav>\n        <ul style="text-align: center; padding: 0; margin: 0; list-style: none;">\n            <li><a href="index.html">Home</a></li>\n            <li><a href="about.html">About Me</a></li>\n            <li><a href="blog.html">Blog</a></li>\n            <li><a href="publications.html">Publications</a></li>\n        </ul>\n    </nav>\n    <div class="section" id="about">\n        <h2>About Me</h2>\n        <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University’s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n    </div>\n    <div class="section" id="blog">\n        <h2>Blog</h2>\n        <p>Check out my latest posts:</p>\n        <ul>\n            <li><a href="#">March 2025: Building Interpretable Deep Learning Models for Neuroscience</a></li>\n            <li><a href="#">January 2025: Bridging Machine Learning and Single-Cell Genomics</a></li>\n            <li><a href="#">November 2024: Scaling Graph Neural Networks for Connectomics</a></li>\n        </ul>\n    </div>\n    <div class="section" id="publications">\n        <h2>Publications</h2>\n        <p>Selected publications include:</p>\n        <ol>\n            <li>Moreno, L., & Patel, A. (2024). "Temporal Convolutional Networks Decode Visual Stimuli from Two-Photon Signals." <em>Journal of Computational Neuroscience</em>, 45(2), 123–137.</li>\n            <li>Moreno, L., Zhang, W., & Singh, R. (2023). "Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets." <em>Neuroinformatics</em>, 21(4), 299–312.</li>\n            <li>Moreno, L. et al. (2022). "Integrative Single-Cell Atlas of Human Cerebral Organoids." <em>Cell Systems</em>, 9(1), 67–82.</li>\n            <li>Chen, J., Moreno, L., & Russo, M. (2021). "Explainable AI Techniques in Neural Decoding." <em>Frontiers in Neuroscience</em>, 15, 756843.</li>\n        </ol>\n    </div>\n    <footer>\n        <p>Contact: <a href="mailto:lydia.moreno@riverbend.edu">lydia.moreno@riverbend.edu</a> | <a href="https://twitter.com/LydiaNeuroLab">Twitter</a> | <a href="https://github.com/lydia-moreno">GitHub</a></p>\n    </footer>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > about.html << \'EOF\'\n<!DOCTYPE html>\n<html lang="en">\n<head>\n    <meta charset="UTF-8">\n    <meta name="viewport" content="width=device-width, initial-scale=1.0">\n    <title>About Me</title>\n    <style>\n        body {\n            font-family: Arial, sans-serif;\n            margin: 0;\n            padding: 0;\n            line-height: 1.6;\n        }\n        header {\n            background-color: #2c3e50;\n            color: white;\n            padding: 20px 0;\n            text-align: center;\n        }\n        header h1 {\n            margin: 0;\n        }\n        .section {\n            padding: 40px 20px;\n            max-width: 1200px;\n            margin: auto;\n        }\n        a {\n            color: #2c3e50;\n            text-decoration: none;\n        }\n        a:hover {\n            text-decoration: underline;\n        }\n        footer {\n            background-color: #2c3e50;\n            color: white;\n            padding: 20px 0;\n            text-align: center;\n        }\n    </style>\n</head>\n<body>\n    <header>\n        <h1>About Me</h1>\n    </header>\n    <div class="section" id="about">\n        <h2>Dr. Lydia Moreno</h2>\n        <p>Associate Professor of Computational Neuroscience at Riverbend University’s School of Biological Sciences.</p>\n        <p>Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information.</p>\n        <p>She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high-throughput imaging analysis at Northborough Research Center.</p>\n    </div>\n    <div class="section" id="education">\n        <h2>Education</h2>\n        <ul>\n            <li><strong>Ph.D., Computational Biology</strong> - Baywood Institute of Technology, 2014–2019</li>\n            <li><strong>M.Sc., Bioinformatics</strong> - Riverbend University, 2012–2014</li>\n            <li><strong>B.Sc., Computer Science</strong> - Crestfield College of Engineering, 2008–2012</li>\n        </ul>\n    </div>\n    <div class="section" id="research">\n        <h2>Research Interests</h2>\n        <ul>\n            <li>Neural Encoding & Decoding</li>\n            <li>Machine Learning for Biomedical Imaging</li>\n            <li>Single-Cell Omics</li>\n            <li>Explainable AI in Neuroscience</li>\n        </ul>\n    </div>\n    <div class="section" id="projects">\n        <h2>Selected Projects</h2>\n        <p>See <a href="index.html">Home</a> for details.</p>\n    </div>\n    <div class="section" id="publications">\n        <h2>Publications</h2>\n        <p>See <a href="index.html">Home</a> for details.</p>\n    </div>\n    <div class="section" id="teaching">\n        <h2>Teaching & Mentorship</h2>\n        <p>See <a href="index.html">Home</a> for details.</p>\n    </div>\n    <div class="section" id="skills">\n        <h2>Skills & Tools</h2>\n        <p>See <a href="index.html">Home</a> for details.</p>\n    </div>\n    <div class="section" id="contact">\n        <h2>Contact</h2>\n        <p>See <a href="index.html">Home</a> for details.</p>\n    </div>\n    <footer>\n        <p>Contact: <a href="mailto:lydia.moreno@riverbend.edu">lydia.moreno@riverbend.edu</a> | <a href="https://twitter.com/LydiaNeuroLab">Twitter</a> | <a href="https://github.com/lydia-moreno">GitHub</a></p>\n    </footer>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
