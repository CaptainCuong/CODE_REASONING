Sending keys: ['cat > evaluate.py << \'EOF\'\nimport mteb\nfrom mteb.datasets import STS12\nfrom mteb.evaluations import CosineSpearman\nimport huggingface_hub\nimport json\nimport os\n\n# Define candidate models and their types\ncandidates = [\n    (\'bert-base-uncased\', \'bert\'),\n    (\'roberta-base\', \'roberta\'),\n    (\'xlm-r-bert-base\', \'xlm-r\'),\n    (\'deberta-base\', \'deberta\'),\n    (\'distilbert-base-uncased\', \'distilbert\'),\n]\n\n# STS12 evaluation\ndataset = STS12()\neval = CosineSpearman()\n\nfor model_name, model_type in candidates:\n    # Get commit ID from Hugging Face\n    repo_id = model_name\n    commit = huggingface_hub.get_repo_commit(repo_id)\n    commit = commit[\'commit\']\n    \n    # Load model\n    try:\n        if model_type == \'bert\':\n            from transformers import BertModel\n            model = BertModel.from_pretrained(model_name)\n        elif model_type == \'roberta\':\n            from transformers import RobertaModel\n            model = RobertaModel.from_pretrained(model_name)\n        elif model_type == \'xlm-r\':\n            from transformers import XLMRModel\n            model = XLMRModel.from_pretrained(model_name)\n        elif model_type == \'deberta\':\n            from transformers import DebertaModel\n            model = DebertaModel.from_pretrained(model_name)\n        elif model_type == \'distilbert\':\n            from transformers import DistilBertModel\n            model = DistilBertModel.from_pretrained(model_name)\n    except Exception as e:\n        print(f"Failed to load {model_name}: {e}")\n        continue\n    \n    # Evaluate\n    result = eval.compute(model, dataset)\n    score = result[\'scores\'][0]\n    print(f"{model_name}: commit {commit[:10]}, score {score:.4f}")\n    if score > 0.7:\n        print(f"Found model with score > 0.7!")\n        # Build result path\n        org, name = model_name.split(\'-\')\n        result_path = f\'results/{org}_{name}/{commit[:10]}/sts12.json\'\n        # Create directory\n        os.makedirs(os.path.dirname(result_path), exist_ok=True)\n        # Write result\n        with open(result_path, \'w\') as f:\n            json.dump({\'score\': score, \'model\': model_name}, f)\n        print(f"Result saved to {result_path}")\n        break\n\nif not any(score > 0.7 for _, _ in candidates):\n    print("No model achieved score > 0.7")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
