ror_response("Missing signature parameter")\n    try:\n        tx = connection.get_transaction(sig)\n        return json.dumps({\n            "signature": tx.signature,\n            "slot": tx.slot,\n            "block_time": tx.block_time,\n            "success": tx.success,\n            "fee": tx.fee,\n            "token_transfers": tx.token_transfers\n        })\n    except Exception as e:\n        return error_response(f"Failed to get transaction {sig}: {e}")\n\n# /account/<address>\ndef get_account():\n    addr = request.args.get(\'address\')\n    if not addr:\n        return error_response("Missing address parameter")\n    try:\n        account = connection.get_account(addr)\n        return json.dumps({\n            "address": account.address,\n            "executable": account.executable,\n            "lamports": account.lamports,\n            "owner": account.owner,\n            "rent_epoch": account.rent_epoch\n        })\n    except Exception as e:\n        return error_response(f"Failed to get account {addr}: {e}")\n\n# /program/<program_id>/accounts\ndef get_program_accounts():\n    program_id = request.args.get(\'program_id\')\n    limit = request.args.get(\'limit\', default=10)\n    offset = request.args.get(\'offset\', default=0)\n    if not program_id:\n        return error_response("Missing program_id parameter")\n    try:\n        accounts = connection.get_program_accounts(program_id, limit=limit, offset=offset)\n        total = connection.get_program_account_count(program_id)\n        result = []\n        for account in accounts:\n            result.append({\n                "pubkey": account.pubkey,\n                "account": {\n                    "executable": account.executable,\n                    "lamports": account.lamports,\n                    "owner": account.owner,\n                    "rent_epoch": account.rent_epoch\n                }\n            })\n        return json.dumps({\n            "program_id": program_id,\n            "total_accounts": total,\n            "limit": limit,\n            "offset": offset,\n            "accounts": result\n        })\n    except Exception as e:\n        return error_response(f"Failed to get program accounts {program_id}: {e}")\n\n# Route definitions\napp.add_url_rule(\'/status\', \'status\', get_status)\napp.add_url_rule(\'/block/<slot_number>\', \'block\', get_block)\napp.add_url_rule(\'/transaction/<signature>\', \'transaction\', get_transaction)\napp.add_url_rule(\'/account/<address>\', \'account\', get_account)\napp.add_url_rule(\'/program/<program_id>/accounts\', \'program_accounts\', get_program_accounts)\n\nif __name__ == \'__main__\':\n    app.run(host=\'0.0.0.0\', port=5000, debug=False)\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
