Sending keys: ["cat > debug3.py << 'EOF'\nimport http.server\nimport json\nimport sys\nimport socket\nfrom urllib.parse import urlparse, parse_qs\n\nclass FibonacciHandler(http.server.BaseHTTPRequestHandler):\n    def do_GET(self):\n        try:\n            parsed = urlparse(self.path)\n            query = parse_qs(parsed.query)\n            n_str = query.get('n')\n            if n_str is None:\n                print('Missing query parameter n', file=sys.stderr)\n                self.send_error(400, 'Missing query parameter n')\n                return\n            try:\n                n = int(n_str[0])\n            except ValueError:\n                print('n must be an integer', file=sys.stderr)\n                self.send_error(400, 'n must be an integer')\n                return\n            # Compute Fibonacci\n            if n == 0:\n                result = 0\n            elif n == 1:\n                result = 1\n            else:\n                a, b = 0, 1\n                for _ in range(2, n+1):\n                    a, b = b, a + b\n                result = b\n            response = {'result': result}\n            print(f'Request for n={n} handled', file=sys.stderr)\n            self.send_response(200)\n            self.send_header('Content-Type', 'application/json')\n            self.end_headers()\n            self.wfile.write(json.dumps(response).encode())\n        except Exception as e:\n            print(f'Error in handler: {e}', file=sys.stderr)\n            self.send_error(500, 'Internal server error')\n\nif __name__ == '__main__':\n    server = http.server.HTTPServer(('0.0.0.0', 3000), FibonacciHandler)\n    print('Starting server on port 3000...', file=sys.stderr)\n    print('Server socket:', server.server_address, file=sys.stderr)\n    try:\n        server.serve_forever()\n    except Exception as e:\n        print(f'Server failed: {e}', file=sys.stderr)\n        sys.exit(1)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
