Sending keys: ['cat > evaluate.py << \'EOF\'\nimport os\nimport json\nfrom mteb import STS12\nfrom sentence_transformers import SentenceTransformer\nfrom sklearn.metrics.pairwise import cosine_spearman\n\n# Ensure results directory exists\nos.makedirs(\'/app/results\', exist_ok=True)\n\ndef evaluate_model(model_name, hf_model_org, hf_model_name):\n    """Evaluate a model on STS12 and return results dict."""\n    dataset = STS12()\n    model = SentenceTransformer(model_name)\n    \n    # Get all pairs (sentences, similarity scores)\n    pairs = dataset.get_pairs()\n    sentences = [pair[0] + \' \' + pair[1] for pair in pairs]\n    sentences = model.tokenize(sentences)\n    \n    # Get similarity scores\n    scores = [pair[2] for pair in pairs]\n    \n    # Compute cosine_spearman\n    try:\n        score = cosine_spearman(sentences, scores)\n    except Exception as e:\n        print(f"Error computing cosine_spearman for {model_name}: {e}")\n        score = 0.0\n    \n    # Get model commit ID (approximate)\n    commit_id = model_name.split(\'-\')[-1][:8]\n    \n    result = {\n        "model": model_name,\n        "task": "STS12",\n        "score": score,\n        "commit_id": commit_id,\n        "hf_model_org": hf_model_org,\n        "hf_model_name": hf_model_name\n    }\n    return result\n\n# List of models to evaluate\nmodels = [\n    ("all-mpnet-base-v2", "sentence-transformers", "all-mpnet-base-v2"),\n    ("paraphrase-MiniLM-L12-v2", "sentence-transformers", "paraphrase-MiniLM-L12-v2"),\n    ("roberta-base", "huggingface", "roberta-base"),\n    ("bert-base-uncased", "huggingface", "bert-base-uncased"),\n    ("distilbert-base-uncased", "huggingface", "distilbert-base-uncased"),\n]\n\nbest_score = -1.0\nbest_result = None\n\nfor model_name, hf_model_org, hf_model_name in models:\n    result = evaluate_model(model_name, hf_model_org, hf_model_name)\n    score = result["score"]\n    if score > best_score:\n        best_score = score\n        best_result = result\n\nprint(f"Best score: {best_score} with model {best_result[\'model\']}")\n\n# Save results in the required format\noutput_path = f"/app/results/{best_result[\'hf_model_org\']}__{best_result[\'hf_model_name\']}/{best_result[\'commit_id\']}/STS12.json"\nos.makedirs(os.path.dirname(output_path), exist_ok=True)\nwith open(output_path, \'w\') as f:\n    json.dump(best_result, f, indent=2)\n\nprint(f"Results saved to {output_path}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
