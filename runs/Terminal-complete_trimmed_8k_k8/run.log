Sending keys: ["cat > server.py << 'EOF'\nimport json\nimport sys\nimport uvicorn\nfrom fastapi import FastAPI, Path, Query, HTTPException\nfrom fastapi.responses import JSONResponse\nfrom typing import Optional\n\napp = FastAPI()\n\n# Initialize Solana connection\nfrom solana import Solana\nfrom solana.connection import Connection\nfrom solana.transaction import Transaction\nfrom solana.block import Block\nfrom solana.account import Account\nfrom solana.program import Program\n\n# Connect to mainnet-beta\nconn = Connection('https://api.mainnet-beta.solana.com')\nsolana = Solana(conn)\n\n# Helper function to return error JSON\ndef error_response(message: str):\n    return JSONResponse({'error': message}, status_code=404)\n\n# /status endpoint\n@app.get('/status')\ndef get_status():\n    try:\n        # Get network status\n        network = solana.get_network()\n        current_slot = solana.get_current_slot()\n        node_count = solana.get_node_count()\n        version = solana.get_version()\n        return {\n            'status': 'online',  # we assume online if we can query\n            'network': network,\n            'current_slot': current_slot,\n            'node_count': node_count,\n            'version': version\n        }\n    except Exception as e:\n        return error_response(f'Failed to get network status: {e}')\n\n# /block/<slot_number>\n@app.get('/block/{slot_number}')\ndef get_block(slot_number: int):\n    try:\n        block = Block.load(solana, slot_number)\n        return {\n            'blockhash': block.hash,\n            'parent_slot': block.parent_slot,\n            'previous_blockhash': block.previous_blockhash,\n            'block_height': block.height,\n            'block_time': block.time\n        }\n    except Exception as e:\n        return error_response(f'Block not found: {e}')\n\n# /transaction/<signature>\n@app.get('/transaction/{signature}')\ndef get_transaction(signature: str):\n    try:\n        transaction = Transaction.load(solana, signature)\n        # Get block that contains the transaction\n        block = Block.load(solana, transaction.slot)\n        return {\n            'signature': signature,\n            'slot': transaction.slot,\n            'block_time': block.time,\n            'success': transaction.success,\n            'fee': transaction.fee,\n            'token_transfers': []  # placeholder, need to parse token transfers\n        }\n    except Exception as e:\n        return error_response(f'Transaction not found: {e}')\n\n# /account/<address>\n@app.get('/account/{address}')\ndef get_account(address: str):\n    try:\n        account = Account.load(solana, address)\n        return {\n            'address': address,\n            'executable': account.executable,\n            'lamports': account.lamports,\n            'owner': account.owner,\n            'rent_epoch': account.rent_epoch\n        }\n    except Exception as e:\n        return error_response(f'Account not found: {e}')\n\n# /program/<program_id>/accounts\n@app.get('/program/{program_id}/accounts',\n         dependencies=[Depends(get_network_from_query)])\ndef get_program_accounts(program_id: str, limit: int = 10, offset: int = 0):\n    # We'll need to parse the program ID and get accounts\n    # For simplicity, we'll just return a placeholder\n    return {\n        'program_id': program_id,\n        'total_accounts': 0,\n        'limit': limit,\n        'offset': offset,\n        'accounts': []\n    }\n\nif __name__ == '__main__':\n    uvicorn.run(app, host='0.0.0.0', port=5000, workers=4)\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
