Sending keys: ['cat > server.py << \'EOF\'\nimport json\nimport sys\nfrom flask import Flask, request, abort, redirect\nfrom solana import RPCClient\nfrom solana.publickey import PublicKey\nfrom solana.block import Block\nfrom solana.token import Token\nfrom solana.token.account import TokenAccount\nfrom solana.token.mint import Mint\nfrom solana.token.metadata import Metadata\nfrom solana.token.rent import Rent\nfrom solana.token.transfer import Transfer\nfrom solana.token.program import TokenProgram\nfrom solana.transaction import Transaction\n\n# Use devnet RPC endpoint\ndef get_network():\n    return \'devnet\'\n\ndef get_client():\n    return RPCClient(\'https://devnet.gonzorpc.com\')\n\ndef get_error_response(error_msg):\n    return json.dumps({\'error\': error_msg})\n\napp = Flask(__name__)\n\n# Helper function to get account info\n# We\'ll use the solana library to fetch.\n\n@app.route(\'/status\')\ndef status():\n    client = get_client()\n    try:\n        status = client.get_status()\n        # According to solana library, status is a dict with network, epoch, slot, etc.\n        # We need to map to required fields.\n        # The status dict contains: network, epoch, slot, node_count, version\n        network = status.get(\'network\', \'unknown\')\n        current_slot = status.get(\'current_slot\', 0)\n        node_count = status.get(\'node_count\', 0)\n        version = status.get(\'version\', \'unknown\')\n        # The status dict also has \'status\' field indicating \'connected\' or \'disconnected\'\n        # We\'ll set status as \'online\' if status.get(\'status\') == \'connected\'\n        # However, the spec expects status: "online" or "offline"\n        # Let\'s assume the status dict has a \'status\' key.\n        status_str = status.get(\'status\')\n        if status_str == \'connected\':\n            status_result = \'online\'\n        else:\n            status_result = \'offline\'\n        return json.dumps({\n            \'status\': status_result,\n            \'network\': network,\n            \'current_slot\': current_slot,\n            \'node_count\': node_count,\n            \'version\': version\n        })\n    except Exception as e:\n        return get_error_response(f\'Failed to get status: {e}\')\n\n@app.route(\'/block/<int:slot>\')\ndef block(slot):\n    client = get_client()\n    try:\n        block_data = client.get_block(slot)\n        # block_data is a dict with blockhash, parent_slot, previous_blockhash, block_height, block_time\n        return json.dumps(block_data)\n    except Exception as e:\n        if \'Block not found\' in str(e):\n            return get_error_response(\'404 Not Found\')\n        else:\n            return get_error_response(f\'Failed to get block: {e}\')\n\n@app.route(\'/transaction/<signature>\')\ndef transaction(signature):\n    client = get_client()\n    try:\n        tx = client.get_transaction(signature)\n        # tx is a Transaction object with fields: slot, block_time, success, fee, token_transfers\n        token_transfers = []\n        for transfer in tx.token_transfers:\n            token_transfers.append({\n                \'account\': str(transfer.account),\n                \'mint\': str(transfer.mint),\n                \'amount\': transfer.amount\n            })\n        result = {\n            \'signature\': signature,\n            \'slot\': tx.slot,\n            \'block_time\': tx.block_time,\n            \'success\': tx.success,\n            \'fee\': tx.fee,\n            \'token_transfers\': token_transfers\n        }\n        return json.dumps(result)\n    except Exception as e:\n        if \'Transaction not found\' in str(e):\n            return get_error_response(\'404 Not Found\')\n        else:\n            return get_error_response(f\'Failed to get transaction: {e}\')\n\n@app.route(\'/account/<address>\')\ndef account(address):\n    client = get_client()\n    try:\n        acc = client.get_account(PublicKey(address))\n        # acc is an Account object with fields: executable, lamports, owner, rent_epoch\n        result = {\n            \'address\': address,\n            \'executable\': acc.executable,\n            \'lamports\': acc.lamports,\n            \'owner\': str(acc.owner),\n            \'rent_epoch\': acc.rent_epoch\n        }\n        return json.dumps(result)\n    except Exception as e:\n        if \'Account not found\' in str(e):\n            return get_error_response(\'404 Not Found\')\n        else:\n            return get_error_response(f\'Failed to get account: {e}\')\n\n@app.route(\'/program/<program_id>/accounts\')\ndef program_accounts(program_id):\n    client = get_client()\n    limit = request.args.get(\'limit\', 10)\n    offset = request.args.get(\'offset\', 0)\n    try:\n        accounts = client.get_program_accounts(PublicKey(program_id), limit=limit, offset=offset)\n        total = accounts.total\n        result = {\n            \'program_id\': program_id,\n            \'total_accounts\': total,\n            \'limit\': limit,\n            \'offset\': offset,\n            \'accounts\': []\n        }\n        for acc in accounts.accounts:\n            result[\'accounts\'].append({\n                \'pubkey\': str(acc.pubkey),\n                \'account\': {\n                    \'executable\': acc.executable,\n                    \'lamports\': acc.lamports,\n                    \'owner\': str(acc.owner),\n                    \'rent_epoch\': acc.rent_epoch\n                }\n            })\n        return json.dumps(result)\n    except Exception as e:\n        return get_error_response(f\'Failed to get program accounts: {e}\')\n\nif __name__ == \'__main__\':\n    app.run(host=\'0.0.0.0\', port=5000)\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
