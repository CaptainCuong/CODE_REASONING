Sending keys: ['cat > cli_tool.c << \'EOF\'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <cJSON.h>\n#include <lodepng.h>\n\n// Neural network parameters\n#define INPUT_DIM 28 * 28\n#define HIDDEN_DIM 16\n#define OUTPUT_DIM 10\n\n// Load weights from weights.json\nvoid load_weights(char* filename, float* W1, float* b1, float* W2, float* b2, float* W3, float* b3) {\n    FILE* f = fopen(filename, "r");\n    if (!f) {\n        fprintf(stderr, "Failed to open %s\\n", filename);\n        exit(1);\n    }\n    cJSON* root = cJSON_CreateFile(f);\n    fclose(f);\n    \n    // Get weights\n    cJSON* w1 = cJSON_GetObjectItem(root, "input_layer.weight");\n    cJSON* b1 = cJSON_GetObjectItem(root, "input_layer.bias");\n    cJSON* w2 = cJSON_GetObjectItem(root, "hidden_layer.weight");\n    cJSON* b2 = cJSON_GetObjectItem(root, "hidden_layer.bias");\n    cJSON* w3 = cJSON_GetObjectItem(root, "output_layer.weight");\n    cJSON* b3 = cJSON_GetObjectItem(root, "output_layer.bias");\n    \n    // Convert to float\n    int n = cJSON_GetArraySize(w1);\n    for (int i = 0; i < n; i++) {\n        W1[i] = (float)cJSON_GetNumberValue(cJSON_GetArrayElement(w1, i));\n    }\n    n = cJSON_GetArraySize(b1);\n    for (int i = 0; i < n; i++) {\n        b1[i] = (float)cJSON_GetNumberValue(cJSON_GetArrayElement(b1, i));\n    }\n    n = cJSON_GetArraySize(w2);\n    for (int i = 0; i < n; i++) {\n        W2[i] = (float)cJSON_GetNumberValue(cJSON_GetArrayElement(w2, i));\n    }\n    n = cJSON_GetArraySize(b2);\n    for (int i = 0; i < n; i++) {\n        b2[i] = (float)cJSON_GetNumberValue(cJSON_GetArrayElement(b2, i));\n    }\n    n = cJSON_GetArraySize(w3);\n    for (int i = 0; i < n; i++) {\n        W3[i] = (float)cJSON_GetNumberValue(cJSON_GetArrayElement(w3, i));\n    }\n    n = cJSON_GetArraySize(b3);\n    for (int i = 0; i < n; i++) {\n        b3[i] = (float)cJSON_GetNumberValue(cJSON_GetArrayElement(b3, i));\n    }\n    \n    cJSON_Delete(root);\n}\n\n// Neural network inference\nint predict(float* img_vec, float* W1, float* b1, float* W2, float* b2, float* W3, float* b3) {\n    // Input layer\n    float x[HIDDEN_DIM];\n    for (int i = 0; i < HIDDEN_DIM; i++) {\n        float s = b1[i];\n        for (int j = 0; j < INPUT_DIM; j++) {\n            s += W1[i * INPUT_DIM + j] * img_vec[j];\n        }\n        x[i] = max(s, 0.0f);\n    }\n    \n    // Hidden layer\n    float y[HIDDEN_DIM];\n    for (int i = 0; i < HIDDEN_DIM; i++) {\n        float s = b2[i];\n        for (int j = 0; j < HIDDEN_DIM; j++) {\n            s += W2[i * HIDDEN_DIM + j] * x[j];\n        }\n        y[i] = max(s, 0.0f);\n    }\n    \n    // Output layer\n    float out[OUTPUT_DIM];\n    for (int i = 0; i < OUTPUT_DIM; i++) {\n        float s = b3[i];\n        for (int j = 0; j < HIDDEN_DIM; j++) {\n            s += W3[i * HIDDEN_DIM + j] * y[j];\n        }\n        out[i] = s;\n    }\n    \n    // Find predicted digit\n    int pred = out[0];\n    for (int i = 1; i < OUTPUT_DIM; i++) {\n        if (out[i] > out[pred]) {\n            pred = i;\n        }\n    }\n    return pred;\n}\n\nint main(int argc, char* argv[]) {\n    if (argc != 3) {\n        fprintf(stderr, "Usage: %s <weights.json> <image.png>\\n", argv[0]);\n        exit(1);\n    }\n    \n    // Load weights\n    float W1[HIDDEN_DIM * INPUT_DIM];\n    float b1[HIDDEN_DIM];\n    float W2[HIDDEN_DIM * HIDDEN_DIM];\n    float b2[HIDDEN_DIM];\n    float W3[OUTPUT_DIM * HIDDEN_DIM];\n    float b3[OUTPUT_DIM];\n    load_weights(argv[1], W1, b1, W2, b2, W3, b3);\n    \n    // Load image\n    unsigned char* image_data;\n    unsigned int width, height;\n    lodepng_decode_file(&image_data, &width, &height, argv[2], 0);\n    \n    // Flatten image\n    float img_vec[INPUT_DIM];\n    for (int i = 0; i < INPUT_DIM; i++) {\n        img_vec[i] = (float)image_data[i];\n    }\n    \n    // Predict\n    int pred = predict(img_vec, W1, b1, W2, b2, W3, b3);\n    \n    // Print prediction\n    printf("%d\\n", pred);\n    \n    // Clean up\n    free(image_data);\n    return 0;\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
