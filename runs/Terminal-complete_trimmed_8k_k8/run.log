y[peaks[peak_indices[:2]]]\nprint('Top 2 peak intensities:', peak_intensities)\nprint('Corresponding x values:', x[peaks[peak_indices[:2]]])\n\n# Compute scaling factor\nx_peak1 = x[peaks[peak_indices[0]]]\nx_peak2 = x[peaks[peak_indices[1]]]\nexpected_diff_cm = 2700 - 1580\nscaling_factor = expected_diff_cm / (x_peak2 - x_peak1)\nprint('Scaling factor (cm per arbitrary unit):', scaling_factor)\n\n# Now fit Lorentzian to each peak\n# We'll fit around each peak using a window of +/- 5% of the x range\n# But we don't know the width. Let's fit the whole data to each peak separately.\n# We'll define a function that fits a Lorentzian with initial guesses.\ndef fit_peak(x, y, x0_guess, y0_guess):\n    # Initial guess for gamma: 10, amplitude: 1000, offset: 1000\n    p0 = (x0_guess, 10, 1000, 1000)\n    # Fit\n    try:\n        popt, pcov = opt.curve_fit(lorentzian, x, y, p0=p0, maxfev=5000)\n        return popt\n    except Exception as e:\n        print('Fit failed:', e)\n        return None\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude * gamma / ( (x - x0)**2 + gamma**2 ) + offset\n\n# Fit each peak\nresults = {}\nfor i in peak_indices[:2]:\n    xi = x[peaks[i]]\n    yi = y[peaks[i]]\n    # Use a window around the peak to avoid fitting noise too much\n    start = max(0, peaks[i] - 100)\n    end = min(len(x), peaks[i] + 100)\n    xi_window = x[start:end]\n    yi_window = y[start:end]\n    popt = fit_peak(xi_window, yi_window, xi, yi)\n    if popt is None:\n        print('Could not fit peak at x=', xi)\n        continue\n    x0_arb, gamma_arb, amp_arb, offset_arb = popt\n    # Convert to cm-1\n    x0_cm = x0_arb * scaling_factor\n    gamma_cm = gamma_arb * scaling_factor\n    # Keep amplitude and offset as intensity units\n    results[f'Peak{i+1}'] = {\n        'x0': float(x0_cm),\n        'gamma': float(gamma_cm),\n        'amplitude': float(amp_arb),\n        'offset': float(offset_arb)\n    }\n\n# Rename keys to 'G' and '2D' (assuming peak1 is G, peak2 is 2D)\n# But we don't know which is which. We'll assume peak1 is G (lower x) and peak2 is 2D (higher x).\n# Actually G is at 1580, 2D at 2700. So peak1 (lower x) is G, peak2 is 2D.\nresults['G'] = results.pop('Peak1')\nresults['2D'] = results.pop('Peak2')\n\n# Write results\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('Results written to results.json')\nprint(json.dumps(results, indent=2))\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
