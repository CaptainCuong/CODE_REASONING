Sending keys: ["cat > debug_train.py << 'EOF'\nimport pandas as pd\nimport fasttext\nimport numpy as np\n\n# Load data\ndf_train = pd.read_parquet('data/train-00000-of-00001.parquet')\ndf_test = pd.read_parquet('data/test-00000-of-00001.parquet')\n\n# Convert label to int\ndf_train['label'] = df_train['label'].astype(int)\ndf_test['label'] = df_test['label'].astype(int)\n\n# Write training file\ntrain_file = 'train.txt'\nwith open(train_file, 'w') as f:\n    for idx, row in df_train.iterrows():\n        label = row['label']\n        text = row['text']\n        # Write label and then text (space separated)\n        f.write(f'{label} {text}\\n')\nprint(f'Training file written: {train_file} (size: {os.path.getsize(train_file)} bytes)')\n\n# Train model\nmodel = fasttext.train_supervised(train_file)\nprint('Model created.')\nprint('Model word count:', model.get_dimension())\nprint('Model label count:', model.get_labels())\nprint('Labels:', model.get_labels())\n\n# Evaluate on test set\ntest_file = 'test.txt'\nwith open(test_file, 'w') as f:\n    for idx, row in df_test.iterrows():\n        label = row['label']\n        text = row['text']\n        f.write(f'{label} {text}\\n')\n\npred = model.predict(test_file, k=1)\nprint('Prediction shape:', pred.shape)\nlabels_test = [int(p[0].split()[0]) for p in pred]\naccuracy = np.mean(labels_test == df_test['label'])\nprint(f'Accuracy: {accuracy:.4f}')\n\n# Save model\nmodel.save('model.bin')\nprint('Model saved to model.bin')\n\n# Check size\nimport os\nsize = os.path.getsize('model.bin')\nprint(f'Model size: {size} bytes')\nif size > 150 * 1024 * 1024:\n    print('WARNING: Model size exceeds 150MB')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
