:\n    avg_years = 0\n\ntotal_employees = len(all_employees)\n\n# Compare with data\nstats = data['statistics']\nprint('Comparing statistics...')\nprint('averageDepartmentBudget: expected', avg_dept_budget, 'got', stats['averageDepartmentBudget'])\nprint('totalEmployees: expected', total_employees, 'got', stats['totalEmployees'])\nprint('skillDistribution: expected', dict(skill_dist), 'got', stats['skillDistribution'])\nprint('departmentSizes: expected', dict(dept_sizes), 'got', stats['departmentSizes'])\nprint('projectStatusDistribution: expected', dict(project_status_counts), 'got', stats['projectStatusDistribution'])\nprint('averageYearsOfService: expected', avg_years, 'got', stats['averageYearsOfService'])\n\n# Check if all values match (allow floating point rounding)\ntol = 0.001\nerrors = []\nif abs(stats['averageDepartmentBudget'] - avg_dept_budget) > tol:\n    errors.append('averageDepartmentBudget mismatch')\nif stats['totalEmployees'] != total_employees:\n    errors.append('totalEmployees mismatch')\nif stats['skillDistribution'] != dict(skill_dist):\n    errors.append('skillDistribution mismatch')\nif stats['departmentSizes'] != dict(dept_sizes):\n    errors.append('departmentSizes mismatch')\nif stats['projectStatusDistribution'] != dict(project_status_counts):\n    errors.append('projectStatusDistribution mismatch')\nif abs(stats['averageYearsOfService'] - avg_years) > tol:\n    errors.append('averageYearsOfService mismatch')\n\nif errors:\n    print('Errors:', errors)\n    sys.exit(1)\nelse:\n    print('All statistics match expected values.')\n\n# Check organization metadata\norg = data['organization']\nprint('\\nOrganization name:', org['name'])\nprint('Organization founded:', org['founded'])\nprint('Number of departments:', len(org['departments']))\n\n# Check each department has required fields\nfor dept in org['departments']:\n    if not ('id' in dept and 'name' in dept and 'budget' in dept and 'employees' in dept and 'projects' in dept):\n        print('Missing required field in department:', dept)\n    if not isinstance(dept['budget'], (int, float)):\n        print('Budget not numeric:', dept['budget'])\n    if not isinstance(dept['employees'], list):\n        print('Employees not list:', dept['employees'])\n    if not isinstance(dept['projects'], list):\n        print('Projects not list:', dept['projects'])\n\nprint('Validation complete.')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
