Sending keys: ["cat > train_fasttext.py << 'EOF'\nimport pandas as pd\nimport pyarrow as pa\nimport fasttext\nimport sys\nimport os\n\n# Load data\ndf_train = pd.read_parquet('/app/data/train-00000-of-00001.parquet')\ndf_test = pd.read_parquet('/app/data/test-00000-of-00001.parquet')\n\n# Convert to fasttext format: label + space + text\ntext_train = []\nfor _, row in df_train.iterrows():\n    label = str(row['rating'])\n    text = str(row['text'])\n    text_train.append(label + ' ' + text)\n\ntext_test = []\nfor _, row in df_test.iterrows():\n    label = str(row['rating'])\n    text = str(row['text'])\n    text_test.append(label + ' ' + text)\n\n# Train model\nmodel = fasttext.train_supervised(text_train, loss='log_loss', epoch=20, wordNgrams=1)\nprint('Model trained')\nprint('Model size:', os.path.getsize('/app/model.bin'))\n\n# Evaluate on test set\nlabels_test = []\npreds_test = []\nfor sentence in text_test:\n    labels, probs = model.predict_proba(sentence, k=1)\n    labels_test.append(labels[0])\n    preds_test.append(probs[0])\n\n# Compute accuracy\ncorrect = sum(1 for l, p in zip(labels_test, preds_test) if l == p)\ntotal = len(labels_test)\naccuracy = correct / total if total > 0 else 0\nprint('Accuracy:', accuracy)\n\n# Save model\nmodel.save_model('/app/model.bin')\nprint('Model saved to /app/model.bin')\nEOF\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
