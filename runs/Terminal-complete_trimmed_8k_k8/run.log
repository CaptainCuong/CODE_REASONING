Sending keys: ['cat > fit_peaks.py << \'EOF\'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\n\n# Load data\nwith open(\'graphene.dat\', \'r\') as f:\n    lines = f.readlines()\n# Assume two columns: wavelength and intensity\nwavelengths = []\nintensities = []\nfor line in lines:\n    parts = line.strip().split()\n    if len(parts) == 2:\n        wavelengths.append(float(parts[0]))\n        intensities.append(float(parts[1]))\n\nx = np.array(wavelengths)\ny = np.array(intensities)\n\n# Gaussian function\ndef gaussian(x, x0, gamma, amplitude, offset):\n    return amplitude * np.exp(-0.5 * ((x - x0) / gamma) ** 2) + offset\n\n# Initial guesses\n# G peak around 1580, width ~10, amplitude ~10000, offset ~0\np0_G = (1580, 10, 10000, 0)\n# 2D peak around 2700, width ~30, amplitude ~5000, offset ~0\np0_2D = (2700, 30, 5000, 0)\n\n# Fit\ntry:\n    popt_G, pcov_G = curve_fit(gaussian, x, y, p0=p0_G, maxfev=5000)\nexcept Exception as e:\n    print(f"Fit for G failed: {e}")\n    popt_G = None\n\ntry:\n    popt_2D, pcov_2D = curve_fit(gaussian, x, y, p0=p0_2D, maxfev=5000)\nexcept Exception as e:\n    print(f"Fit for 2D failed: {e}")\n    popt_2D = None\n\n# Prepare results\nresults = {\n    "G": {\n        "x0": float(popt_G[0]),\n        "gamma": float(popt_G[1]),\n        "amplitude": float(popt_G[2]),\n        "offset": float(popt_G[3])\n    },\n    "2D": {\n        "x0": float(popt_2D[0]),\n        "gamma": float(popt_2D[1]),\n        "amplitude": float(popt_2D[2]),\n        "offset": float(popt_2D[3])\n    }\n}\n\n# Write to file\nwith open(\'results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint("Results written to results.json")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
