Sending keys: ["cat > train_model.py << 'EOF'\nimport pandas as pd\nimport fasttext\nimport numpy as np\nimport os\n\n# Load data\ntrain_df = pd.read_parquet('data/train-00000-of-00001.parquet')\ntest_df = pd.read_parquet('data/test-00000-of-00001.parquet')\n\n# Split train into train/validation\ntrain_size = int(len(train_df) * 0.8)\ntrain_df = train_df.head(train_size)\nvalid_df = train_df.tail(len(train_df) - train_size)\n\n# Prepare fasttext data: text + label\ntrain_texts = train_df['text'].tolist()\ntrain_labels = train_df['label'].tolist()\nvalid_texts = valid_df['text'].tolist()\nvalid_labels = valid_df['label'].tolist()\ntest_texts = test_df['text'].tolist()\ntest_labels = test_df['label'].tolist()\n\n# Train fasttext with dimension 100 (default) and word_level=False\nmodel = fasttext.FastText()\nmodel.fit(train_texts, train_labels, valid=valid_texts, valid_labels=valid_labels, epoch=20)\n\n# Evaluate on validation and test\nval_acc = model.get_accuracy(valid_texts, valid_labels)\ntest_acc = model.get_accuracy(test_texts, test_labels)\nprint(f'Validation accuracy: {val_acc:.4f}')\nprint(f'Test accuracy: {test_acc:.4f}')\n\n# Save model\nmodel.save('model.bin')\nprint('Model saved to model.bin')\n\n# Check model size\nsize = os.path.getsize('model.bin')\nprint(f'Model size: {size} bytes ({size/1024/1024:.2f} MB)')\nif size > 150 * 1024 * 1024:\n    print('WARNING: Model size exceeds 150 MB!')\nelse:\n    print('Model size OK (<150 MB).')\n\n# If accuracy < 0.62, we might need to adjust dimension\nif test_acc < 0.62:\n    print(f'Test accuracy below 0.62: {test_acc}. Considering dimension reduction.')\n    # Try dimension 50\n    model2 = fasttext.FastText(dimension=50)\n    model2.fit(train_texts, train_labels, valid=valid_texts, valid_labels=valid_labels, epoch=20)\n    test_acc2 = model2.get_accuracy(test_texts, test_labels)\n    print(f'With dimension 50, test accuracy: {test_acc2:.4f}')\n    if test_acc2 >= 0.62:\n        model2.save('model.bin')\n        print('Model with dimension 50 saved.')\n    else:\n        print('Still below threshold. Consider further adjustments.')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
