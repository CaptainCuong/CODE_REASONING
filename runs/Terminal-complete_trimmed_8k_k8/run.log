Sending keys: ['cat > check_cert.py << \'EOF\'\nimport ssl\nimport subprocess\nimport sys\nimport datetime\n\ndef parse_openssl_date(date_str):\n    # OpenSSL date format: e.g., "Nov 10 00:00:00 2024 GMT"\n    # Convert to YYYY-MM-DD\n    # Use datetime.strptime with %b %d %H:%M:%S %Y %z\n    try:\n        dt = datetime.datetime.strptime(date_str, \'%b %d %H:%M:%S %Y %z\')\n    except ValueError:\n        # maybe no timezone\n        try:\n            dt = datetime.datetime.strptime(date_str, \'%b %d %H:%M:%S %Y\')\n        except ValueError:\n            # fallback: just take year-month-day part\n            date_part = date_str.split()[0]\n            dt = datetime.datetime.strptime(date_part, \'%Y-%m-%d\')\n    return dt.strftime(\'%Y-%m-%d\')\n\ndef main():\n    # Check if certificate and key exist\n    cert_path = \'/app/ssl/server.pem\'\n    try:\n        with open(cert_path, \'rb\') as f:\n            data = f.read()\n    except FileNotFoundError:\n        print(\'Certificate file not found\')\n        sys.exit(1)\n    \n    # Get subject\n    subject_proc = subprocess.run([\'openssl\', \'x509\', \'-subject\', \'-noheader\', \'-cert\', cert_path],\n                                 capture_output=True, text=True)\n    subject = subject_proc.stdout.strip()\n    if subject == \'\':\n        print(\'Failed to get subject\')\n        sys.exit(1)\n    \n    # Get dates\n    dates_proc = subprocess.run([\'openssl\', \'x509\', \'-dates\', \'-cert\', cert_path],\n                               capture_output=True, text=True)\n    dates = dates_proc.stdout.strip()\n    if not dates:\n        print(\'Failed to get dates\')\n        sys.exit(1)\n    # Parse dates: first line \'Valid From:\', second \'Valid To:\'\n    lines = dates.split(\'\\n\')\n    valid_from_str = lines[0].split(\': \')[1] if len(lines) > 0 else \'\'\n    valid_to_str = lines[1].split(\': \')[1] if len(lines) > 1 else \'\'\n    \n    # Get common name from subject\n    # Subject format: /C=US/O=DevOps Team/CN=dev-internal.company.local\n    parts = subject.split(\'/\')\n    common_name = None\n    for part in parts:\n        if part.startswith(\'CN=\'):\n            common_name = part[4:]\n            break\n    if common_name is None:\n        print(\'Could not find common name\')\n        sys.exit(1)\n    \n    # Convert dates\n    try:\n        valid_from = parse_openssl_date(valid_from_str)\n        valid_to = parse_openssl_date(valid_to_str)\n    except Exception as e:\n        print(f\'Error parsing dates: {e}\')\n        sys.exit(1)\n    \n    print(f\'Subject: {subject}\')\n    print(f\'Valid from: {valid_from}\')\n    print(f\'Valid to: {valid_to}\')\n    print(f\'Common Name: {common_name}\')\n    print(\'Certificate verification successful\')\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
