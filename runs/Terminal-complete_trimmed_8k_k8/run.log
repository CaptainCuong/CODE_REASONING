Sending keys: ["cat > reshape.py << 'EOF'\nimport os\nimport math\nimport shutil\nimport sys\n\nc4_sample = 'c4_sample'\nc4_reshard = 'c4_reshard'\nmax_files_per_folder = 30\nmax_filesize = 15 * 1024 * 1024  # 15 MB\n\n# Create c4_reshard directory\nos.makedirs(c4_reshard, exist_ok=True)\n\n# List all files in c4_sample\nfiles = []\nfor root, dirs, filenames in os.walk(c4_sample):\n    for f in filenames:\n        files.append(os.path.join(root, f))\n\nprint(f'Total files: {len(files)}')\n\n# Check if any file exceeds max_filesize\nfor f in files:\n    size = os.path.getsize(f)\n    if size > max_filesize:\n        print(f'Warning: {f} size {size} > 15MB, splitting into chunks')\n        # We'll split later\n\n# Determine number of subdirectories needed\nnum_files = len(files)\nnum_folders = math.ceil(num_files / max_files_per_folder)\nprint(f'Number of subdirectories needed: {num_folders}')\n\n# Create subdirectories\nfor i in range(num_folders):\n    sub = os.path.join(c4_reshard, f'folder{i}')\n    os.makedirs(sub, exist_ok=True)\n\n# Split large files and distribute\nfor idx, f in enumerate(files):\n    size = os.path.getsize(f)\n    if size > max_filesize:\n        # Split into chunks\n        num_chunks = math.ceil(size / max_filesize)\n        print(f'Splitting {f} into {num_chunks} chunks')\n        # Read file in binary\n        with open(f, 'rb') as src:\n            chunk = src.read(max_filesize)\n            chunk_num = 0\n            while chunk:\n                chunk_num += 1\n                folder_idx = (idx + chunk_num - 1) // max_files_per_folder % num_folders\n                folder = os.path.join(c4_reshard, f'folder{folder_idx}')\n                dst = os.path.join(folder, os.path.basename(f) + f'-{chunk_num:03d}')\n                with open(dst, 'wb') as dst_file:\n                    dst_file.write(chunk)\n                # Read next chunk\n                chunk = src.read(max_filesize)\n        print(f'Distributed {f} into {num_chunks} chunks')\n        # After splitting, we should not count the original file in the list for distribution\n        # But we already incremented idx? We'll break out of loop for this file\n        # We'll continue with the next file\n        continue\n    # Regular file\n    folder_idx = (idx // max_files_per_folder) % num_folders\n    folder = os.path.join(c4_reshard, f'folder{folder_idx}')\n    shutil.copy2(f, os.path.join(folder, os.path.basename(f)))\n    print(f'Copied {f} to {folder}')\n\n# Verify distribution\nfor i in range(num_folders):\n    folder = os.path.join(c4_reshard, f'folder{i}')\n    count = len(os.listdir(folder))\n    print(f'folder{i}: {count} files')\n    if count > max_files_per_folder:\n        print('ERROR: folder exceeds max files')\n\nprint('Resharing complete.')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
