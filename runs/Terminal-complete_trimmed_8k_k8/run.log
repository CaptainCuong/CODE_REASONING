Sending keys: ["cat > /app/check_cert.py << 'EOF'\nimport subprocess\nimport sys\nimport os\n\ndef get_certificate_details():\n    # Use OpenSSL to get details\n    cmd = ['openssl', 'x509', '-in', '/app/ssl/server.crt', '-subject']\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if result.returncode == 0:\n        subject = result.stdout.strip()\n    else:\n        subject = 'Failed to get subject'\n    \n    cmd = ['openssl', 'x509', '-in', '/app/ssl/server.crt', '-dates']\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    dates = result.stdout.strip()\n    \n    cmd = ['openssl', 'x509', '-in', '/app/ssl/server.crt', '-sha256', '-fingerprint']\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if result.returncode == 0:\n        fingerprint = result.stdout.strip()\n    else:\n        fingerprint = 'Failed to get SHA-256 fingerprint'\n    \n    return subject, dates, fingerprint\n\ndef main():\n    ssl_path = '/app/ssl/server.pem'\n    if not os.path.exists(ssl_path):\n        print(f'Error: PEM file not found at {ssl_path}')\n        sys.exit(1)\n    try:\n        # Load the PEM file to verify it's a valid certificate\n        with open(ssl_path, 'rb') as f:\n            cert_data = f.read()\n        # Try to load using OpenSSL via subprocess\n        cmd = ['openssl', 'x509', '-x509opt', 'no-CA-check', '-in', ssl_path, '-out', '/dev/null', '-noout', '-noenc']\n        result = subprocess.run(cmd, capture_output=True, text=True)\n        if result.returncode != 0:\n            print(f'Error loading PEM file: {result.stderr}')\n            sys.exit(1)\n        \n        subject, dates, fingerprint = get_certificate_details()\n        print('Subject:', subject)\n        print('Validity dates:', dates)\n        print('SHA-256 fingerprint:', fingerprint)\n        # Extract Common Name and expiration date from dates\n        # The dates output is like:\n        # Validity: Dec 31 00:00:00 2025 GMT\n        # Validity: Jan 1 00:00:00 2026 GMT\n        # We'll parse and output Common Name and expiration date in YYYY-MM-DD\n        # We'll use OpenSSL to get the Common Name\n        cmd = ['openssl', 'x509', '-in', '/app/ssl/server.crt', '-get_name']\n        result = subprocess.run(cmd, capture_output=True, text=True)\n        if result.returncode == 0:\n            line = result.stdout.strip()\n            if line:\n                import re\n                match = re.search(r'CN=([^\\s]+)', line)\n                if match:\n                    common_name = match.group(1)\n                else:\n                    common_name = 'Unknown'\n        else:\n            common_name = 'Unknown'\n        \n        # Parse dates to get expiration date\n        cmd = ['openssl', 'x509', '-in', '/app/ssl/server.crt', '-get-expired']\n        result = subprocess.run(cmd, capture_output=True, text=True)\n        if result.returncode == 0:\n            expired = result.stdout.strip()\n            from datetime import datetime\n            try:\n                dt = datetime.strptime(expired, '%b %d %H:%M:%S %Y %Z')\n                expiration_date = dt.strftime('%Y-%m-%d')\n            except ValueError:\n                expiration_date = 'Unknown'\n        else:\n            expiration_date = 'Unknown'\n        \n        print(f'Common Name: {common_name}')\n        print(f'Expiration date: {expiration_date}')\n        print('Certificate verification successful')\n    except Exception as e:\n        print(f'Error loading certificate: {e}')\n        sys.exit(1)\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
