Sending keys: ['cat > chunk_and_distribute.py << \'EOF\'\nimport os\nimport sys\nimport json\nimport hashlib\n\n# Configuration\nC4_SAMPLE_DIR = \'/app/c4_sample\'\nC4_RESHARD_DIR = \'/app/c4_reshard\'\nCHUNK_SIZE = 1024 * 1024  # 1MB\nMAX_FILES_PER_FOLD = 30\n\n# Ensure c4_reshard exists\nos.makedirs(C4_RESHARD_DIR, exist_ok=True)\n\n# Mapping dictionary\nmapping = {}\n\n# Process each file in c4_sample\nfor root, dirs, files in os.walk(C4_SAMPLE_DIR):\n    for file in files:\n        file_path = os.path.join(root, file)\n        # Skip if file is a directory\n        if not os.path.isfile(file_path):\n            continue\n        \n        # Get relative path from C4_SAMPLE_DIR\n        rel_path = os.path.relpath(file_path, C4_SAMPLE_DIR)\n        \n        # Read the file\n        with open(file_path, \'rb\') as f:\n            data = f.read()\n        \n        # Split into chunks\n        chunks = []\n        for i in range(0, len(data), CHUNK_SIZE):\n            chunk = data[i:i+CHUNK_SIZE]\n            # Compute a unique identifier for the chunk\n            # Use MD5 hash of the chunk plus a counter\n            chunk_id = f"{rel_path}.chunks.{i//CHUNK_SIZE:03d}"\n            chunks.append((chunk, chunk_id))\n        \n        # Determine subdirectory index\n        chunk_group = (len(chunks) - 1) // MAX_FILES_PER_FOLD  # zero-indexed\n        sub_dir = os.path.join(C4_RESHARD_DIR, f\'chunk_{chunk_group+1:03d}\')\n        os.makedirs(sub_dir, exist_ok=True)\n        \n        # Write each chunk to its subdirectory\n        for chunk, chunk_id in chunks:\n            chunk_path = os.path.join(sub_dir, chunk_id)\n            with open(chunk_path, \'wb\') as f:\n                f.write(chunk)\n            # Record mapping\n            mapping.setdefault(rel_path, []).append(chunk_path)\n\n# Write mapping to a file\nmapping_path = os.path.join(C4_RESHARD_DIR, \'mapping.json\')\nwith open(mapping_path, \'w\') as f:\n    json.dump(mapping, f, indent=2)\n\nprint(f"Processed {len(mapping)} files.")\nprint(f"Created {len(mapping)} chunk subdirectories.")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
