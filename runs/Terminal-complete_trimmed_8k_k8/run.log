Sending keys: ["cat > compute_avg2.py << 'EOF'\nimport csv\nfrom datetime import datetime\n\ndef parse_date(date_str):\n    # Try MM/DD/YYYY HH:MM:SS\n    try:\n        dt = datetime.strptime(date_str, '%m/%d/%Y %H:%M:%S')\n        return dt.strftime('%Y-%m-%d')\n    except ValueError:\n        pass\n    # Try MM-DD-YYYY HH:MM:SS\n    try:\n        dt = datetime.strptime(date_str, '%m-%d-%Y %H:%M:%S')\n        return dt.strftime('%Y-%m-%d')\n    except ValueError:\n        pass\n    # If none, return original (should not happen)\n    return date_str\n\n# Read high temperatures (YYYY-MM-DD)\nhigh = {}\nwith open('daily_temp_sf_high.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        date_str = row['date']\n        temp = int(row['temperature'])\n        high[date_str] = temp\n\n# Read low temperatures\nlow = {}\nwith open('daily_temp_sf_low.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        parsed_date = parse_date(row['date'])\n        temp = int(row['temperature'])\n        low[parsed_date] = temp\n\n# Compute differences\ncommon_dates = set(high.keys()) & set(low.keys())\nif common_dates:\n    diffs = [high[d] - low[d] for d in common_dates]\n    avg = sum(diffs) / len(diffs)\nelse:\n    avg = 0\n\n# Write average to file\nwith open('avg_temp.txt', 'w') as f:\n    f.write(str(avg))\n\nprint('Average difference:', avg)\nprint('Common dates:', common_dates)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
