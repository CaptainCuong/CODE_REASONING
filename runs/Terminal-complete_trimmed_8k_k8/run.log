          wall_positions.add((w_row, w_col))\n            elif responses[i] == 'S':\n                start_pos = (row, col)\n                break\n        \n        # Explore neighbors\n        for d in ['N','E','S','W']:\n            new_row, new_col = row, col\n            if d == 'N':\n                new_row, new_col = row - 1, col\n            elif d == 'E':\n                new_row, new_col = row, col + 1\n            elif d == 'S':\n                new_row, new_col = row + 1, col\n            elif d == 'W':\n                new_row, new_col = row, col - 1\n            if (new_row, new_col) not in visited:\n                visited.add((new_row, new_col))\n                queue.append((new_row, new_col))\n    \n    # Determine min/max coordinates\n    min_row = min(pos[0] for pos in visited | wall_positions)\n    min_col = min(pos[1] for pos in visited | wall_positions)\n    max_row = max(pos[0] for pos in visited | wall_positions)\n    max_col = max(pos[1] for pos in visited | wall_positions)\n    \n    # Build grid\n    grid = []\n    for r in range(min_row, max_row + 1):\n        line = []\n        for c in range(min_col, max_col + 1):\n            cell = (r, c)\n            if cell in wall_positions:\n                line.append('#')\n            elif cell == start_pos:\n                line.append('S')\n            elif cell == exit_pos:\n                line.append('E')\n            else:\n                line.append(' ')\n        grid.append(''.join(line))\n    \n    return grid\n\nif __name__ == '__main__':\n    for maze_id in range(1, 11):\n        print(f'Exploring maze {maze_id}...')\n        grid = run_maze(maze_id)\n        if grid is None:\n            print('Failed to explore maze')\n            continue\n        output_path = f'/app/output/maze_{maze_id}.txt'\n        with open(output_path, 'w') as f:\n            for line in grid:\n                f.write(line + '\\n')\n        print(f'Maze {maze_id} saved to {output_path}')\nEOF\n"] min_timeo