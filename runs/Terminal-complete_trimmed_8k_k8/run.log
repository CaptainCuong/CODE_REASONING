Sending keys: ["cat > check_cert.py << 'EOF'\nimport ssl\nimport subprocess\nimport sys\n\ndef main():\n    # Check if certificate and key exist\n    try:\n        with open('/app/ssl/server.pem', 'rb') as f:\n            data = f.read()\n        # Load the PEM file\n        cert = ssl.load_pem_x509_certificate(data)\n        # Get subject\n        subject = cert.subject\n        # Get validity dates\n        valid_from = cert.not_valid_before\n        valid_to = cert.not_valid_after\n        # Get common name\n        cn = subject.get('commonName', 'unknown')\n        # Convert dates to string in YYYY-MM-DD\n        from datetime import datetime\n        from OpenSSL import SSL\n        # OpenSSL dates are in OpenSSL::SSL::SSL_DATE structure\n        # We can convert using datetime.fromtimestamp\n        # Actually, OpenSSL dates are in Unix timestamp.\n        # We'll use datetime.fromtimestamp\n        def date_to_str(d):\n            return datetime.fromtimestamp(d).strftime('%Y-%m-%d')\n        \n        print(f'Subject: {subject}')\n        print(f'Valid from: {date_to_str(valid_from)}')\n        print(f'Valid to: {date_to_str(valid_to)}')\n        print(f'Common Name: {cn}')\n        print('Certificate verification successful')\n    except Exception as e:\n        print(f'Error: {e}')\n        sys.exit(1)\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
