Sending keys: ['cat > fit_peaks_accurate.py << \'EOF\'\nimport json\nimport math\n\ndef load_data():\n    w = []\n    i = []\n    with open(\'graphene.dat\', \'r\') as f:\n        for line in f:\n            parts = line.strip().split(\',\')\n            if len(parts) < 3:\n                continue\n            w.append(float(parts[0]))\n            i.append(float(parts[2]))\n    return w, i\n\ndef find_peak_index(w, i, target_w):\n    idx = min(range(len(w)), key=lambda x: abs(w[x] - target_w))\n    return idx\n\ndef fit_peak(w, i, idx):\n    # take window around peak\n    window_size = 20\n    start = max(0, idx - window_size)\n    end = min(len(w), idx + window_size + 1)\n    w_sub = w[start:end]\n    i_sub = i[start:end]\n    # find index of max intensity in window\n    max_idx = i_sub.index(max(i_sub))\n    x0 = w_sub[max_idx]\n    i_max = i_sub[max_idx]\n    # compute variance of w_sub\n    variance = sum((x - x0) ** 2 for x in w_sub) / len(w_sub)\n    gamma = math.sqrt(variance)\n    # compute log of intensities\n    logi = [math.log(y) for y in i_sub]\n    # quadratic fit: logi = a*(x-x0)^2 + b*(x-x0) + c\n    # use least squares on transformed variable z = x - x0\n    z = [x - x0 for x in w_sub]\n    logz = logi\n    n = len(z)\n    # solve for coefficients a, b, c\n    # we know c = log(A) where A is amplitude.\n    # We\'ll fit using linear regression: logz = a*z^2 + b*z + c\n    # but we need to estimate a and b.\n    # Let\'s do a simple fit using three points symmetric around peak.\n    # Use central three points for simplicity.\n    # If window has at least 3 points, use them.\n    if n >= 3:\n        # central three points\n        idx1 = (n-1)//2\n        z1, z2, z3 = z[idx1-1], z[idx1], z[idx1+1]\n        log1, log2, log3 = logz[idx1-1], logz[idx1], logz[idx1+1]\n        # solve for a, b, c using three equations\n        # log1 = a*z1^2 + b*z1 + c\n        # log2 = a*z2^2 + b*z2 + c\n        # log3 = a*z3^2 + b*z3 + c\n        # subtract to eliminate c\n        eq1 = log1 - log2\n        eq2 = log1 - log3\n        eq3 = log2 - log3\n        a = (eq1 + eq2 + 2*eq3) / (2*(z1**2 - 2*z1*z2 + z2**2 + z1**2 - 2*z1*z3 + z3**2))\n        b = (2*(z2**2 - z1**2) + (eq1 - eq2)) / (2*(z1**2 - 2*z1*z2 + z2**2 + z1**2 - 2*z1*z3 + z3**2))\n        c = log1 - a*z1**2 - b*z1\n        # gamma from variance\n        gamma = math.sqrt(variance)\n        # amplitude = exp(c)\n        amplitude = math.exp(c)\n        # offset = i_max - amplitude\n        offset = i_max - amplitude\n    else:\n        # fallback to previous method\n        offset = 0.0\n        amplitude = i_max - offset\n    return x0, gamma, amplitude, offset\n\ndef main():\n    w, i = load_data()\n    idx_g = find_peak_index(w, i, 1648)  # use actual peak location\n    idx_2d = find_peak_index(w, i, 2700)\n    print(\'G peak index:\', idx_g, \'w=\', w[idx_g], \'i=\', i[idx_g])\n    print(\'2D peak index:\', idx_2d, \'w=\', w[idx_2d], \'i=\', i[idx_2d])\n    params_g = fit_peak(w, i, idx_g)\n    params_2d = fit_peak(w, i, idx_2d)\n    results = {\n        "G": {},\n        "2D": {}\n    }\n    if params_g:\n        x0, gamma, amp, offset = params_g\n        results["G"]["x0"] = x0\n        results["G"]["gamma"] = gamma\n        results["G"]["amplitude"] = amp\n        results["G"]["offset"] = offset\n    else:\n        results["G"]["x0"] = 0.0\n        results["G"]["gamma"] = 0.0\n        results["G"]["amplitude"] = 0.0\n        results["G"]["offset"] = 0.0\n    if params_2d:\n        x0, gamma, amp, offset = params_2d\n        results["2D"]["x0"] = x0\n        results["2D"]["gamma"] = gamma\n        results["2D"]["amplitude"] = amp\n        results["2D"]["offset"] = offset\n    else:\n        results["2D"]["x0"] = 0.0\n        results["2D"]["gamma"] = 0.0\n        results["2D"]["amplitude"] = 0.0\n        results["2D"]["offset"] = 0.0\n    with open(\'results.json\', \'w\') as f:\n        json.dump(results, f, indent=2)\n    print(\'Results written to results.js