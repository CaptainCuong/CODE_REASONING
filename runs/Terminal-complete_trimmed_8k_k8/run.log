Sending keys: ["cat > process.py << 'EOF'\nimport csv\nimport json\nfrom datetime import datetime\nfrom collections import defaultdict\n\n# Read departments\ndepts = []\nwith open('data/departments.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        dept_id = row['id']\n        dept_name = row['name']\n        budget = float(row['budget'])\n        depts.append({\n            'id': dept_id,\n            'name': dept_name,\n            'budget': budget,\n            'employees': [],\n            'projects': []\n        })\n\n# Read employees\nemployees_by_dept = defaultdict(list)\nwith open('data/employees.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        emp_id = row['id']\n        emp_name = row['name']\n        position = row['position']\n        skills = row['skills'].split(';')\n        years = int(row['years_of_service'])\n        dept_id = row['department_id']\n        employees_by_dept[dept_id].append({\n            'id': emp_id,\n            'name': emp_name,\n            'position': position,\n            'skills': skills,\n            'years_of_service': years\n        })\n\n# Read projects\nprojects_by_dept = defaultdict(list)\nwith open('data/projects.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        project_name = row['name']\n        status = row['status']\n        member_ids = row['member_ids'].split(';')\n        deadline = row['deadline']\n        dept_id = row['department_id']\n        projects_by_dept[dept_id].append({\n            'name': project_name,\n            'status': status,\n            'members': member_ids,\n            'deadline': deadline\n        })\n\n# Assign employees and projects to departments\nfor dept in depts:\n    dept['employees'] = employees_by_dept.get(dept['id'], [])\n    dept['projects'] = projects_by_dept.get(dept['id'], [])\n\n# Compute statistics\nall_employees = []\nall_skills = []\ndept_sizes = defaultdict(int)\nproject_status_counts = defaultdict(int)\nfor dept in depts:\n    for emp in dept['employees']:\n        all_employees.append(emp)\n        all_skills.extend(emp['skills'])\n        dept_sizes[dept['id']] = len(dept['employees'])\n    for proj in dept['projects']:\n        project_status_counts[proj['status']] += 1\n\n# Skill distribution\nskill_dist = defaultdict(int)\nfor skill in all_skills:\n    skill_dist[skill] += 1\n\n# Department budgets\ndept_budgets = [dept['budget'] for dept in depts]\navg_dept_budget = sum(dept_budgets) / len(dept_budgets) if dept_budgets else 0\n\n# Average years of service\nif all_employees:\n    avg_years = sum(emp['years_of_service'] for emp in all_employees) / len(all_employees)\nelse:\n    avg_years = 0\n\n# Build organization object\norg = {\n    'name': 'Organization',  # placeholder, maybe from data? Not provided, use generic\n    'founded': '2024-01-01',  # placeholder\n    'departments': depts\n}\n\n# Metadata\nmetadata = {\n    'version': '1.0',\n    'timestamp': datetime.utcnow().isoformat() + 'Z',\n    'generator': 'CSV to JSON Processor'\n}\n\n# Statistics\nstats = {\n    'averageDepartmentBudget': avg_dept_budget,\n    'totalEmployees': len(all_employees),\n    'skillDistribution': dict(skill_dist),\n    'departmentSizes': dict(dept_sizes),\n    'projectStatusDistribution': dict(project_status_counts),\n    'averageYearsOfService': avg_years\n}\n\n# Final output\noutput = {\n    'metadata': metadata,\n    'organization': org,\n    'statistics': stats\n}\n\n# Write to file\nwith open('organization.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint('organization.json created')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
