r* argv[]) {\n    if (argc != 3) {\n        printf("Usage: %s weights.json image.png\\n", argv[0]);\n        exit(1);\n    }\n    tensor_t weights = load_weights(argv[1]);\n    tensor_t x = load_image(argv[2]);\n    tensor_t out = inference(x, weights);\n    \n    // Find max probability\n    int predicted = 0;\n    double max_val = -1.0;\n    for (int i = 0; i < NUM_CLASSES; i++) {\n        if (out.data[i] > max_val) {\n            max_val = out.data[i];\n            predicted = i;\n        }\n    }\n    \n    // Output only the digit\n    printf("%d", predicted);\n    \n    // Write prediction.txt\n    FILE* f = fopen("prediction.txt", "w");\n    fprintf(f, "%d", predicted);\n    fclose(f);\n    \n    // Cleanup\n    tensor_free(weights);\n    tensor_free(x);\n    tensor_free(out);\n    \n    return 0;\n}\n\n// Simple tensor structure\ntypedef struct {\n    int dim;          // number of dimensions\n    int size;         // number of elements in last dimension\n    double* data;\n} tensor_t;\n\n// Create tensor with given size\ntensor_t tensor_create(int size) {\n    tensor_t t = malloc(sizeof(struct tensor_s));\n    t->dim = 1;\n    t->size = size;\n    t->data = malloc(size * sizeof(double));\n    return t;\n}\n\n// Free tensor\nvoid tensor_free(tensor_t t) {\n    free(t->data);\n    free(t);\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
