Sending keys: ['cat > cli_tool.c << \'EOF\'\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <math.h>\n#include "cJSON.h"\n#include "lodepng.h"\n\n// Model parameters\n#define INPUT_DIM 784\n#define HIDDEN_DIM 16\n#define OUTPUT_DIM 10\n\n// Activation function\nfloat relu(float x) {\n    return (x > 0) ? x : 0.0f;\n}\n\n// Linear layer\nvoid linear(float* input, float* output, float* weights, float* bias, int input_size, int output_size) {\n    for (int i = 0; i < output_size; i++) {\n        output[i] = 0.0f;\n        for (int j = 0; j < input_size; j++) {\n            output[i] += input[j] * weights[i * input_size + j];\n        }\n        output[i] += bias[i];\n    }\n}\n\n// ReLU activation\nvoid apply_relu(float* data, int size) {\n    for (int i = 0; i < size; i++) {\n        if (data[i] < 0.0f) {\n            data[i] = 0.0f;\n        }\n    }\n}\n\n// Load weights from JSON\nvoid load_weights(float* weights, float* bias, char* filename) {\n    FILE* f = fopen(filename, "r");\n    if (!f) {\n        printf("Error: Could not open weights file\\n");\n        exit(1);\n    }\n    char buffer[1024];\n    fgets(buffer, sizeof(buffer), f);\n    fclose(f);\n    // Parse JSON\n    cJSON* root = cJSON_Parse(buffer);\n    if (!root) {\n        printf("Error: Invalid JSON\\n");\n        exit(1);\n    }\n    // Flatten weights: input->hidden, hidden->hidden, hidden->output\n    int w_idx = 0;\n    for (int layer = 0; layer < 3; layer++) {\n        int in_size = (layer == 0) ? INPUT_DIM : HIDDEN_DIM;\n        int out_size = (layer == 2) ? OUTPUT_DIM : HIDDEN_DIM;\n        if (layer == 0) {\n            // input->hidden\n            for (int i = 0; i < out_size; i++) {\n                for (int j = 0; j < in_size; j++) {\n                    weights[w_idx] = root->child->child->value.number;\n                    w_idx++;\n                }\n            }\n            // bias hidden\n            for (int i = 0; i < out_size; i++) {\n                bias[w_idx] = root->child->child->value.number;\n                w_idx++;\n            }\n        } else if (layer == 1) {\n            // hidden->hidden\n            for (int i = 0; i < out_size; i++) {\n                for (int j = 0; j < in_size; j++) {\n                    weights[w_idx] = root->child->value.number;\n                    w_idx++;\n                }\n            }\n            // bias hidden\n            for (int i = 0; i < out_size; i++) {\n                bias[w_idx] = root->child->value.number;\n                w_idx++;\n            }\n        } else {\n            // hidden->output\n            for (int i = 0; i < out_size; i++) {\n                for (int j = 0; j < in_size; j++) {\n                    weights[w_idx] = root->value.number;\n                    w_idx++;\n                }\n            }\n            // bias output\n            for (int i = 0; i < out_size; i++) {\n                bias[w_idx] = root->value.number;\n                w_idx++;\n            }\n        }\n    }\n}\n\n// Load image and convert to grayscale pixel array\nvoid load_image(const char* filename, unsigned char** image, int* width, int* height) {\n    FILE* f = fopen(filename, "rb");\n    if (!f) {\n        printf("Error: Could not open image file\\n");\n        exit(1);\n    }\n    lodepng_decode_file(*image, width, height, filename, 0, 0);\n    fclose(f);\n}\n\n// Convert image to 28x28 grayscale vector\nvoid image_to_vector(float* vec, unsigned char* image, int width, int height) {\n    for (int y = 0; y < height; y++) {\n        for (int x = 0; x < width; x++) {\n            vec[y * width + x] = (float)image[y * width + x] / 255.0f;\n        }\n    }\n}\n\n// Inference\nint predict(float* weights, float* bias, float* input_vec) {\n    float hidden[INPUT_DIM];\n    float hidden_bias[HIDDEN_DIM];\n    float output[OUTPUT_DIM];\n    float output_bias[OUTPUT_DIM];\n    // weights: idx 0..(INPUT_DIM*HIDDEN_DIM-1) -> input->hidden\n    // idx INPUT_DIM*HIDDEN_DIM..(INPUT_DIM*HIDDEN_DIM+HIDDEN_DIM-1) -> hidden->hidden\n    // idx INPUT_DIM*HIDDEN_DIM+HIDDEN_DIM..(INPUT_DIM*HIDDEN_DIM+2*HIDDEN_DIM-1) -> hidden->output\n    // bias: idx 0..(HIDDEN_DIM-1) -> hidden bias\n    // idx HIDDEN_DIM..(2*HIDDEN_DIM-1) -> output bias\n    int w_idx = 0;\n    int b_idx = 0;\n    // input->hidden\n    linear(input_vec, hidden, weights + w_idx, bias + b_idx, INPUT_DIM, HIDDEN_DIM);\n    apply_relu(hidden, HIDDEN_DIM);\n    w_idx += INPUT_DIM * HIDDEN_DIM;\n    b_idx += HIDDEN_DIM;\n    // hidden->hidden\n    linear(hidden, hidden, weights + w_idx, bias + b_idx, HIDDEN_DIM, HIDDEN_DIM);\n    apply_relu(hidden, HIDDEN_DIM);\n    w_idx += HIDDEN_DIM * HIDDEN_DIM;\n    b_idx += HIDDEN_DIM;\n    // hidden->output\n    linear(hidden, output, weights + w_idx, bias + b_idx, HIDDEN_DIM, OUTPUT_DIM);\n    // No activation after output\n    int max_idx = 0;\n    float max_val = output[0];\n    for (int i = 1; i < OUTPUT_DIM; i++) {\n        if (output[i] > max_val) {\n            max_val = output[i];\n            max_idx = i;\n        }\n    }\n    return max_idx;\n}\n\nint main(int argc, char* argv[]) {\n    if (argc != 3) {\n        printf("Usage: %s weights.json image.png\\n", argv[0]);\n        return 1;\n    }\n    char* weights_file = argv[1];\n    char* image_file = argv[2];\n    // Load weights\n    float* weights = malloc((INPUT_DIM * HIDDEN_DIM + HIDDEN_DIM * HIDDEN_DIM + HIDDEN_DIM * OUTPUT_DIM) * sizeof(float));\n    float* bias = malloc((HIDDEN_DIM + OUTPUT_DIM) * sizeof(float));\n    load_weights(weights, bias, weights_file);\n    // Load image\n    int width, height;\n    unsigned char* image = NULL;\n    load_image(image_file, &image, &width, &height);\n    // Check dimensions\n    if (width != 28 || height != 28) {\n        printf("Error: Image dimensions must be 28x28\\n");\n        free(weights);\n        free(bias);\n        free(image);\n        return 1;\n    }\n    // Convert to vector\n    float* vec = malloc(INPUT_DIM * sizeof(float));\n    image_to_vector(vec, image, width, height);\n    // Predict\n    int prediction = predict(weights, bias, vec);\n    // Write prediction to file\n    FILE* out = fopen("prediction.txt", "w");\n    fprintf(out, "%d", prediction);\n    fclose(out);\n    free(weights);\n    free(bias);\n    free(image);\n    free(vec);\n    return 0;\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
