Sending keys: ["cat > /app/check_cert.py << 'EOF'\nimport ssl\nimport subprocess\nimport sys\n\ndef verify_certificate():\n    cert_path = '/app/ssl/server.crt'\n    key_path = '/app/ssl/server.key'\n    \n    # Check if files exist\n    try:\n        with open(cert_path, 'r') as f:\n            cert_data = f.read()\n    except FileNotFoundError:\n        print(f'ERROR: Certificate file not found: {cert_path}')\n        sys.exit(1)\n    \n    try:\n        with open(key_path, 'r') as f:\n            key_data = f.read()\n    except FileNotFoundError:\n        print(f'ERROR: Private key file not found: {key_path}')\n        sys.exit(1)\n    \n    # Create a simple SSL context to load the certificate\n    context = ssl.SSLContext(ssl.PROTOCOL_TLSv1_2)\n    context.load_cert_chain(cert_path, key_path)\n    \n    # Get the subject\n    subject = context.get_subject()\n    common_name = subject.get('CN')\n    print(f'Common Name: {common_name}')\n    \n    # Get the certificate's validity date\n    cert = context.get_certificate()\n    not_before = cert.get_not_before().decode('utf-8')\n    not_after = cert.get_not_after().decode('utf-8')\n    print(f'Not Before: {not_before}')\n    print(f'Not After: {not_after}')\n    \n    # Convert dates to YYYY-MM-DD format\n    # OpenSSL dates are in 'YYYY-MM-DD HH:MM:SS' format\n    # We'll take the date part only\n    not_before_date = not_before.split()[0]\n    not_after_date = not_after.split()[0]\n    print(f'Expiration Date: {not_after_date}')\n    \n    # Verify that the certificate is valid (not expired)\n    from datetime import datetime\n    now = datetime.now()\n    cert_not_before = datetime.strptime(not_before, '%Y-%m-%d %H:%M:%S')\n    cert_not_after = datetime.strptime(not_after, '%Y-%m-%d %H:%M:%S')\n    if cert_not_before <= now <= cert_not_after:\n        print('Certificate verification successful')\n    else:\n        print('ERROR: Certificate is expired or not valid')\n        sys.exit(1)\n\nif __name__ == '__mai