Sending keys: ["cat > process_csv.py << 'EOF'\nimport csv\nimport json\nfrom datetime import datetime, timezone\nimport os\n\n# Read departments\ndepartments = []\nwith open('data/departments.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        departments.append(row)\n\n# Read employees\nemployees = []\nwith open('data/employees.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        # Split skills string into list\n        skills = row['skills'].split(';') if row['skills'] else []\n        employees.append({\n            'id': row['id'],\n            'name': row['name'],\n            'position': row['position'],\n            'skills': skills,\n            'years_of_service': int(row['years_of_service']),\n            'department_id': row['department_id']\n        })\n\n# Read projects\nprojects = []\nwith open('data/projects.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        members = row['member_ids'].split(';') if row['member_ids'] else []\n        projects.append({\n            'name': row['name'],\n            'status': row['status'],\n            'members': members,\n            'deadline': row['deadline'],\n            'department_id': row['department_id']\n        })\n\n# Build organization structure\n# First create department objects with employees and projects\norg_departments = []\nfor dept in departments:\n    dept_id = dept['id']\n    dept_employees = [e for e in employees if e['department_id'] == dept_id]\n    dept_projects = [p for p in projects if p['department_id'] == dept_id]\n    org_departments.append({\n        'id': dept_id,\n        'name': dept['name'],\n        'budget': float(dept['budget']),\n        'employees': dept_employees,\n        'projects': dept_projects\n    })\n\n# Statistics\n# averageDepartmentBudget\nbudgets = [d['budget'] for d in org_departments]\naverage_department_budget = sum(budgets) / len(budgets) if budgets else 0\n\n# totalEmployees\ntotal_employees = len(employees)\n\n# skillDistribution: count of employees per skill across all employees\nskill_counts = {}\nfor emp in employees:\n    for skill in emp['skills']:\n        skill_counts[skill] = skill_counts.get(skill, 0) + 1\n\n# departmentSizes: count of employees per department\ndept_sizes = {}\nfor emp in employees:\n    dept = emp['department_id']\n    dept_sizes[dept] = dept_sizes.get(dept, 0) + 1\n\n# projectStatusDistribution\nstatus_counts = {}\nfor proj in projects:\n    status = proj['status']\n    status_counts[status] = status_counts.get(status, 0) + 1\n\n# averageYearsOfService\navg_years = sum(e['years_of_service'] for e in employees) / total_employees if total_employees else 0\n\n# Metadata\nmetadata = {\n    'version': '1.0',\n    'timestamp': datetime.now(timezone.utc).isoformat(),\n    'generator': 'csv_to_json'\n}\n\n# Organization\norganization = {\n    'name': 'Example Organization',  # placeholder, could be derived from data? We'll keep generic.\n    'founded': '2000-01-01',  # placeholder\n    'departments': org_departments\n}\n\n# Statistics\nstatistics = {\n    'averageDepartmentBudget': average_department_budget,\n    'totalEmployees': total_employees,\n    'skillDistribution': skill_counts,\n    'departmentSizes': dept_sizes,\n    'projectStatusDistribution': status_counts,\n    'averageYearsOfService': avg_years\n}\n\n# Final output\noutput = {\n    'metadata': metadata,\n    'organization': organization,\n    'statistics': statistics\n}\n\n# Write to organization.json\nwith open('organization.json', 'w') as f:\n    json.dump(output, f, indent=2)\n\nprint('organization.json created successfully')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
