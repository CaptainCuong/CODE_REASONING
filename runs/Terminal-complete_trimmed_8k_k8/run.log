Sending keys: ["cat > extract_and_save_final.py << 'EOF'\nimport sys\nimport os\nimport tempfile\nimport subprocess\nfrom transformers import AlbertModel, AlbertTokenizer\n\n# Find the tar.gz file\ntar_path = None\nfor root, dirs, files in os.walk('/app/cache'):\n    for f in files:\n        if f.endswith('.tar.gz'):\n            tar_path = os.path.join(root, f)\n            break\n    if tar_path:\n        break\n\nif tar_path is None:\n    print('No tar.gz found')\n    sys.exit(1)\n\nprint('Tar.gz path:', tar_path)\n\n# Extract the tar.gz to a temporary location\nwith tempfile.TemporaryDirectory() as tmpdir:\n    subprocess.run(['tar', '-xzf', tar_path, '-C', tmpdir], check=True)\n    print('Extracted to', tmpdir)\n    # Now locate the extracted model files\n    # The tar.gz contains directories like 'models', 'config.json', 'tokenizers'\n    # Let's find the pytorch_model.bin\n    for root, dirs, files in os.walk(tmpdir):\n        for f in files:\n            if f.endswith('.bin'):\n                model_path = os.path.join(root, f)\n                print('Found model:', model_path)\n                break\n        else:\n            continue\n        break\n    if not model_path:\n        for root, dirs, files in os.walk(tmpdir):\n            for f in files:\n                if f.endswith('.pt'):\n                    model_path = os.path.join(root, f)\n                    print('Found model:', model_path)\n                    break\n            else:\n                continue\n            break\n\nif not model_path:\n    print('Could not find model files')\n    sys.exit(1)\n\n# Load model and tokenizer from the extracted directory\n# The model is saved in the tar_path as a tarball, but we can also load from the extracted directory.\n# Let's load from the extracted directory to be safe.\n# We need to find the tokenizer as well.\n# The tokenizer is in the tar.gz in a directory named 'tokenizers'.\n# Let's find the tokenizer file.\nfor root, dirs, files in os.walk(tmpdir):\n    for f in files:\n        if f.endswith('.txt'):\n            tokenizer_path = os.path.join(root, f)\n            print('Found tokenizer:', tokenizer_path)\n            break\n    else:\n        continue\n    break\n\nif not tokenizer_path:\n    print('Could not find tokenizer file')\n    sys.exit(1)\n\n# Now load the model and tokenizer\nmodel = AlbertModel.from_pretrained(model_path)\ntokenizer = AlbertTokenizer.from_pretrained(tokenizer_path)\n\n# Save to /app/cache\nmodel.save_pretrained('/app/cache')\ntokenizer.save_pretrained('/app/cache')\nprint('Saved to /app/cache')\n\n# Verify\nimport glob\nfor f in glob.glob('/app/cache/*.bin'):\n    print('Saved model:', f)\nfor f in glob.glob('/app/cache/*.txt'):\n    print('Saved tokenizer config:', f)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
