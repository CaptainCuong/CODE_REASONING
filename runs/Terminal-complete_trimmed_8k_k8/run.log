xception as e:\n        return json.dumps({'error': str(e)})\n\n# /transaction/<signature>\n@app.route('/transaction/<signature>')\ndef transaction_details(signature):\n    try:\n        transaction = Transaction.from_signature(signature)\n        tx_data = transaction.to_dict()\n        # Convert some fields\n        tx_data['signature'] = transaction.signature\n        tx_data['slot'] = transaction.slot\n        tx_data['block_time'] = transaction.timestamp\n        tx_data['success'] = transaction.is_success\n        tx_data['fee'] = transaction.fee\n        # Token transfers\n        token_transfers = []\n        for transfer in transaction.token_transfers:\n            token_transfers.append({\n                'account': transfer.account.to_string(),\n                'mint': transfer.mint.to_string(),\n                'amount': str(transfer.amount)\n            })\n        tx_data['token_transfers'] = token_transfers\n        return json.dumps(tx_data)\n    except Exception as e:\n        return json.dumps({'error': str(e)})\n\n# /account/<address>\n@app.route('/account/<address>')\ndef account_details(address):\n    try:\n        account = Account(address)\n        account_data = account.to_dict()\n        return json.dumps(account_data)\n    except Exception as e:\n        return json.dumps({'error': str(e)})\n\n# /program/<program_id>/accounts\n@app.route('/program/<program_id>/accounts')\ndef program_accounts(program_id, limit=10, offset=0):\n    try:\n        program = Program(program_id)\n        accounts = program.get_accounts(limit, offset)\n        result = {\n            'program_id': program_id,\n            'total_accounts': len(accounts),\n            'limit': limit,\n            'offset': offset,\n            'accounts': []\n        }\n        for account in accounts:\n            account_info = account.to_dict()\n            result['accounts'].append(account_info)\n        return json.dumps(result)\n    except Exception as e:\n        return json.dumps({'error': str(e)})\n\nif __name__ == '__main__':\n    app.run(port=5000, debug=True)\nEOF\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
