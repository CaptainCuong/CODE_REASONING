Sending keys: ['cat > bitcoin_service.py << \'EOF\'\n#!/usr/bin/env python3\n"""\n Bitcoin Service API\n"""\nimport json\nimport sys\nfrom flask import Flask, request, abort\nfrom bitcoinlib import BitcoinRPCClient\nfrom bitcoinlib.exceptions import JSONRPCError\n\ndef connect_to Bitcoin RPC server():\n    """Connect to local Bitcoin Core RPC server."""\n    # Default port for RPC is 8332\n    client = BitcoinRPCClient(\'localhost\', port=8332)\n    return client\n\ndef main():\n    app = Flask(__name__)\n    try:\n        client = connect_to Bitcoin RPC server()\n    except Exception as e:\n        client = None\n    \n    @app.route(\'/status\', methods=[\'GET\'])\n    def status():\n        if client is None:\n            return {\'error\': \'Not connected to Bitcoin network\'}, 503\n        try:\n            result = client.get(\'getnetworkinfo\')\n            return {\'status\': \'online\'}\n        except JSONRPCError as e:\n            return {\'error\': str(e)}, 503\n    \n    @app.route(\'/block/<block_hash>\', methods=[\'GET\'])\n    def get_block(block_hash):\n        if client is None:\n            return {\'error\': \'Not connected to Bitcoin network\'}, 503\n        try:\n            result = client.get(\'getblock\', block_hash)\n            # Build block response\n            block = {\n                \'hash\': block_hash,\n                \'height\': result[\'height\'],\n                \'merkleroot\': result[\'merkleroot\'],\n                \'time\': result[\'time\'],\n                \'nonce\': result[\'nonce\'],\n                \'tx\': result[\'txids\']\n            }\n            return block\n        except JSONRPCError as e:\n            if \'Block not found\' in str(e):\n                return {\'error\': \'Block not found\'}, 404\n            return {\'error\': str(e)}, 503\n    \n    @app.route(\'/transaction/<txid>\', methods=[\'GET\'])\n    def get_transaction(txid):\n        if client is None:\n            return {\'error\': \'Not connected to Bitcoin network\'}, 503\n        try:\n            result = client.get(\'getrawtransaction\', txid)\n            # Parse raw transaction\n            tx = {\n                \'txid\': txid,\n                \'blockhash\': result.get(\'blockhash\', \'\'),\n                \'vin\': [],\n                \'vout\': []\n            }\n            for vin in result[\'vin\']:\n                vin_obj = {\n                    \'coinbase\': vin.get(\'coinbase\', \'\'),\n                    \'sequence\': vin[\'sequence\']\n                }\n                tx[\'vin\'].append(vin_obj)\n            for vout in result[\'vout\']:\n                vout_obj = {\n                    \'value\': vout[\'value\'],\n                    \'n\': vout[\'n\'],\n                    \'scriptPubKey\': {\n                        \'asm\': vout[\'scriptPubKey\'][\'asm\'],\n                        \'hex\': vout[\'scriptPubKey\'][\'hex\'],\n                        \'type\': vout[\'scriptPubKey\'][\'type\']\n                    }\n                }\n                tx[\'vout\'].append(vout_obj)\n            return tx\n        except JSONRPCError as e:\n            if \'Transaction not found\' in str(e):\n                return {\'error\': \'Transaction not found\'}, 404\n            return {\'error\': str(e)}, 503\n    \n    if __name__ == \'__main__\':\n        app.run(host=\'0.0.0.0\', port=5000, debug=True)\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
