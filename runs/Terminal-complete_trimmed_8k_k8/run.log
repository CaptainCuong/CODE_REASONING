Sending keys: ['cat > extract_weights.py << \'EOF\'\nimport pickle\nimport json\nimport struct\n\ndef load_p0(data):\n    """Simple loader for pickle protocol 0 that treats bytes as latin-1."""\n    # We\'ll assume the file is a dict with keys like \'input_layer.weight\'.\n    # We\'ll manually extract the values by scanning for patterns.\n    # This is a hack; but given the small size, we can search for the keys.\n    # We\'ll read the data as latin-1 and look for the keys.\n    text = data.decode(\'latin-1\')\n    # Look for the keys\n    keys = []\n    for key in [\'input_layer.weight\', \'input_layer.bias\', \'hidden_layer.weight\', \'hidden_layer.bias\',\n                \'output_layer.weight\', \'output_layer.bias\']:\n        if key in text:\n            keys.append(key)\n    # Extract values after each key\n    weights = {}\n    for key in keys:\n        # Find the position of the key\n        pos = text.find(key)\n        if pos == -1:\n            continue\n        # Find the next key or end of string\n        next_pos = text.find(next(key, pos+1))\n        if next_pos == -1:\n            next_pos = len(text)\n        # The value is a string that looks like a list of numbers.\n        # We\'ll assume the value is after the key and a space.\n        value_part = text[pos + len(key): next_pos]\n        # Convert to list of floats\n        parts = value_part.split()\n        if parts:\n            # Convert to float\n            values = [float(p) for p in parts]\n            weights[key] = values\n    # Also extract metadata\n    # We\'ll also extract the model class and other info, but we can hardcode the dimensions.\n    # We\'ll assume input_dim=28, hidden_dim=50, num_classes=10.\n    weights[\'input_dim\'] = 28\n    weights[\'hidden_dim\'] = 50\n    weights[\'num_classes\'] = 10\n    return weights\n\nwith open(\'model.pth\', \'rb\') as f:\n    data = f.read()\n\nweights = load_p0(data)\nprint(\'Weights:\', weights)\n\n# Write to weights.json\nwith open(