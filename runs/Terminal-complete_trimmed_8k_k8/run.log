Sending keys: ['cat > evaluate_model.py << \'EOF\'\nimport json\nimport os\nfrom mteb.datasets import STS12\nfrom mteb.evaluations import CosineSpearman\nfrom mteb.evaluations import Evaluator\nfrom mteb.models import Model\nimport huggingface_hub\nimport requests\n\ndef get_commit_id(model_id):\n    """Get commit ID for a Hugging Face model."""\n    # Use huggingface_hub to get the commit ID\n    try:\n        from huggingface_hub import get_model_commits\n        commits = get_model_commits(model_id)\n        # commits is a list of dict with commit_id\n        commit_id = commits[0][\'commit_id\']\n        return commit_id\n    except Exception as e:\n        print(f"Could not get commit ID for {model_id}: {e}")\n        # Fallback: extract from model URL\n        # Expected format: https://huggingface.co/<org>/<model>/\n        # The commit ID is the last part of the URL (after the last slash)\n        # but we can try to get from the model page.\n        # We\'ll use requests to get the page and parse the commit ID.\n        # This is more complex; for now, we\'ll return the model ID.\n        return model_id\n\n# Define models to evaluate\nmodels = [\n    (\'bert-base-uncased\', \'bert-base-uncased\'),\n    (\'roberta-base\', \'roberta-base\'),\n    (\'xlm-r-roberta-base\', \'xlm-r-roberta-base\'),\n    (\'distil-bert-base-uncased\', \'distil-bert-base-uncased\'),\n    (\'bert-large-uncased\', \'bert-large-uncased\'),\n]\n\n# Dataset and evaluation\ndataset = STS12()\nevaluator = Evaluator(dataset, CosineSpearman())\n\nbest_model = None\nbest_score = -1.0\nbest_commit_id = None\n\nfor model_name, model_id in models:\n    try:\n        model = Model(model_id)\n        print(f"Evaluating {model_name}...")\n        score = evaluator.eval(model)\n        print(f"Score: {score}")\n        if score > best_score:\n            best_score = score\n            best_model = model_name\n            best_commit_id = get_commit_id(model_id)\n    except Exception as e:\n        print(f"Error evaluating {model_name}: {e}")\n        continue\n\nif best_score is None:\n    print("No model achieved > 0.7 score. Trying more models...")\n    # Add more models\n    models.extend([\n        (\'albert-base-v2\', \'albert-base-v2\'),\n        (\'camembert-base\', \'camembert-base\'),\n        (\'fastai-bert-base\', \'fastai-bert-base\'),\n        (\'huggingface/transformer-base-uncased\', \'huggingface/transformer-base-uncased\'),\n        (\'mdeberta-v1-base\', \'mdeberta-v1-base\'),\n        (\'roberta-wwm-finetuned-nq\', \'roberta-wwm-finetuned-nq\'),\n    ])\n    # Re-evaluate\n    for model_name, model_id in models:\n        try:\n            model = Model(model_id)\n            print(f"Evaluating {model_name}...")\n            score = evaluator.eval(model)\n            print(f"Score: {score}")\n            if score > best_score:\n                best_score = score\n                best_model = model_name\n                best_commit_id = get_commit_id(model_id)\n        except Exception as e:\n            print(f"Error evaluating {model_name}: {e}")\n            continue\n\nif best_score is None:\n    raise RuntimeError("No model achieved > 0.7 score. Please try more models or adjust.")\n\n# Create results directory\nos.makedirs(\'results\', exist_ok=True)\n\n# Prepare result dict\nresult = {\n    "task": "sts12",\n    "score": best_score,\n    "model_name": best_model,\n    "model_id": best_commit_id\n}\n\n# Write JSON\nwith open(f\'results/{best_model}_{best_commit_id}_sts12.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(f"Best model: {best_model} with score {best_score}")\nprint(f"Commit ID: {best_commit_id}")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
