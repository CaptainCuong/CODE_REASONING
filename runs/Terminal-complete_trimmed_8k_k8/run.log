 idx, label in enumerate(train_df['label'].unique()):\n    label_to_int[label] = idx\n    int_to_label[idx] = label\nprint(f'Number of labels: {len(label_to_int)}')\n\n# Convert to fasttext format: each line: <label_index> <word> <word> ...\ntrain_lines = []\nfor tokens, label in zip(train_tokens, train_df['label']):\n    line = str(label_to_int[label]) + ' ' + ' '.join(tokens)\n    train_lines.append(line)\n\ntest_lines = []\nfor tokens, label in zip(test_tokens, test_df['label']):\n    line = str(label_to_int[label]) + ' ' + ' '.join(tokens)\n    test_lines.append(line)\n\n# Train model\nmodel = fasttext.SentenceSkipGram()\nmodel.set_word_count(10)\nmodel.set_negative_sample(5)\nmodel.set_learning_rate(0.1)\nmodel.set_loss('crossEntropy')\n# Set epochs to 10 to avoid overfitting\nmodel.set_epoch(10)\nmodel.train(train_lines)\n\n# Evaluate on test set\ntest_accuracy = 0\nfor line in test_lines:\n    parts = line.split()\n    label = parts[0]\n    tokens = parts[1:]\n    pred = model.predict(tokens)\n    if pred[0] == int(label):\n        test_accuracy += 1\n\nprint(f'Test accuracy: {test_accuracy/len(test_lines):.2f}')\n\n# Save model\nmodel.save_model('model.bin')\nprint('Model saved to model.bin')\n\n# Check model size\nimport os\nsize = os.path.getsize('model.bin')\nprint(f'Model size: {size} bytes ({size/1024/1024:.2f} MB)')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
