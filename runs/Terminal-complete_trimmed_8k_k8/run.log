Sending keys: ["cat > download_trim.py << 'EOF'\nimport subprocess\nimport sys\nimport os\nimport tempfile\nfrom pathlib import Path\n\n# Use a temporary directory to avoid leaving files\nwith tempfile.TemporaryDirectory() as tmpdir:\n    tmpdir_path = Path(tmpdir)\n    video_path = tmpdir_path / 'video.mp4'\n    result_path = tmpdir_path / 'result.mp4'\n    \n    # Download the first video ever uploaded to YouTube\n    # We'll use the known video ID 'me_at_the_zoo' (first video uploaded)\n    import youtube_dl\n    ydl_opts = {\n        'format': 'mp4',\n        'output_path': str(video_path),\n        'postprocessor': {\n            'key': 'subprocess',\n            'cmd': ['ffmpeg', '-i', video_path, '-c', 'copy', '-ss', '0', '-t', '10', str(result_path)],\n            'when': 'post',\n        },\n    }\n    with youtube_dl.YoutubeDL(ydl_opts) as ydl:\n        info = ydl.extract_info('https://www.youtube.com/watch?v=me_at_the_zoo', download=True)\n    \n    # The postprocessor should have created result_path\n    # If not, we can trim with subprocess\n    if not result_path.exists():\n        # Trim the video to the last 10 seconds using ffmpeg\n        # Get duration of video\n        cmd = ['ffprobe', '-i', video_path, '-v', 'quiet', '-show_entries', 'format=duration', '-of', 'csv']\n        result = subprocess.run(cmd, capture_output=True, text=True)\n        duration = float(result.stdout.strip())\n        start = max(0, duration - 10)\n        subprocess.run(['ffmpeg', '-i', video_path, '-c', 'copy', '-ss', str(start), '-t', '10', str(result_path)], check=True)\n    \n    # Output the result path\n    print(f'Successfully created {result_path}')\n    print(f'Video duration: {duration}')\n    \n    # Exit with 0\n    sys.exit(0)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
