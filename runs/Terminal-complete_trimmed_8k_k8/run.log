Sending keys: ["cat > compute_avg.py << 'EOF'\nimport csv\nfrom datetime import datetime\n\n# High temperatures\nhigh = {}\nwith open('daily_temp_sf_high.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        date_str = row['date']\n        temp = int(row['temperature'])\n        # date_str is YYYY-MM-DD\n        high[date_str] = temp\n\n# Low temperatures\nlow = {}\nwith open('daily_temp_sf_low.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        date_str = row['date']\n        temp = int(row['temperature'])\n        # Try parsing with two formats\n        formats = ['%m/%d/%Y %H:%M:%S', '%m-%d-%Y %H:%M:%S']\n        parsed = None\n        for fmt in formats:\n            try:\n                dt = datetime.strptime(date_str, fmt)\n                parsed = dt.strftime('%Y-%m-%d')\n                break\n            except ValueError:\n                continue\n        if parsed is None:\n            print(f'Warning: Could not parse date {date_str}')\n            continue\n        low[parsed] = temp\n\nprint('High dates:', list(high.keys()))\nprint('Low dates:', list(low.keys()))\n\n# Compute differences\ndiffs = []\nfor h_date, h_temp in high.items():\n    if h_date in low:\n        l_temp = low[h_date]\n        diff = h_temp - l_temp\n        diffs.append(diff)\n        print(f'Date {h_date}: high {h_temp}, low {l_temp}, diff {diff}')\n    else:\n        print(f'Warning: No low temperature for date {h_date}')\n\nif diffs:\n    avg = sum(diffs) / len(diffs)\n    print(f'Differences: {diffs}')\n    print(f'Average: {avg}')\n    with open('avg_temp.txt', 'w') as out:\n        out.write(str(avg))\nelse:\n    print('No matching dates')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
