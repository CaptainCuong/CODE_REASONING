Sending keys: ['cat > about.html << \'EOF\'\n<!DOCTYPE html>\n<html>\n<head>\n    <title>About Me</title>\n    <style>\n        body { font-family: Arial, sans-serif; margin: 40px; }\n        h1 { color: #2c3e50; }\n        h2 { color: #34495e; }\n        h3 { color: #2c3e50; }\n    </style>\n</head>\n<body>\n    <h1>About Me</h1>\n    <p>Dr. Lydia Moreno is an associate professor of Computational Neuroscience at Riverbend University’s School of Biological Sciences. Her work sits at the intersection of machine learning, systems neuroscience, and bioinformatics, aiming to unravel how neural circuits encode and process complex sensory information. She received her Ph.D. in Computational Biology from Baywood Institute of Technology and completed postdoctoral training in high‑throughput imaging analysis at Northborough Research Center.</p>\n\n    <h2>Education</h2>\n    <ul>\n        <li><strong>Ph.D., Computational Biology</strong> - Baywood Institute of Technology, 2014–2019</li>\n        <li><strong>M.Sc., Bioinformatics</strong> - Riverbend University, 2012–2014</li>\n        <li><strong>B.Sc., Computer Science</strong> - Crestfield College of Engineering, 2008–2012</li>\n    </ul>\n\n    <h2>Research Interests</h2>\n    <ul>\n        <li>Neural Encoding & Decoding</li>\n        <li>Machine Learning for Biomedical Imaging</li>\n        <li>Single‑Cell Omics</li>\n        <li>Explainable AI in Neuroscience</li>\n    </ul>\n\n    <h2>Selected Projects</h2>\n    <p><strong>DeepVision: High‑Resolution Neural Activity Mapping</strong></p>\n    <p>Lead Developer & Project Coordinator</p>\n    <ul>\n        <li>Desired</li>\n        <li>Desired</li>\n    </ul>\n    <p><strong>NeuroGraph: Graph Neural Networks for Circuit Analysis</strong></p>\n    <p>Principal Investigator</p>\n    <ul>\n        <li>Desired</li>\n    </ul>\n    <p><strong>CellMap: Multi‑Modal Single‑Cell Atlas</strong></p>\n    <p>Co‑Principal Investigator</p>\n    <ul>\n        <li>Desired</li>\n    </ul>\n\n    <h2>Publications</h2>\n    <ul>\n        <li>Moreno, L., & Patel, A. (2024). "Temporal Convolutional Networks Decode Visual Stimuli from Two‑Photon Signals." <em>Journal of Computational Neuroscience</em>, 45(2), 123–137.</li>\n        <li>Moreno, L., Zhang, W., & Singh, R. (2023). "Graph Embedding Techniques Reveal Synaptic Motifs in EM Datasets." <em>Neuroinformatics</em>, 21(4), 299–312.</li>\n        <li>Moreno, L. et al. (2022). "Integrative Single‑Cell Atlas of Human Cerebral Organoids." <em>Cell Systems</em>, 9(1), 67–82.</li>\n        <li>Chen, J., Moreno, L., & Russo, M. (2021). "Explainable AI Techniques in Neural Decoding." <em>Frontiers in Neuroscience</em>, 15, 756843.</li>\n    </ul>\n\n    <h2>Skills & Tools</h2>\n    <ul>\n        <li>Python, R, C++</li>\n        <li>PyTorch, TensorFlow, scikit‑learn, NetworkX</li>\n        <li>Nextflow, Snakemake, Docker, Kubernetes</li>\n        <li>Matlab, Jupyter, Seurat, Scanpy</li>\n        <li>D3.js, Plotly, Matplotlib</li>\n    </ul>\n\n    <h2>Contact</h2>\n    <p><strong>Email:</strong> <a href="mailto:lydia.moreno@riverbend.edu">lydia.moreno@riverbend.edu</a></p>\n    <p><strong>Office:</strong> Blakely Hall, Room 312, Riverbend University</p>\n    <p><strong>Twitter:</strong> <a href="https://twitter.com/LydiaNeuroLab">@LydiaNeuroLab</a></p>\n    <p><strong>GitHub:</strong> <a href="https://github.com/lydia‑moreno">github.com/lydia‑moreno</a></p>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > blog.html << \'EOF\'\n<!DOCTYPE html>\n<html>\n<head>\n    <title>Blog</title>\n    <style>\n        body { font-family: Arial, sans-serif; margin: 40px; }\n        h1 { color: #2c3e50; }\n        h2 { color: #34495e; }\n    </style>\n</head>\n<body>\n    <h1>Blog</h1>\n    <p>Latest posts from Dr. Lydia Moreno</p>\n    <h2>March 2025: Building Interpretable Deep Learning Models for Neuroscience</h2>\n    <p>Explore how interpretable deep learning models are revolutionizing our understanding of neural circuits...</p>\n    <h2>January 2025: Bridging Machine Learning and Single-Cell Genomics</h2>\n    <p>Discover how machine learning techniques are transforming single-cell genomics research...</p>\n    <h2>November 2024: Scaling Graph Neural Networks for Connectomics</h2>\n    <p>Graph neural networks offer new perspectives on connectome analysis...</p>\n    <p><a href="#">View more posts</a></p>\n</body>\n</html>\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
