e fits.\n\n# Write results\nresults = {\n    'G': {\n        'x0': float(popt1[0]),\n        'gamma': float(popt1[1]),\n        'amplitude': float(popt1[2]),\n        'offset': float(popt1[3])\n    },\n    '2D': {\n        'x0': float(popt2[0]),\n        'gamma': float(popt2[1]),\n        'amplitude': float(popt2[2]),\n        'offset': float(popt2[3])\n    }\n}\n\nprint('\\nResults:')\nprint(json.dumps(results, indent=2))\n\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
