Sending keys: ["cat > generate_json.py << 'EOF'\nimport csv\nimport json\nfrom datetime import datetime, timezone\nfrom collections import defaultdict\n\n# Read departments\ndept_map = {}\nwith open('data/departments.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        dept_map[row['id']] = {\n            'id': row['id'],\n            'name': row['name'],\n            'budget': float(row['budget']),\n            'employees': [],\n            'projects': []\n        }\n\n# Read employees\nemployees = []\nwith open('data/employees.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        employees.append({\n            'id': row['id'],\n            'name': row['name'],\n            'position': row['position'],\n            'skills': row['skills'].split(';'),\n            'years_of_service': int(row['years_of_service']),\n            'department_id': row['department_id']\n        })\n\n# Read projects\nwith open('data/projects.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        members = row['member_ids'].split(';') if row['member_ids'] else []\n        dept_id = row['department_id']\n        dept_map[dept_id]['projects'].append({\n            'name': row['name'],\n            'status': row['status'],\n            'members': members,\n            'deadline': row['deadline'],\n            'department_id': dept_id\n        })\n\n# Build organization structure\norganization = {\n    'metadata': {\n        'version': '1.0',\n        'timestamp': datetime.now(timezone.utc).isoformat(),\n        'generator': 'CSV to JSON Converter'\n    },\n    'organization': {\n        'name': 'Acme Corporation',\n        'founded': '2020-01-01',\n        'departments': []\n    },\n    'statistics': {\n        'averageDepartmentBudget': 0.0,\n        'totalEmployees': 0,\n        'skillDistribution': defaultdict(int),\n        'departmentSizes': defaultdict(int),\n        'projectStatusDistribution': defaultdict(int),\n        'averageYearsOfService': 0.0\n    }\n}\n\n# Fill departments\nfor dept_id, dept in dept_map.items():\n    # employees per department\n    dept_employees = [e for e in employees if e['department_id'] == dept_id]\n    dept['employees'] = dept_employees\n    organization['organization']['departments'].append(dept)\n\n# Compute statistics\n# averageDepartmentBudget\ntotal_budget = sum(d['budget'] for d in dept_map.values())\navg_budget = total_budget / len(dept_map)\n\n# totalEmployees\ntotal_employees = len(employees)\n\n# skillDistribution\nskill_counts = defaultdict(int)\nfor e in employees:\n    for skill in e['skills']:\n        skill_counts[skill] += 1\n\n# departmentSizes\nfor e in employees:\n    dept_id = e['department_id']\n    dept_map[dept_id]['department_size'] = dept_map[dept_id]['department_size'] + 1\n\n# projectStatusDistribution\nstatus_counts = defaultdict(int)\nfor p in dept_map.values():\n    for project in p['projects']:\n        status_counts[project['status']] += 1\n\n# averageYearsOfService\ntotal_years = sum(e['years_of_service'] for e in employees)\navg_years = total_years / total_employees if total_employees > 0 else 0.0\n\n# Build final statistics dict\nstats = organization['statistics']\nstats['averageDepartmentBudget'] = avg_budget\nstats['totalEmployees'] = total_employees\nstats['skillDistribution'] = dict(skill_counts)\n# departmentSizes: count of employees per department\nfor dept_id, dept in dept_map.items():\n    stats['departmentSizes'][dept['name']] = len(dept['employees'])\nstats['projectStatusDistribution'] = dict(status_counts)\nstats['averageYearsOfService'] = avg_years\n\n# Write output\nwith open('organization.json', 'w') as f:\n    json.dump(organization, f, indent=2)\n\nprint('organization.json generated')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
