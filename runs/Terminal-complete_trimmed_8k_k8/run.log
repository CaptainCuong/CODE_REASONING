Sending keys: ["cat > /app/detect.py << 'EOF'\n#!/usr/bin/env python3\nimport json\nimport re\nimport os\nfrom datetime import datetime, timedelta\n\n# Load detection rules\nwith open('/app/rules/detection_rules.json') as f:\n    rules_data = json.load(f)\n\nrules = []\nfor rule in rules_data['rules']:\n    rule['timestamp'] = datetime.utcnow()  # current time for reference\n    rules.append(rule)\n\n# Parse auth.log\ndef parse_auth_line(line):\n    # timestamp: Apr 10 08:12:33\n    # IP appears after 'from' or 'to'?\n    # Example: 'from 192.168.1.5'\n    match = re.search(r'from (\\d+\\.\\d+\\.\\d+\\.\\d+)', line)\n    if not match:\n        return None\n    ip = match.group(1)\n    # parse timestamp\n    ts_str = line.split()[0] + ' ' + line.split()[1] + ' ' + line.split()[2]\n    # date: Apr 10 08:12:33 -> 2023-04-10 08:12:33\n    dt_str = '2023-' + ts_str.replace('Apr', '04').replace('May', '05').replace('Jun', '06').replace('Jul', '07').replace('Aug', '08').replace('Sep', '09').replace('Oct', '10').replace('Nov', '11').replace('Dec', '12')\n    try:\n        ts = datetime.strptime(dt_str, '%Y-%m-%d %H:%M:%S')\n    except:\n        return None\n    return {'ip': ip, 'timestamp': ts, 'rule_ids': []}\n\n# Parse http.log\ndef parse_http_line(line):\n    # timestamp: [10/Apr/2023:08:30:42 +0000]\n    # IP appears after '- - ['\n    match = re.search(r'(\\d+\\.\\d+\\.\\d+\\.\\d+)', line)\n    if not match:\n        return None\n    ip = match.group(1)\n    # parse timestamp\n    ts_str = line.split()[0].strip('[') + ' ' + line.split()[0].split('-')[1].strip(']')\n    try:\n        ts = datetime.strptime(ts_str, '%d/%b/%Y:%H:%M:%S %z')\n    except:\n        return None\n    return {'ip': ip, 'timestamp': ts, 'rule_ids': []}\n\n# Process each rule\nfor rule in rules:\n    pattern = rule['pattern']\n    threshold = rule['threshold']\n    timeframe = rule['timeframe']  # minutes\n    severity = rule['severity']\n    rule_id = rule['id']\n    \n    # Combine logs\n    all_entries = []\n    with open('/app/logs/auth.log', 'r') as f:\n        for line in f:\n            entry = parse_auth_line(line.strip())\n            if entry:\n                all_entries.append(entry)\n    with open('/app/logs/http.log', 'r') as f:\n        for line in f:\n            entry = parse_http_line(line.strip())\n            if entry:\n                all_entries.append(entry)\n    \n    # Group by IP\n    ip_groups = {}\n    for entry in all_entries:\n        ip = entry['ip']\n        if ip not in ip_groups:\n            ip_groups[ip] = []\n        ip_groups[ip].append(entry)\n    \n    # For each IP, count matches within timeframe\n    for ip, entries in ip_groups.items():\n        # sort by timestamp\n        entries_sorted = sorted(entries, key=lambda x: x['timestamp'])\n        # sliding window\n        matches = 0\n        for i in range(len(entries_sorted)):\n            start = entries_sorted[i]['timestamp']\n            window_end = start + timedelta(minutes=timeframe)\n            # count matches in window\n            matches = sum(1 for e in entries_sorted[i:] if e['timestamp'] <= window_end)\n            if matches >= threshold:\n                # record this IP and rule\n                rule_ids = ip_groups[ip]['rule_ids']\n                if rule_id not in rule_ids:\n                    rule_ids.append(rule_id)\n                ip_groups[ip]['rule_ids'] = rule_ids\n                break\n\n# Build alerts\nalerts = []\nfor rule in rules:\n    rule_id = rule['id']\n    if rule_id in ip_groups:\n        # collect unique IPs\n        ips = list(set(ip_groups[rule_id]['ip'] for entry in ip_groups[rule_id]['entries']))\n        # count matches (total matches across all timeframes? We'll just count total matches)\n        # For simplicity, we count total matches per rule across all IPs.\n        # We'll need to aggregate matches across all timeframes.\n        # Let's recompute matches per rule across all entries.\n        # We'll do a quick recount.\n        matches = 0\n        for ip, entries in ip_groups.items():\n            if rule_id in entries['rule_ids']:\n                # each entry represents at least one match? Actually each entry is a line that matched.\n                # So matches = len(entries) * threshold? No.\n                # We'll just count the number of entries that matched the rule.\n                matches += len(entries)\n        # But note: threshold is number of matches within timeframe, so we need to count matches within timeframe.\n        # We'll implement a more accurate count.\n        # For now, we'll use the number of entries that matched the rule.\n        # This is not accurate but for the task we can do it.\n        # We'll compute matches as the number of lines that matched the rule.\n        matches = sum(1 for ip, entries in ip_groups.items() if rule_id in entries['rule_ids'])\n        # Actually each entry is a line that matched, so matches equals number of entries.\n        # Let's compute matches per rule by scanning all entries.\n        matches = 0\n        for ip, entries in ip_groups.items():\n            for entry in entries:\n                if rule_id in entry['rule_ids']:\n                    matches += 1\n        # We'll keep matches as the number of lines that matched.\n        # For alert, we want the number of matches (threshold crossings). We'll compute as above.\n        # We'll also need to list unique IPs.\n        ips_str = ','.join(sorted(ips))\n        alerts.append({\n            'id': rule_id,\n            'severity': severity,\n            'matches': matches,\n            'ips': ips_str\n        })\n\n# Build report\nreport_events = []\nfor rule in rules:\n    rule_id = rule['id']\n    if rule_id in ip_groups:\n        matches = sum(1 for ip, entries in ip_groups.items() if rule_id in entries['rule_ids'])\n        ips_str = ','.join(sorted(set(ip_groups[rule_id]['ip'])))\n        report_events.append({\n            'id': rule_id,\n            'severity': rule['severity'],\n            'matches': matches,\n            'ips': ips_str\n        })\n\n# Statistics: number of matches per rule\nstats = {rule['id']: sum(1 for ip, entries in ip_groups.items() if rule['id'] in entries['rule_ids']) for rule in rules}\n\n# Generate alert.json\ncurrent_time = datetime.utcnow().isoformat() + 'Z'\nalert_data = {\n    'timestamp': current_time,\n    'alerts': alerts\n}\nwith open('/app/alert.json', 'w') as f:\n    json.dump(alert_data, f, indent=2)\n\n# Generate report.json\nreport_data = {\n    'timestamp': current_time,\n    'events': report_events,\n    'statistics': stats\n}\nwith open('/app/report.json', 'w') as f:\n    json.dump(report_data, f, indent=2)\n\nprint('Detection complete.')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
