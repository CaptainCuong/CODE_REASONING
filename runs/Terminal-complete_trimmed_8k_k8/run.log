Sending keys: ['cat > /app/agent.py << \'EOF\'\nimport torch\nimport numpy as np\nimport os\nfrom typing import Dict, Any\n\nclass Agent:\n    def __init__(self, state_dim: int, action_dim: int, device=\'cpu\'):\n        self.state_dim = state_dim\n        self.action_dim = action_dim\n        self.device = device\n        self.model = torch.nn.Sequential(\n            torch.nn.Linear(state_dim, 128),\n            torch.nn.ReLU(),\n            torch.nn.Linear(128, 128),\n            torch.nn.ReLU(),\n            torch.nn.Linear(128, action_dim)\n        ).to(self.device)\n        self.target_model = torch.nn.Sequential(\n            torch.nn.Linear(state_dim, 128),\n            torch.nn.ReLU(),\n            torch.nn.Linear(128, 128),\n            torch.nn.ReLU(),\n            torch.nn.Linear(128, action_dim)\n        ).to(self.device)\n        self.optimizer = torch.optim.Adam(self.model.parameters(), lr=0.001)\n        self.criterion = torch.nn.MSELoss()\n        self.memory = []  # list of tuples (state, action, reward, next_state, terminated)\n        self.batch_size = 32\n        self.gamma = 0.99\n    \n    def select_action(self, current_observation: np.ndarray) -> int:\n        # Convert observation to tensor\n        state = torch.from_numpy(current_observation).float().to(self.device)\n        with torch.no_grad():\n            q_values = self.model(state)\n            return int(np.argmax(q_values.numpy()))\n    \n    def save(self, directory: str):\n        os.makedirs(directory, exist_ok=True)\n        torch.save(self.model, os.path.join(directory, \'model.pt\'))\n        torch.save(self.target_model, os.path.join(directory, \'target_model.pt\'))\n    \n    def load(self, directory: str):\n        self.model = torch.load(os.path.join(directory, \'model.pt\'))\n        self.target_model = torch.load(os.path.join(directory, \'target_model.pt\'))\n        # Ensure device matches\n        self.model.to(self.device)\n        self.target_model.to(self.device)\n    \n    def train(self, env, num_episodes=1000, max_steps=1000):\n        """Train the agent using experience replay."""\n        # Initialize target model as copy of model\n        self.target_model.load_state_dict(self.model.state_dict())\n        \n        for episode in range(num_episodes):\n            current_observation, info = env.reset()\n            for step in range(max_steps):\n                # Select action\n                action = self.select_action(current_observation)\n                # Step in environment\n                next_observation, reward, terminated, truncated, info = env.step(action)\n                # Store experience\n                self.memory.append((\n                    current_observation.astype(float),\n                    action,\n                    reward,\n                    next_observation.astype(float),\n                    terminated or truncated\n                ))\n                \n                if terminated or truncated:\n                    break\n                current_observation = next_observation\n            \n            # If memory is too large, we can limit it (optional)\n            # We\'ll use all memory for each episode (but we can sample)\n            # For simplicity, we\'ll sample from memory\n            if len(self.memory) > self.batch_size:\n                self.memory = self.memory[-self.batch_size:]  # keep recent\n            \n            # Train using stored experiences\n            if len(self.memory) > 0:\n                states, actions, rewards, next_states, terminals = zip(*self.memory)\n                states = torch.tensor(states, dtype=torch.float32).to(self.device)\n                actions = torch.tensor(actions, dtype=torch.int64).to(self.device)\n                rewards = torch.tensor(rewards, dtype=torch.float32).to(self.device)\n                next_states = torch.tensor(next_states, dtype=torch.float32).to(self.device)\n                terminals = torch.tensor(terminals, dtype=torch.float32).to(self.device)\n                \n                # Compute Q-values for current states\n                q_values = self.model(states).gather(1, actions.unsqueeze(1)).squeeze()\n                # Compute target Q-values\n                with torch.no_grad():\n                    next_q = self.target_model(next_states).max(1)[0]\n                    targets = rewards + self.gamma * next_q * (1 - terminals)\n                \n                # Update model\n                loss = self.criterion(q_values, targets)\n                self.optimizer.zero_grad()\n                loss.backward()\n                self.optimizer.step()\n                \n                # Update target model (optional: do after a few updates or use decay)\n                # We\'ll copy after every N updates, or just keep target model as is for now.\n                # For simplicity, we\'ll copy after each training step (but we\'ll do after each episode)\n                self.target_model.load_state_dict(self.model.state_dict())\n                \n                # Clear memory (optional: we can reuse memory across episodes)\n                # We\'ll clear memory to free space\n                self.memory.clear()\n        \n        print(f\'Trained for {num_episodes} episodes\')\n\nif __name__ == \'__main__\':\n    # Quick test\n    agent = Agent(4, 2)\n    print(\'Agent created\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
