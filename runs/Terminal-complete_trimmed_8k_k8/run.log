Sending keys: ["cat > train_agent.py << 'EOF'\nimport gymnasium as gym\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport numpy as np\nimport os\nimport time\n\n# DQN with experience replay and target network\nclass DQNAgent:\n    def __init__(self, model_path=None, device='cpu'):\n        self.device = torch.device(device)\n        self.model = nn.Sequential(\n            nn.Linear(4, 32),\n            nn.ReLU(),\n            nn.Linear(32, 32),\n            nn.ReLU(),\n            nn.Linear(32, 2)\n        ).to(self.device)\n        self.target_model = nn.Sequential(\n            nn.Linear(4, 32),\n            nn.ReLU(),\n            nn.Linear(32, 32),\n            nn.ReLU(),\n            nn.Linear(32, 2)\n        ).to(self.device)\n        # Copy target model weights\n        self.target_model.load_state_dict(self.model.state_dict())\n        self.optimizer = optim.Adam(self.model.parameters(), lr=0.001)\n        self.criterion = nn.MSELoss()\n        self.replay_buffer = []\n        self.max_replay = 10000\n        self.batch_size = 32\n        self.gamma = 0.99\n        self.epsilon = 0.1\n        self.tau = 0.005  # target network update\n        \n        if model_path and os.path.exists(model_path):\n            self.load(model_path)\n    \n    def select_action(self, observation):\n        if np.random.rand() < self.epsilon:\n            return env.action_space.sample()\n        observation = torch.tensor(observation, dtype=torch.float32).to(self.device)\n        q_values = self.model(observation)\n        return int(q_values.argmax().item())\n    \n    def save(self, save_dir):\n        os.makedirs(save_dir, exist_ok=True)\n        model_path = os.path.join(save_dir, 'model.pt')\n        torch.save(self.model, model_path)\n        print(f'Model saved to {model_path}')\n    \n    def load(self, load_dir):\n        model_path = os.path.join(load_dir, 'model.pt')\n        if not os.path.exists(model_path):\n            raise FileNotFoundError(f'Model file not found at {model_path}')\n        self.model = torch.load(model_path, map_location='cpu').to(self.device)\n        # Update target network\n        self.target_model.load_state_dict(self.model.state_dict())\n        print(f'Model loaded from {model_path}')\n    \n    def train(self, env, num_episodes=100, max_steps=1000):\n        for episode in range(num_episodes):\n            observation, info = env.reset()\n            total_reward = 0\n            for step in range(max_steps):\n                action = self.select_action(observation)\n                next_observation, reward, terminated, truncated, info = env.step(action)\n                total_reward += reward\n                \n                # Store experience\n                self.replay_buffer.append((observation, action, reward, next_observation, terminated))\n                \n                # If buffer is full, sample random batch\n                if len(self.replay_buffer) > self.max_replay:\n                    self.replay_buffer.pop(0)\n                \n                observation = next_observation\n                if terminated or truncated:\n                    break\n            # After each episode, update target network\n            if episode % 10 == 0:\n                self.target_model.load_state_dict(self.model.state_dict())\n            \n            # Train with a random batch\n            if len(self.replay_buffer) >= self.batch_size:\n                batch = self.replay_buffer[-self.batch_size:]\n                obs_batch = torch.tensor([item[0] for item in batch], dtype=torch.float32).to(self.device)\n                action_batch = torch.tensor([item[1] for item in batch], dtype=torch.long).to(self.device)\n                reward_batch = torch.tensor([item[2] for item in batch], dtype=torch.float32).to(self.device)\n                next_obs_batch = torch.tensor([item[3] for item in batch], dtype=torch.float32).to(self.device)\n                terminated_batch = torch.tensor([item[4] for item in batch], dtype=torch.bool).to(self.device)\n                \n                # Compute Q-values for current states\n                current_q = self.model(obs_batch).gather(1, action_batch.unsqueeze(1)).squeeze()\n                # Compute target Q-values\n                next_q = self.target_model(next_obs_batch).max(1)[0]\n                target_q = current_q + self.gamma * next_q * (1 - terminated_batch)\n                \n                loss = self.criterion(current_q, target_q)\n                self.optimizer.zero_grad()\n                loss.backward()\n                self.optimizer.step()\n            \n            print(f'Episode { episode + 1 }/ { num_episodes }, Total Reward: { total_reward }', end='\\r')\n        print('\\nTraining complete.')\n\nif __name__ == '__main__':\n    env = gym.make('CartPole-v1')\n    agent = DQNAgent()\n    agent.train(env, num_episodes=100)\n    env.close()\n    # Save model\n    agent.save('/app/trained_model')\n    print('Model saved.')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
