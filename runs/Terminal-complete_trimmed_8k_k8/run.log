dates.append({\'value\': 5000, \'format\': None, \'column\': \'D\', \'row\': 4})\n\n# Prepare batch update request\nbatch_update = {\'updates\': updates}\nurl = f"http://api:8000/spreadsheets/{spreadsheet_id}/sheets/{sheet_id}/cells/batch_update"\nresponse = requests.post(url, json=batch_update)\nprint(\'Cells updated:\', response.json())\n\n# Print final data to verify\nprint(\'\\nFinal data:\')\nresponse = requests.get(f"http://api:8000/spreadsheets/{spreadsheet_id}/sheets/{sheet_id}")\nprint(json.dumps(response.json(), indent=2))\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
