dict(int),\n        'projectStatusDistribution': defaultdict(int),\n        'averageYearsOfService': 0.0\n    }\n}\n\n# Fill departments\nfor dept_id, dept in dept_map.items():\n    # employees per department\n    dept_employees = [e for e in employees if e['department_id'] == dept_id]\n    dept['employees'] = dept_employees\n    organization['organization']['departments'].append(dept)\n\n# Compute statistics\n# averageDepartmentBudget\ntotal_budget = sum(d['budget'] for d in dept_map.values())\navg_budget = total_budget / len(dept_map)\n\n# totalEmployees\ntotal_employees = len(employees)\n\n# skillDistribution\nskill_counts = defaultdict(int)\nfor e in employees:\n    for skill in e['skills']:\n        skill_counts[skill] += 1\n\n# departmentSizes: count of employees per department\nfor dept_id, dept in dept_map.items():\n    dept_size = len(dept['employees'])\n    organization['statistics']['departmentSizes'][dept['name']] = dept_size\n\n# projectStatusDistribution\nstatus_counts = defaultdict(int)\nfor p in dept_map.values():\n    for project in p['projects']:\n        status_counts[project['status']] += 1\n\n# averageYearsOfService\ntotal_years = sum(e['years_of_service'] for e in employees)\navg_years = total_years / total_employees if total_employees > 0 else 0.0\n\n# Build final statistics dict\nstats = organization['statistics']\nstats['averageDepartmentBudget'] = avg_budget\nstats['totalEmployees'] = total_employees\nstats['skillDistribution'] = dict(skill_counts)\nstats['projectStatusDistribution'] = dict(status_counts)\nstats['averageYearsOfService'] = avg_years\n\n# Write output\nwith open('organization.json', 'w') as f:\n    json.dump(organization, f, indent=2)\n\nprint('organization.json generated')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
