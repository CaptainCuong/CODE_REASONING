h.save(self.model, model_path)\n        print(f'Model saved to {model_path}')\n    \n    def load(self, load_dir):\n        model_path = os.path.join(load_dir, 'model.pt')\n        if not os.path.exists(model_path):\n            raise FileNotFoundError(f'Model file not found at {model_path}')\n        self.model = torch.load(model_path, map_location='cpu').to(self.device)\n        # Update target network\n        self.target_model.load_state_dict(self.model.state_dict())\n        print(f'Model loaded from {model_path}')\n    \n    def train(self, env, num_episodes=100, max_steps=1000):\n        # We'll also decay epsilon after training\n        for episode in range(num_episodes):\n            observation, info = env.reset()\n            total_reward = 0\n            for step in range(max_steps):\n                action = self.select_action(observation)\n                next_observation, reward, terminated, truncated, info = env.step(action)\n                total_reward += reward\n                \n                # Store experience\n                self.replay_buffer.append((observation, action, reward, next_observation, terminated))\n                \n                # If buffer is full, sample random batch\n                if len(self.replay_buffer) > self.max_replay:\n                    self.replay_buffer.pop(0)\n                \n                observation = next_observation\n                if terminated or truncated:\n                    break\n            # After each episode, update target network\n            if episode % 10 == 0:\n                self.target_model.load_state_dict(self.model.state_dict())\n            \n            # Train with a random batch\n            if len(self.replay_buffer) >= self.batch_size:\n                batch = self.replay_buffer[-self.batch_size:]\n                # Convert batch to numpy arrays for efficient tensor creation\n                obs_arr = np.array([item[0] for item in batch], dtype=np.float32)\n              