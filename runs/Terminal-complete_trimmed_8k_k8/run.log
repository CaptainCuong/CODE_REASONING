Sending keys: ["cat > fibonacci_server.py << 'EOF'\nimport sys\nimport json\nfrom http.server import HTTPServer, BaseHTTPRequestHandler\nfrom urllib.parse import urlparse, parse_qs\n\ndef fibonacci(n):\n    if n == 0 or n == 1:\n        return 1\n    a, b = 1, 1\n    for _ in range(2, n+1):\n        a, b = b, a + b\n    return b\n\nclass FibonacciHandler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        query = parse_qs(parsed.query)\n        if 'n' not in query:\n            self.send_error(400, 'Missing query parameter n')\n            return\n        n_str = query['n'][0]\n        try:\n            n = int(n_str)\n        except ValueError:\n            self.send_error(400, 'n must be an integer')\n            return\n        result = fibonacci(n)\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.end_headers()\n        self.wfile.write(json.dumps({'result': result}).encode())\n\nif __name__ == '__main__':\n    server = HTTPServer(('0.0.0.0', 3000), FibonacciHandler)\n    print('Starting server on port 3000...')\n    server.serve_forever()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
