Sending keys: ["cat > split.py << 'EOF'\n#!/usr/bin/env python3\nimport os\nimport hashlib\nfrom collections import defaultdict\n\nsample_dir = 'c4_sample'\nreshard_dir = 'c4_reshard'\n\n# Ensure reshard directory exists\nos.makedirs(reshard_dir, exist_ok=True)\n\n# Dictionary to map chunk file path to original line index and chunk content\n# We'll store in a temporary dict for later revert\n# We'll also store mapping from chunk file to its original file and line number\n# But for now, we'll just split and place.\n\n# We'll create a mapping from chunk file to original line index\nchunk_to_original = {}\n\n# We'll also keep track of which subdirectory each chunk goes into\ndir_to_chunk = defaultdict(list)  # dir_path -> list of chunk file paths\n\n# Hash function to get subdirectory number\nhash_func = lambda data: hashlib.sha1(data.encode('utf-8')).hexdigest()\n\ndef get_subdir_number(data):\n    return int(hash_func(data)[:8], 16) % 1000  # 1000 subdirectories\n\n# Process each file in sample_dir\nfor filename in os.listdir(sample_dir):\n    if not os.path.isfile(os.path.join(sample_dir, filename)):\n        continue\n    filepath = os.path.join(sample_dir, filename)\n    line_count = 0\n    with open(filepath, 'r', encoding='utf-8') as f:\n        for line in f:\n            line_count += 1\n    # Split into chunks of up to 30 lines\n    chunks = []\n    with open(filepath, 'r', encoding='utf-8') as f:\n        chunk_lines = []\n        for line in f:\n            chunk_lines.append(line)\n            if len(chunk_lines) == 30:\n                chunks.append(chunk_lines)\n                chunk_lines = []\n        if chunk_lines:\n            chunks.append(chunk_lines)\n    # For each chunk, create a new file\n    for i, chunk in enumerate(chunks):\n        # Create a temporary file name\n        chunk_name = f'{filename}_chunk_{i:03d}.jsonl'\n        chunk_path = os.path.join(reshard_dir, chunk_name)\n        # Write the chunk (preserve newline? chunk_lines already have newlines)\n        with open(chunk_path, 'w', encoding='utf-8') as f:\n            f.writelines(chunk)\n        # Store mapping\n        chunk_to_original[chunk_path] = {\n            'original_file': filename,\n            'line_start': (i-1)*30 + 1,\n            'line_end': i*30\n        }\n        # Determine subdirectory\n        subdir_num = get_subdir_number(chunk[0] if chunk else '')\n        subdir_path = os.path.join(reshard_dir, f'subdir_{subdir_num:03d}')\n        os.makedirs(subdir_path, exist_ok=True)\n        dir_to_chunk[subdir_path].append(chunk_path)\n        # Also store chunk location in subdir\n        os.rename(chunk_path, os.path.join(subdir_path, chunk_name))\n\n# Write mapping for revert\nimport json\nwith open(os.path.join(reshard_dir, 'mapping.json'), 'w') as f:\n    json.dump({'chunk_to_original': chunk_to_original, 'dir_to_chunk': dir_to_chunk}, f)\n\nprint('Done')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
