Sending keys: ["cat > agent.py << 'EOF'\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nimport numpy as np\nimport os\nimport shutil\n\n# Agent class\nclass Agent:\n    def __init__(self, model_path=None):\n        # Define neural network\n        self.model = nn.Sequential(\n            nn.Linear(4, 32),\n            nn.ReLU(),\n            nn.Linear(32, 2),\n            nn.ReLU()  # output Q-values\n        )\n        self.optimizer = optim.Adam(self.model.parameters(), lr=0.001)\n        self.criterion = nn.MSELoss()\n        self.target_model = None  # Not used here, but could be used for training\n        \n        if model_path and os.path.exists(model_path):\n            self.load(model_path)\n        else:\n            self.model = self.model.to('cpu')  # ensure CPU\n    \n    def select_action(self, observation):\n        # observation is a numpy array of shape (4,)\n        observation = torch.tensor(observation, dtype=torch.float32).to('cpu')\n        with torch.no_grad():\n            q_values = self.model(observation)\n        # argmax returns index of max Q-value\n        return int(q_values.argmax().item())\n    \n    def save(self, save_dir):\n        # Save model to directory\n        os.makedirs(save_dir, exist_ok=True)\n        # Save model as a single file\n        model_path = os.path.join(save_dir, 'model.pt')\n        torch.save(self.model, model_path)\n        print(f'Model saved to {model_path}')\n        # Save optimizer and criterion? Not needed for loading.\n        # We'll also save the model as a separate file and maybe a meta file.\n        # For simplicity, we'll just save the model.\n    \n    def load(self, load_dir):\n        model_path = os.path.join(load_dir, 'model.pt')\n        if not os.path.exists(model_path):\n            raise FileNotFoundError(f'Model file not found at {model_path}')\n        self.model = torch.load(model_path, map_location='cpu')\n        print(f'Model loaded from {model_path}')\n    \n    # Optional: training method\n    def train(self, env, num_episodes=100, batch_size=1000):\n        # We'll implement a simple Q-learning with experience replay\n        # but for simplicity, we'll just train with a few episodes.\n        # This is for training only, not used in test.\n        # We'll use a simple online Q-learning.\n        max_steps = 1000\n        gamma = 0.99\n        epsilon = 0.1\n        \n        for episode in range(num_episodes):\n            observation, info = env.reset()\n            total_reward = 0\n            for step in range(max_steps):\n                # Select action\n                action = self.select_action(observation)\n                next_observation, reward, terminated, truncated, info = env.step(action)\n                total_reward += reward\n                \n                # Compute Q-value for current state and action\n                observation_tensor = torch.tensor(observation, dtype=torch.float32).to('cpu')\n                next_observation_tensor = torch.tensor(next_observation, dtype=torch.float32).to('cpu')\n                \n                current_q = self.model(observation_tensor)[action]\n                next_q = self.model(next_observation_tensor).max()  # max over actions\n                \n                # Q-learning update\n                target_q = current_q + gamma * next_q * (1 - terminated)  # assuming terminated/truncated stop\n                \n                # Update network\n                self.optimizer.zero_grad()\n                loss = self.criterion(current_q, target_q)\n                loss.backward()\n                self.optimizer.step()\n                \n                observation = next_observation\n                if terminated or truncated:\n                    break\n            print(f'Episode { episode + 1 }/ { num_episodes }, Total Reward: { total_reward }', end='\\r')\n        print('\\nTraining complete.')\n\n# Example usage:\nif __name__ == '__main__':\n    # Create a simple test\n    env = gym.make('CartPole-v1')\n    agent = Agent()\n    agent.train(env, num_episodes=100)\n    env.close()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
