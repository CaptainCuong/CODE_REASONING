Sending keys: ["cat > check_cert.py << 'EOF'\nimport subprocess\nimport sys\nimport os\nfrom datetime import datetime\n\ndef main():\n    cert_path = '/app/ssl/server.pem'\n    if not os.path.exists(cert_path):\n        print('Error: Certificate file does not exist')\n        sys.exit(1)\n    \n    # Extract subject\n    subject_proc = subprocess.run(['openssl', 'x509', '-in', cert_path, '-subject'],\n                                 capture_output=True, text=True)\n    subject = subject_proc.stdout.strip()\n    \n    # Extract validity\n    validity_proc = subprocess.run(['openssl', 'x509', '-in', cert_path, '-validity'],\n                                   capture_output=True, text=True)\n    validity = validity_proc.stdout.strip()\n    \n    # Extract SHA-256 fingerprint\n    fp_proc = subprocess.run(['openssl', 'x509', '-in', cert_path, '-fingerprint', 'sha256'],\n                             capture_output=True, text=True)\n    fp = fp_proc.stdout.strip()\n    \n    # Parse validity lines to get start and end dates\n    lines = validity.split('\\n')\n    start_line = lines[0] if len(lines) > 0 else ''\n    end_line = lines[1] if len(lines) > 1 else ''\n    # Example: validity: start=2025-01-01, end=2026-01-01, critical=1\n    import re\n    start_match = re.search(r'start=(\\d{4}-\\d{2}-\\d{2})', start_line)\n    end_match = re.search(r'end=(\\d{4}-\\d{2}-\\d{2})', end_line)\n    start_date = start_match.group(1) if start_match else None\n    end_date = end_match.group(1) if end_match else None\n    \n    # Print certificate details\n    print('Subject:')\n    print(subject)\n    print('Validity:')\n    print(validity)\n    print('SHA-256 Fingerprint:')\n    print(fp)\n    \n    # Verify expiration date\n    today = datetime.now().date()\n    if end_date:\n        from datetime import datetime\n        exp_date = datetime.strptime(end_date, '%Y-%m-%d').date()\n        days_to_expiry = (exp_date - today).days\n        if days_to_expiry < 30:\n            print('Warning: Certificate is within 30 days of expiration')\n        else:\n            print('Certificate verification successful')\n    else:\n        print('Could not parse expiration date')\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
