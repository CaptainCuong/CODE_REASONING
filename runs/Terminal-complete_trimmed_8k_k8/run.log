       self.save()\n    \n    def update(self):\n        batch = self.memory[-self.batch_size:]\n        batch = np.array(batch)\n        state = batch[:, 0]\n        action = batch[:, 1]\n        reward = batch[:, 2]\n        next_state = []\n        for s in state:\n            _, _, terminated, truncated, _ = env.step(action)\n            next_state.append(s)\n        next_state = np.array(next_state)\n        current_q = self.model(state)\n        next_q = self.target_model(next_state)\n        target_q = current_q + self.gamma * next_q\n        self.optimizer.zero_grad()\n        loss = self.criterion(current_q, target_q)\n        loss.backward()\n        self.optimizer.step()\n    \n    def save(self, model_dir="/app/trained_model"):\n        os.makedirs(model_dir, exist_ok=True)\n        torch.save(self.model, os.path.join(model_dir, "model.pth"))\n        print(f"Model saved to {model_dir}")\n    \n    def load(self, model_dir="/app/trained_model"):\n        model_path = os.path.join(model_dir, "model.pth")\n        if os.path.exists(model_path):\n            self.model = torch.load(model_path, map_location=self.device)\n            self.target_model = self.model.copy()\n            print(f"Model loaded from {model_dir}")\n        else:\n            print(f"No model found at {model_path}")\n\nif __name__ == "__main__":\n    # Quick test\n    import gymnasium as gym\n    env = gym.make("CartPole-v1")\n    agent = Agent()\n    agent.train(env, num_episodes=100)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
