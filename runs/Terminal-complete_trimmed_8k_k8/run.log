Sending keys: ["cat > verify.py << 'EOF'\nimport csv\nfrom datetime import datetime\n\nhigh = {}\nwith open('daily_temp_sf_high.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        high[row['date']] = int(row['temperature'])\n\nlow = {}\nwith open('daily_temp_sf_low.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        date_str = row['date']\n        temp = int(row['temperature'])\n        formats = ['%m/%d/%Y %H:%M:%S', '%m-%d-%Y %H:%M:%S']\n        parsed = None\n        for fmt in formats:\n            try:\n                dt = datetime.strptime(date_str, fmt)\n                parsed = dt.strftime('%Y-%m-%d')\n                break\n            except ValueError:\n                continue\n        if parsed is None:\n            print(f'Warning: Could not parse {date_str}')\n            continue\n        low[parsed] = temp\n\nprint('High dates:', list(high.keys()))\nprint('Low dates:', list(low.keys()))\n\n# Check for missing dates\nmissing = set(high.keys()) - set(low.keys())\nif missing:\n    print(f'Missing low dates for high dates: {missing}')\nelse:\n    print('All high dates have low dates.')\n\n# Compute differences\ndiffs = []\nfor h_date, h_temp in high.items():\n    l_temp = low[h_date]\n    diff = h_temp - l_temp\n    diffs.append((h_date, h_temp, l_temp, diff))\n\nprint('Differences:')\nfor d in diffs:\n    print(f'{d[0]}: high {d[1]}, low {d[2]}, diff {d[3]}')\n\navg = sum(d[3] for d in diffs) / len(diffs)\nprint(f'Average: {avg}')\n\n# Read avg_temp.txt\nwith open('avg_temp.txt', 'r') as f:\n    content = f.read().strip()\nprint(f'Content of avg_temp.txt: {content}')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
