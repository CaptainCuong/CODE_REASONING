Sending keys: ['cat > agent.py << \'EOF\'\nimport torch\nimport numpy as np\nimport os\nimport gymnasium as gym\nfrom typing import Dict, Any\n\nclass Agent:\n    def __init__(self, model_path=None):\n        # Neural network for Q-value estimation\n        self.model = torch.nn.Sequential(\n            torch.nn.Linear(4, 16),\n            torch.nn.ReLU(),\n            torch.nn.Linear(16, 2)\n        )\n        self.optimizer = torch.optim.Adam(self.model.parameters(), lr=0.001)\n        self.device = torch.device(\'cpu\')\n        self.model.to(self.device)\n        self.env = gym.make(\'CartPole-v1\')\n        if model_path is not None:\n            self.load(model_path)  # If model_path is provided, load it\n        self.epsilon = 1.0\n        self.epsilon_decay = 0.9999\n        self.min_epsilon = 0.05\n        self.gamma = 0.99\n        self.batch_size = 32\n        self.replay_buffer = []  # list of (obs, action, reward, next_obs)\n    \n    def select_action(self, observation: np.ndarray) -> int:\n        """Select an action using epsilon-greedy policy."""\n        if np.random.rand() < self.epsilon:\n            return self.env.action_space.sample()\n        else:\n            with torch.no_grad():\n                q_values = self.model(torch.tensor(observation, device=self.device))\n                return int(np.argmax(q_values.numpy()))\n    \n    def train(self, num_episodes=100):\n        """Train the agent for a given number of episodes."""\n        total_rewards = []\n        for episode in range(num_episodes):\n            current_observation, info = self.env.reset()\n            total_reward = 0\n            while True:\n                action = self.select_action(current_observation)\n                next_observation, reward, terminated, truncated, info = self.env.step(action)\n                total_reward += reward\n                current_observation = next_observation\n                if terminated or truncated:\n                    break\n            total_rewards.append(total_reward)\n            # Decay epsilon\n            self.epsilon = max(self.min_epsilon, self.epsilon * self.epsilon_decay)\n        # After training, save the model\n        self.save(\'/app/trained_model\')\n        return np.mean(total_rewards)\n    \n    def save(self, save_dir: str):\n        """Save the model to the specified directory."""\n        os.makedirs(save_dir, exist_ok=True)\n        model_path = os.path.join(save_dir, \'model.pth\')\n        torch.save(self.model, model_path)\n        print(f\'Model saved to {model_path}\')\n    \n    def load(self, load_dir: str):\n        """Load the model from the specified directory."""\n        model_path = os.path.join(load_dir, \'model.pth\')\n        if os.path.exists(model_path):\n            self.model = torch.load(model_path, map_location=self.device)\n            print(f\'Model loaded from {model_path}\')\n        else:\n            print(f\'Model not found at {model_path}\')\n\nif __name__ == \'__main__\':\n    # Quick test\n    agent = Agent()\n    mean = agent.train(100)\n    print(f\'Mean Reward: {mean}\')\n    agent.save(\'/app/trained_model\')\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
