Sending keys: ['cat > /app/server/post-receive << \'EOF\'\n#!/bin/bash\n# This hook is called after receiving a push to the repository.\n# It updates the web directory with the contents of the repository.\n# We assume the repository is at /app/server and the web directory is /app/web.\n# The branch we care about is \'webserver\'.\n# We check out the webserver branch and copy files to /app/web.\n# Note: This hook uses the git executable from the repository.\n\n# Check if the branch is webserver\nBRANCH=webserver\nif [ "$BRANCH" = "" ]; then\n    BRANCH=$(git rev-parse --symbolic-ref refs/heads/webserver 2>/dev/null || true)\nfi\nif [ -z "$BRANCH" ]; then\n    echo "Error: branch not found" >&2\n    exit 1\nfi\n\n# Change to the repository directory\nREPO_DIR="/app/server"\ncd "$REPO_DIR" || exit 1\n\n# Check out the branch and copy files to /app/web\nif git checkout -f "$BRANCH" >/dev/null 2>&1; then\n    # Copy the contents of the repository to /app/web\n    # We copy the whole repository directory (including .git) but we only want the files.\n    # Instead, we can copy the files from the .git directory.\n    # The files are in .git/description, .git/HEAD, .git/objects, .git/index, .git/config, .git/HEAD.\n    # We\'ll copy the entire .git directory to /app/web (or a subdirectory).\n    # But the web server should serve the files, not the git metadata.\n    # Let\'s copy the files that are in the root of the repository (excluding .git).\n    # We\'ll use a git archive to get the files.\n    # Use git archive --format=tar --output=/tmp/archive.tar HEAD\n    # Then extract to /app/web.\n    git archive --format=tar --output=/tmp/archive.tar HEAD\n    mkdir -p /app/web\n    tar -xzf /tmp/archive.tar -C /app/web\n    # Clean up\n    rm -f /tmp/archive.tar\n    echo "Web directory updated successfully."\nelse\n    echo "Failed to checkout branch $BRANCH" >&2\n    exit 1\nfi\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
