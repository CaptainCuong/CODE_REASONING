Sending keys: ["cat > /app/sentiment_api.py << 'EOF'\nfrom flask import Flask, request, json\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\nimport sys\n\ndef main():\n    app = Flask(__name__)\n    \n    # Load model and tokenizer\n    model_path = '/app/model_cache/sentiment_model'\n    model = AutoModelForSequenceClassification.from_pretrained(model_path)\n    tokenizer = AutoTokenizer.from_pretrained(model_path)\n    \n    @app.route('/sentiment', methods=['POST'])\n    def sentiment():\n        try:\n            data = request.get_json()\n            text = data.get('text', '')\n            if not text:\n                return {'error': 'Missing text field'}\n            \n            # Tokenize and predict\n            inputs = tokenizer(text, return_tensors='pt')\n            outputs = model(**inputs)\n            # The model returns log probabilities for each class (positive, negative)\n            # We'll get the predicted class and the confidence scores\n            # For distilbert-base-uncased-finetuned-sst-2-english, the classes are 0: positive, 1: negative\n            # We'll compute confidence by taking the max of the two probabilities\n            confidence_positive = torch.exp(outputs.logits[0]).tolist()[0]\n            confidence_negative = torch.exp(outputs.logits[0]).tolist()[1]\n            \n            # Determine sentiment\n            sentiment = 'positive' if confidence_positive > confidence_negative else 'negative'\n            \n            return {\n                'sentiment': sentiment,\n                'confidence': {\n                    'positive': confidence_positive,\n                    'negative': confidence_negative\n                }\n            }\n        except Exception as e:\n            return {'error': str(e)}\n    \n    if __name__ == '__main__':\n        app.run(host='0.0.0.0', port=5000, debug=False)\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec