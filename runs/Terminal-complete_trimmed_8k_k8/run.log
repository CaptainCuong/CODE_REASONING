Sending keys: ["cat > cli_tool.py << 'EOF'\n#!/usr/bin/env python3\nimport sys\nimport json\nimport torch\nimport PIL.Image as Image\n\n# Load weights from weights.json\ntry:\n    with open('weights.json', 'r') as f:\n        weights = json.load(f)\nexcept FileNotFoundError:\n    print('weights.json not found')\n    sys.exit(1)\n\n# Load image\ntry:\n    img = Image.open(sys.argv[2])\nexcept Exception as e:\n    print(f'Error loading image: {e}')\n    sys.exit(1)\n\n# Flatten image\nimg_vec = img.getdata()\nimg_vec = list(map(float, img_vec))\n\n# Neural network parameters\ninput_dim = 28 * 28\nhidden_dim = 16\noutput_dim = 10\n\n# Initialize weights\nW1 = torch.tensor(weights['input_layer.weight'], dtype=torch.float32)\nb1 = torch.tensor(weights['input_layer.bias'], dtype=torch.float32)\nW2 = torch.tensor(weights['hidden_layer.weight'], dtype=torch.float32)\nb2 = torch.tensor(weights['hidden_layer.bias'], dtype=torch.float32)\nW3 = torch.tensor(weights['output_layer.weight'], dtype=torch.float32)\nb3 = torch.tensor(weights['output_layer.bias'], dtype=torch.float32)\n\n# Neural network inference\nx = torch.relu(b1 + W1 @ torch.tensor(img_vec))\ny = torch.relu(b2 + W2 @ x)\nout = b3 + W3 @ y\npred = torch.argmax(out).item()\n\nprint(pred)\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
