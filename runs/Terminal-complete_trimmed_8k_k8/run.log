ning\n            if len(self.memory) >= self.batch_size:\n                batch = self.memory[-self.batch_size:]\n                states = torch.tensor([b[0] for b in batch], dtype=torch.float32)\n                actions = torch.tensor([b[1] for b in batch], dtype=torch.int64)\n                next_states = torch.tensor([b[2] for b in batch], dtype=torch.float32)\n                rewards = torch.tensor([b[3] for b in batch], dtype=torch.float32)\n                dones = torch.tensor([b[4] for b in batch], dtype=torch.float32)\n                # Compute loss: cross-entropy for action prediction\n                output = self.model(states)\n                pred_actions = torch.argmax(output, dim=1)\n                loss = nn.functional.cross_entropy(output, actions, reduction=\'mean\')\n                self.optimizer.zero_grad()\n                loss.backward()\n                self.optimizer.step()\n        # Save the model after training\n        self.save(model_dir)\n        env.close()\n    \n    def save(self, model_dir):\n        # Ensure directory exists\n        os.makedirs(model_dir, exist_ok=True)\n        torch.save(self.model, os.path.join(model_dir, \'model.pt\'))\n    \n    def load(self, model_dir):\n        # Load the saved model\n        model_path = os.path.join(model_dir, \'model.pt\')\n        if os.path.exists(model_path):\n            self.model = torch.load(model_path)\n            # Ensure model is in eval mode (if it\'s a Sequential, just set to eval)\n            self.model.eval()\n        else:\n            print(f"Model not found at {model_path}")\n            # Initialize random weights\n            self.model = self._build_model()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
