Sending keys: ["cat > evaluate.py << 'EOF'\nimport json\nimport os\nfrom mteb import MTEBTask\nfrom sentence_transformers import SentenceTransformer\n\n# Load STS12 task\ntask = MTEBTask.load('sts12')\n\n# List of models to evaluate\nmodels = [\n    ('sentence-transformers', 'all-MiniLM-L6-v2', 'all-MiniLM-L6-v2'),\n    ('sentence-transformers', 'paraphrase-MiniLM-L6-v2', 'paraphrase-MiniLM-L6-v2'),\n    ('sentence-transformers', 'mdeberta-v3-base', 'mdeberta-v3-base'),\n]\n\nfor org, model_name, tag in models:\n    try:\n        model = SentenceTransformer(f'{org}/{model_name}')\n        # Compute cosine_spearman\n        score = task.cosine_spearman(model)\n        print(f'{org} {model_name}: score={score}')\n        if score > 0.7:\n            # Create directory\n            os.makedirs(f'results/{org}/{model_name}', exist_ok=True)\n            result = {\n                'task': 'sts12',\n                'task_version': '1.0',\n                'dataset': 'sts12',\n                'model': {\n                    'hf_model_org': org,\n                    'hf_model_name': model_name,\n                    'hf_model_tag': tag,\n                    'hf_model_version': 'unknown',\n                    'hf_model_commit_id': tag\n                },\n                'metrics': {\n                    'cosine_spearman': score\n                }\n            }\n            with open(f'results/{org}/{model_name}/{tag}.json', 'w') as f:\n                json.dump(result, f, indent=2)\n            print(f'  -> Result saved to results/{org}/{model_name}/{tag}.json')\n    except Exception as e:\n        print(f'  Error for {org}/{model_name}: {e}')\n\nprint('Evaluation complete.')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
