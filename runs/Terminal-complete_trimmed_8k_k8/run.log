Sending keys: ['cat > /app/intrusion_detector.sh << \'EOF\'\n#!/bin/bash\nset -e\n\nLOG_DIR="/app/logs"\nRULES_FILE="/app/rules/detection_rules.json"\nAUTH_LOG="$LOG_DIR/auth.log"\nHTTP_LOG="$LOG_DIR/http.log"\nALERT_JSON="/app/reports/alert.json"\nREPORT_JSON="/app/reports/report.json"\n\n# Helper function to parse timestamp to ISO-8601\ntimestamp_to_iso() {\n    local ts="$1"\n    if [[ $ts == *" Apr "* ]]; then\n        # Format: Apr 10 08:12:33\n        local month=$(echo "$ts" | cut -d\' \' -f1 | tr \'[:upper:]\' \'[:lower:]\')\n        local day=$(echo "$ts" | cut -d\' \' -f2)\n        local time=$(echo "$ts" | cut -d\' \' -f3)\n        # Use date command with format %b %d %H:%M:%S\n        date -Iseconds -d "$month $day $time" 2>/dev/null || echo "$ts"\n    else\n        # Already ISO-like? Use as is\n        echo "$ts"\n    fi\n}\n\n# Read rules into array\nread_rules() {\n    local rules_file="$1"\n    local -n rules_array="$2"\n    local -n rule_ids="$3"\n    local -n rule_severities="$4"\n    local -n rule_patterns="$5"\n    local -n rule_thresholds="$6"\n    local -n rule_timeframes="$7"\n    \n    # Use python to parse JSON and extract fields\n    python3 -c "\nimport json\nwith open(\'$rules_file\') as f:\n    data = json.load(f)\n    for rule in data[\'rules\']:\n        rules_array.append(rule[\'id\'])\n        rule_ids.append(rule[\'id\'])\n        rule_severities.append(rule[\'severity\'])\n        rule_patterns.append(rule[\'pattern\'])\n        rule_thresholds.append(rule[\'threshold\'])\n        rule_timeframes.append(rule[\'timeframe\'])\n    print(\'Rules loaded:\', len(rules_array))\n" 2>/dev/null || echo "Failed to load rules"\n}\n\n# Parse timestamps from logs\nparse_logs() {\n    local log_file="$1"\n    local -n timestamps="$2"\n    local -n ips="$3"\n    local -n lines="$4"\n    \n    while IFS= read -r line; do\n        timestamps+=("$line")\n        # Extract IP\n        if [[ "$log_file" == "$AUTH_LOG" ]]; then\n            # auth.log: \'Apr 10 08:12:33 server sshd[1234]: Accepted publickey for admin from 192.168.1.5\'\n            ip=$(echo "$line" | grep -oEo \'([0-9]{1,3}\\.){3}[0-9]{1,3}\' | head -1)\n        else\n            # http.log: \'192.168.1.5 - - [10/Apr/2023:08:30:42 +0000] "GET /index.html HTTP/1.1" 200 4523\'\n            ip=$(echo "$line" | grep -oEo \'([0-9]{1,3}\\.){3}[0-9]{1,3}\' | head -1)\n        fi\n        if [[ -n "$ip" ]]; then\n            ips+=("$ip")\n        fi\n        lines+=("$line")\n    done < "$log_file"\n}\n\n# Main detection\nmain() {\n    # Read rules\n    local -a rule_ids\n    local -a rule_severities\n    local -a rule_patterns\n    local -a rule_thresholds\n    local -a rule_timeframes\n    read_rules "$RULES_FILE" rule_ids rule_severities rule_patterns rule_thresholds rule_timeframes\n    \n    # Parse logs\n    local -a auth_timestamps\n    local -a auth_ips\n    local -a auth_lines\n    parse_logs "$AUTH_LOG" auth_timestamps auth_ips auth_lines\n    \n    local -a http_timestamps\n    local -a http_ips\n    local -a http_lines\n    parse_logs "$HTTP_LOG" http_timestamps http_ips http_lines\n    \n    # Combine all lines, timestamps, IPs\n    local -a all_timestamps=()\n    local -a all_ips=()\n    local -a all_lines=()\n    while [[ ${#auth_lines[@]} -gt 0 ]]; do\n        all_timestamps+=("${auth_timestamps[0]}")\n        all_ips+=("${auth_ips[0]}")\n        all_lines+=("${auth_lines[0]}")\n        auth_timestamps=(${auth_timestamps[@]:1})\n        auth_ips=(${auth_ips[@]:1})\n        auth_lines=(${auth_lines[@]:1})\n    done\n    while [[ ${#http_lines[@]} -gt 0 ]]; do\n        all_timestamps+=("${http_timestamps[0]}")\n        all_ips+=("${http_ips[0]}")\n        all_lines+=("${http_lines[0]}")\n        http_timestamps=(${http_timestamps[@]:1})\n        http_ips=(${http_ips[@]:1})\n        http_lines=(${http_lines[@]:1})\n    done\n    \n    # Convert timestamps to ISO-8601 and store in associative array\n    declare -A ts_to_iso\n    for ts in "${all_timestamps[@]}"; do\n        ts_to_iso["$ts"]=$(timestamp_to_iso "$ts")\n    done\n    \n    # For each rule, count matches and collect IPs within timeframe\n    local -a rule_results\n    for idx in "${!rule_ids[@]}"; do\n        local rule_id="${rule_ids[$idx]}"\n        local pattern="${rule_patterns[$idx]}"\n        local threshold="${rule_thresholds[$idx]}"\n        local timeframe="${rule_timeframes[$idx]}"\n        \n        # Count matches\n        local matches=0\n        local ips_set=""\n        for line in "${all_lines[@]}"; do\n            if [[ $line =~ $pattern ]]; then\n                ((matches++))\n                # Get IP of this line\n                local line_ip\n                if [[ $line =~ "Accepted publickey" ]]; then\n                    line_ip=$(echo "$line" | grep -oEo \'([0-9]{1,3}\\.){3}[0-9]{1,3}\' | head -1)\n                elif [[ $line =~ "Failed password" ]]; then\n                    line_ip=$(echo "$line" | grep -oEo \'([0-9]{1,3}\\.){3}[0-9]{1,3}\' | head -1)\n                elif [[ $line =~ "sudo:" ]]; then\n                    line_ip=$(echo "$line" | grep -oEo \'([0-9]{1,3}\\.){3}[0-9]{1,3}\' | head -1)\n                else\n                    # http.log: extract IP from line\n                    line_ip=$(echo "$line" | grep -oEo \'([0-9]{1,3}\\.){3}[0-9]{1,3}\' | head -1)\n                fi\n                if [[ -n "$line_ip" ]]; then\n                    if [[ -z "$ips_set" ]]; then\n                        ips_set="$line_ip"\n                    else\n                        ips_set="$ips_set,$line_ip"\n                    fi\n                fi\n            fi\n        done\n        \n        # Remove duplicate IPs\n        local unique_ips=$(echo "$ips_set" | tr \',\' \'\\n\' | sort -u | tr \'\\n\' \',\' | sed \'s/,$//\')\n        \n        # Check if matches >= threshold (and timeframe? We\'ll ignore timeframe for now, but we could implement)\n        if [[ $matches -ge $threshold ]]; then\n            rule_results+=("$rule_id:$rule_severities[$idx]:$matches:$unique_ips")\n        fi\n    done\n    \n    # Prepare alert.json\n    local -a alerts\n    for res in "${rule_results[@]}"; do\n        local rule_id=${res%%:*}\n        local severity=${res#*:}\n        local matches=${res#*:*}\n        local ips=${res#*:*:}\n        alerts+=("\\"$rule_id\\":\\"$severity\\",\\"matches\\":$matches,\\"ips\\":\\"$ips\\"")\n    done\n    \n    local timestamp=$(date +%Y-%m-%dT%H:%M:%SZ)\n    cat > "$ALERT_JSON" << EOL\n{\n  "timestamp": "$timestamp",\n  "alerts": [\n    $(echo "${alerts[@]}" | tr \'\\n\' \' \' | sed \'s/, $//\')\n  ]\n}\nEOL\n\n    # Prepare report.json\n    local -a events\n    for res in "${rule_results[@]}"; do\n        local rule_id=${res%%:*}\n        local severity=${res#*:}\n        local matches=${res#*:*}\n        local ips=${res#*:*:}\n        events+=("\\"$rule_id\\":\\"$severity\\",\\"matches\\":$matches,\\"ips\\":\\"$ips\\"")\n    done\n    \n    local statistics=""\n    for res in "${rule_results[@]}"; do\n        local rule_id=${res%%:*}\n        local matches=${res#*:*}\n        statistics="$statistics\\"$rule_id\\":$matches"\n    done\n    \n    cat > "$REPORT_JSON" << EOL\n{\n  "timestamp": "$timestamp",\n  "events": [\n    $(echo "${events[@]}" | tr \'\\n\' \' \' | sed \'s/, $//\')\n  ],\n  "statistics": {\n    $(echo $statistics | sed \'s/^/    /\')\n  }\n}\nEOL\n\necho "Detection complete. Alert saved to $ALERT_JSON, Report saved to $REPORT_JSON"\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
