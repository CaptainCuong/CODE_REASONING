Sending keys: ["cat > analyze.py << 'EOF'\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# Load data\nwith open('graphene.dat', 'r') as f:\n    lines = f.readlines()\n\nx1_list = []\ny1_list = []\nx2_list = []\ny2_list = []\nfor line in lines:\n    parts = line.strip().split()\n    if len(parts) != 2:\n        continue\n    first = parts[0].split(',')\n    second = parts[1].split(',')\n    if len(first) != 2 or len(second) != 2:\n        continue\n    x1, y1 = float(first[0]), float(first[1])\n    x2, y2 = float(second[0]), float(second[1])\n    x1_list.append(x1)\n    y1_list.append(y1)\n    x2_list.append(x2)\n    y2_list.append(y2)\n\nx1 = np.array(x1_list)\ny1 = np.array(y1_list)\nx2 = np.array(x2_list)\ny2 = np.array(y2_list)\n\nprint('Number of measurements:', len(x1_list))\nprint('Unique x1 values:', np.unique(x1)[:5])\nprint('Unique x2 values:', np.unique(x2)[:5])\nprint('Unique y1 values:', np.unique(y1)[:5])\nprint('Unique y2 values:', np.unique(y2)[:5])\n\n# Check if x1 values are all the same\nif np.allclose(x1, x1[0]):\n    print('x1 is constant:', x1[0])\nelse:\n    print('x1 varies')\n\n# Check if x2 values are all the same\nif np.allclose(x2, x2[0]):\n    print('x2 is constant:', x2[0])\nelse:\n    print('x2 varies')\n\n# Plot\nplt.figure()\nplt.scatter(x1, y1, label='G peak', alpha=0.5)\nplt.scatter(x2, y2, label='2D peak', alpha=0.5)\nplt.xlabel('Wavenumber')\nplt.ylabel('Intensity')\nplt.legend()\nplt.title('Raman Peaks')\nplt.savefig('peaks.png')\nplt.close()\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
