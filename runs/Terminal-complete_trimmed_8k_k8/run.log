Sending keys: ["cat > fib_server.py << 'EOF'\nimport http.server\nimport json\nimport urllib.parse\nfrom http.server import HTTPServer, BaseHTTPRequestHandler\n\nclass FibonacciHandler(BaseHTTPRequestHandler):\n    def do_GET(self):\n        # Parse query string\n        query = self.path.split('?', 1)[1] if '?' in self.path else ''\n        if not query:\n            self.send_error(400, 'Query parameter missing')\n            return\n        \n        try:\n            params = urllib.parse.parse_qs(query)\n            n_str = params['n'][0]\n            n = int(n_str)\n        except (ValueError, KeyError):\n            self.send_error(400, 'Invalid integer n')\n            return\n        \n        # Compute Fibonacci\n        if n < 0:\n            self.send_error(400, 'n must be non-negative')\n            return\n        \n        # Compute nth Fibonacci (0-indexed)\n        # F(0) = 0, F(1) = 1\n        if n == 0:\n            result = 0\n        elif n == 1:\n            result = 1\n        else:\n            a, b = 0, 1\n            for _ in range(2, n+1):\n                a, b = b, a + b\n            result = b\n        \n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.end_headers()\n        self.wfile.write(json.dumps({'result': result}).encode())\n\nif __name__ == '__main__':\n    server = HTTPServer(('0.0.0.0', 3000), FibonacciHandler)\n    print('Server starting on port 3000')\n    server.serve_forever()\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
