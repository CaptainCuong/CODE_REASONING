Sending keys: ["cat > sentiment_api.py << 'EOF'\nfrom flask import Flask, request, json\nimport sys\nsys.path.insert(0, '/app/model_cache')\nfrom transformers import AutoModelForSequenceClassification, AutoTokenizer\n\n# Load the model and tokenizer\nmodel = AutoModelForSequenceClassification.from_pretrained('/app/model_cache/sentiment_model')\ntokenizer = AutoTokenizer.from_pretrained('/app/model_cache/sentiment_model')\n\napp = Flask(__name__)\n\n@app.route('/sentiment', methods=['POST'])\ndef sentiment_analysis():\n    try:\n        data = request.get_json()\n        if 'text' not in data:\n            return {'error': 'Missing text field'}, 400\n        text = data['text']\n        # Tokenize the text\n        inputs = tokenizer(text, return_tensors='pt')\n        # Get predictions\n        outputs = model(inputs['input_ids'], attention_mask=inputs['attention_mask'])\n        # Get the probability of positive sentiment (class 1)\n        probabilities = outputs.logits\n        prob_positive = probabilities[0][1].item()  # second class is positive\n        prob_negative = 1 - prob_positive\n        # Determine sentiment\n        if prob_positive > 0.5:\n            sentiment = 'positive'\n        else:\n            sentiment = 'negative'\n        # Prepare response\n        response = {\n            'sentiment': sentiment,\n            'confidence': {\n                'positive': float(prob_positive),\n                'negative': float(prob_negative)\n            }\n        }\n        return response\n    except Exception as e:\n        return {'error': str(e)}, 500\n\nif __name__ == '__main__':\n    app.run(host='0.0.0.0', port=5000, debug=False)\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
