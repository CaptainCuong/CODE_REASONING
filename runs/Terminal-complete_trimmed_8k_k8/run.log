Sending keys: ['cat > /app/detect.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nimport re\nfrom datetime import datetime, timedelta\n\nLOG_DIR = \'/app/logs\'\nRULES_FILE = \'/app/rules/detection_rules.json\'\nAUTH_LOG = f\'{LOG_DIR}/auth.log\'\nHTTP_LOG = f\'{LOG_DIR}/http.log\'\nALERT_JSON = \'/app/reports/alert.json\'\nREPORT_JSON = \'/app/reports/report.json\'\n\ndef parse_timestamp(timestamp_str):\n    """Convert timestamp to ISO-8601 datetime object."""\n    # Try formats\n    formats = [\n        \'%b %d %H:%M:%S\',  # Apr 10 08:12:33\n        \'%Y/%b/%d:%H:%M:%S +0000\',  # 10/Apr/2023:08:30:42 +0000\n        \'%Y-%m-%dT%H:%M:%SZ\',\n    ]\n    for fmt in formats:\n        try:\n            dt = datetime.strptime(timestamp_str, fmt)\n            return dt\n        except ValueError:\n            continue\n    return None\n\ndef parse_logs(log_file):\n    """Parse log file, return list of dicts with timestamp, ip, line."""\n    entries = []\n    with open(log_file, \'r\') as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            dt = parse_timestamp(line)\n            if dt is None:\n                continue\n            # Extract IP\n            ip = re.search(r\'\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b\', line)\n            ip = ip.group(0) if ip else \'\'\n            entries.append({\n                \'timestamp\': dt.isoformat() + \'Z\',\n                \'datetime\': dt,\n                \'line\': line,\n                \'ip\': ip\n            })\n    return entries\n\ndef main():\n    # Load rules\n    with open(RULES_FILE, \'r\') as f:\n        rules_data = json.load(f)\n    rules = rules_data[\'rules\']\n    \n    # Parse logs\n    auth_entries = parse_logs(AUTH_LOG)\n    http_entries = parse_logs(HTTP_LOG)\n    all_entries = auth_entries + http_entries\n    \n    # Group by rule\n    rule_results = {}\n    for rule in rules:\n        rule_id = rule[\'id\']\n        pattern = rule[\'pattern\']\n        threshold = rule[\'threshold\']\n        timeframe = rule[\'timeframe\']  # seconds\n        severity = rule[\'severity\']\n        \n        matches = 0\n        ips_set = set()\n        \n        for entry in all_entries:\n            if re.search(pattern, entry[\'line\']):\n                matches += 1\n                if entry[\'ip\']:\n                    ips_set.add(entry[\'ip\'])\n        \n        if matches >= threshold:\n            rule_results[rule_id] = {\n                \'id\': rule_id,\n                \'severity\': severity,\n                \'matches\': matches,\n                \'ips\': \',\'.join(sorted(ips_set))\n            }\n    \n    # Generate alert.json\n    timestamp = datetime.utcnow().isoformat() + \'Z\'\n    alert = {\n        \'timestamp\': timestamp,\n        \'alerts\': list(rule_results.values())\n    }\n    with open(ALERT_JSON, \'w\') as f:\n        json.dump(alert, f, indent=2)\n    \n    # Generate report.json\n    events = list(rule_results.values())\n    statistics = {rule[\'id\']: rule[\'matches\'] for rule in events}\n    report = {\n        \'timestamp\': timestamp,\n        \'events\': events,\n        \'statistics\': statistics\n    }\n    with open(REPORT_JSON, \'w\') as f:\n        json.dump(report, f, indent=2)\n    \n    print(\'Detection complete. Alert saved to\', ALERT_JSON, \'Report saved to\', REPORT_JSON)\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
