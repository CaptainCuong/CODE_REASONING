pos)\n                    grid[new_pos] = \'.\'\n                    queue.append(new_pos)\n                else:\n                    grid[new_pos] = \'#\'\n            elif response == \'hit wall\':\n                grid[pos] = \'#\'\n            elif response == \'reached exit\':\n                grid[pos] = \'E\'\n                exit_pos = pos\n            else:\n                grid[pos] = \'#\'\n    \n    start_pos = None\n    for (x, y), cell in grid.items():\n        if cell == \'S\':\n            start_pos = (x, y)\n            break\n    \n    if start_pos is None and (0,0) not in grid:\n        start_pos = (0,0)\n    \n    return grid, start_pos, exit_pos\n\nif __name__ == \'__main__\':\n    grid, start, exit_pos = explore_maze(1)\n    print(\'Grid:\')\n    if grid:\n        xs = [x for (x,y) in grid]\n        ys = [y for (x,y) in grid]\n        for y in range(min(ys)-1, max(ys)+2):\n            for x in range(min(xs)-1, max(xs)+2):\n                cell = grid.get((x, y), \'#\')\n                print(cell, end=\'\')\n            print()\n    else:\n        print(\'No grid data\')\n    print(\'Start:\', start)\n    print(\'Exit:\', exit_pos)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
