Sending keys: ["cat > extract_and_save.py << 'EOF'\nimport sys\nimport os\nfrom transformers import AlbertModel, AlbertTokenizer\n\n# Find the model directory\nimport glob\nmodel_dir = glob.glob('/app/cache/*/*.tar.gz')\nif not model_dir:\n    print('No tar.gz found')\n    sys.exit(1)\n\n# Extract the tar.gz to a temporary location\ntar_path = model_dir[0]\nimport subprocess\nsubprocess.run(['tar', '-xzf', tar_path, '-C', '/app/cache'], check=True)\nprint('Extracted to /app/cache')\n\n# Now locate the extracted model files\n# The tar.gz contains directories like 'models', 'config.json', 'tokenizers'\n# Let's find the pytorch_model.bin\nimport shutil\nfor root, dirs, files in os.walk('/app/cache'):\n    for f in files:\n        if f.endswith('.bin'):\n            model_path = os.path.join(root, f)\n            print('Found model:', model_path)\n            break\n    else:\n        continue\n    break\n\n# If no .bin found, try .pt\nfor root, dirs, files in os.walk('/app/cache'):\n    for f in files:\n        if f.endswith('.pt'):\n            model_path = os.path.join(root, f)\n            print('Found model:', model_path)\n            break\n    else:\n        continue\n    break\n\n# Load model and tokenizer\n# We need to find the tokenizer files as well.\n# Let's just load from the extracted directory.\n# The tar.gz likely contains a directory named 'models' and 'tokenizers'.\n# We'll look for the 'models' directory.\nmodels_dir = None\nfor root, dirs, files in os.walk('/app/cache'):\n    if 'models' in dirs:\n        models_dir = os.path.join(root, 'models')\n        break\n\nif models_dir:\n    print('Model directory:', models_dir)\n    # Try to load from the tar path directly\n    model = AlbertModel.from_pretrained(tar_path)\n    tokenizer = AlbertTokenizer.from_pretrained(tar_path)\n    # Save to /app/cache\n    model.save_pretrained('/app/cache')\n    tokenizer.save_pretrained('/app/cache')\n    print('Saved to /app/cache')\nelse:\n    print('Could not find models directory')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
