Sending keys: ['cat > intrusion_detector.sh << \'EOF\'\n#!/bin/bash\nset -e\n\nLOG_DIR="/app/logs"\nRULES_FILE="/app/rules/detection_rules.json"\nOUTPUT_DIR="/app/reports"\n\n# Ensure output directory exists\nmkdir -p "$OUTPUT_DIR"\n\n# Read rules\nif [ ! -f "$RULES_FILE" ]; then\n    echo "Rules file not found: $RULES_FILE"\n    exit 1\nfi\n\n# Parse JSON rules into associative array\nrules=()\nwhile IFS="" read -r line; do\n    if [[ -n "$line" ]]; then\n        rules+=("$line")\n    fi\ndone < "$RULES_FILE"\n\n# We\'ll use jq if available, else parse with grep/sed\nif command -v jq >/dev/null 2>&1; then\n    # Use jq to get each rule\n    jq -r \'.rules[] | "\\(.id):\\(.pattern):\\(.threshold):\\(.timeframe):\\(.severity)"\' "$RULES_FILE" > /tmp/rules.txt\nelse\n    # Fallback: parse manually\n    grep -o \'"id":"[^"]*"\' "$RULES_FILE" | sed \'s/"id":"//\' | sed \'s/"$//\' > /tmp/rule_ids.txt\n    grep -o \'"pattern":"[^"]*"\' "$RULES_FILE" | sed \'s/"pattern":"//\' | sed \'s/"$//\' > /tmp/patterns.txt\n    grep -o \'"threshold":"[^"]*"\' "$RULES_FILE" | sed \'s/"threshold":"//\' | sed \'s/"$//\' > /tmp/thresholds.txt\n    grep -o \'"timeframe":"[^"]*"\' "$RULES_FILE" | sed \'s/"timeframe":"//\' | sed \'s/"$//\' > /tmp/timeframes.txt\n    grep -o \'"severity":"[^"]*"\' "$RULES_FILE" | sed \'s/"severity":"//\' | sed \'s/"$//\' > /tmp/severities.txt\nfi\n\n# We\'ll use jq for simplicity; if not installed, we\'ll need to implement differently.\n# Let\'s assume jq is installed.\n\n# Function to convert timestamp to epoch seconds\ntimestamp_to_epoch() {\n    local ts="$1"\n    # Convert to epoch using date command\n    # For auth.log: "Apr 10 08:12:33"\n    # For http.log: "10/Apr/2023:08:30:42 +0000"\n    # We\'ll try to parse both.\n    if [[ $ts =~ ^[A-Za-z]\\ [0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then\n        # Format: Month DD HH:MM:SS\n        local dt="${ts// /_}"\n        date -Iseconds -d "$dt" +\'%s\'\n    elif [[ $ts =~ ^[0-9]{2}/[A-Za-z]{3}/[0-9]{4}:[0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4}$ ]]; then\n        # Format: DD/Mon/YYYY:HH:MM:SS +0000\n        # Remove leading +\n        local dt="${ts// /_}"\n        date -Iseconds -d "$dt" +\'%s\'\n    else\n        echo "Warning: Unknown timestamp format: $ts"\n        echo 0\n    fi\n}\n\n# Parse auth.log\necho "Parsing auth.log..."\nauth_matches=()\nwhile IFS= read -r line; do\n    # Extract IP\n    ip=$(echo "$line" | grep -oEo \'([0-9]{1,3}\\.){3}[0-9]{1,3}\' | head -1)\n    if [ -z "$ip" ]; then\n        continue\n    fi\n    # Extract timestamp\n    # Example: Apr 10 08:12:33\n    ts=$(echo "$line" | grep -oEo \'[A-Za-z]{3} [0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\')\n    epoch=$(timestamp_to_epoch "$ts")\n    # Store match\n    auth_matches+=("$epoch|$ip|$line")\ndone < "$LOG_DIR/auth.log"\n\n# Parse http.log\necho "Parsing http.log..."\nhttp_matches=()\nwhile IFS= read -r line; do\n    # Extract IP (first token)\n    ip=$(echo "$line" | awk \'{print $1}\')\n    if [ -z "$ip" ]; then\n        continue\n    fi\n    # Extract timestamp: between \'[\' and \']\' after date\n    ts=$(echo "$line" | grep -oEo \'\\[[^]]*\\]\' | grep -oEo \'[0-9]{2}/[A-Za-z]{3}/[0-9]{4}:[0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4}\' | head -1)\n    epoch=$(timestamp_to_epoch "$ts")\n    # Store match\n    http_matches+=("$epoch|$ip|$line")\ndone < "$LOG_DIR/http.log"\n\n# Combine matches\nall_matches=("${auth_matches[@]}" "${http_matches[@]}")\n\n# Now process each rule\nalerts=()\nevents=()\n# We\'ll use associative arrays to store per rule data\n# rule_id -> list of matches (epoch, ip, line)\n# We\'ll use jq to parse rules and loop\nif command -v jq >/dev/null 2>&1; then\n    # Use jq to iterate over rules\n    jq -c \'.rules[] | .id, .pattern, .threshold, .timeframe, .severity\' "$RULES_FILE" > /tmp/rule_entries.txt\n    while IFS="" read -r rule_id pattern threshold timeframe severity; do\n        # Collect matches for this rule\n        matches_for_rule=()\n        for match in "${all_matches[@]}"; do\n            epoch=$(echo "$match" | cut -d\'|\' -f1)\n            ip=$(echo "$match" | cut -d\'|\' -f2)\n            line=$(echo "$match" | cut -d\'|\' -f3)\n            if [[ $line =~ $pattern ]]; then\n                matches_for_rule+=("$epoch|$ip|$line")\n            fi\n        done\n        # Now check each match within timeframe\n        # We\'ll sort matches by epoch and then for each match, count matches within the last timeframe seconds\n        # We\'ll store matches sorted by epoch\n        sorted_matches=($(echo "${matches_for_rule[@]}" | sort -t\'|\' -k1,1n))\n        # For each match, we check the window from epoch - timeframe to epoch\n        # We\'ll use a sliding window approach\n        for match in "${sorted_matches[@]}"; do\n            epoch=$(echo "$match" | cut -d\'|\' -f1)\n            ip=$(echo "$match" | cut -d\'|\' -f2)\n            line=$(echo "$match" | cut -d\'|\' -f3)\n            # Count matches within [epoch - timeframe, epoch]\n            window_matches=()\n            for m in "${sorted_matches[@]}"; do\n                mepoch=$(echo "$m" | cut -d\'|\' -f1)\n                if [ $mepoch -ge $((epoch - timeframe)) ] && [ $mepoch -le $epoch ]; then\n                    window_matches+=("$m")\n                fi\n            done\n            if [ ${#window_matches[@]} -ge $threshold ]; then\n                # Alert triggered\n                # Collect unique IPs for this rule\n                ip_set=()\n                for m in "${window_matches[@]}"; do\n                    mip=$(echo "$m" | cut -d\'|\' -f2)\n                    ip_set+=("$mip")\n                done\n                unique_ips=$(echo "${ip_set[@]}" | sort -u)\n                # Add to alerts\n                alerts+=("$rule_id|$severity|${#window_matches[@]}|$unique_ips")\n                # Also add to events (same as alerts)\n                events+=("$rule_id|$severity|${#window_matches[@]}|$unique_ips")\n                break  # only need one alert per rule? The spec says per rule, we can break after first alert.\n            fi\n        done\n    done\nelse\n    # Fallback: not implemented\n    echo "jq not available, using fallback"\nfi\n\n# Generate alert.json\nif [ ${#alerts[@]} -gt 0 ]; then\n    # Build alerts array\n    alert_json="{"timestamp": "$(date -Iseconds)", "alerts": ["\n    for alert in "${alerts[@]}"; do\n        rule_id=$(echo $alert | cut -d\'|\' -f1)\n        severity=$(echo $alert | cut -d\'|\' -f2)\n        matches=$(echo $alert | cut -d\'|\' -f3)\n        ips=$(echo $alert | cut -d\'|\' -f4)\n        # Escape quotes and commas\n        alert_json+="{"id": "$rule_id", "severity": "$severity", "matches": $matches, "ips": "$ips""\\n        if [ $rule_id != "${alerts[-1]%|$*}" ]; then\n            alert_json+=","\n        fi\n    done\n    alert_json+="]"}\n    echo "$alert_json" > "$OUTPUT_DIR/alert.json"\nelse\n    echo "{\\"timestamp\\": \\"$(date -Iseconds)\\", \\"alerts\\": []}" > "$OUTPUT_DIR/alert.json"\nfi\n\n# Generate report.json\n# We need statistics: number of matches per rule\nstats=()\nfor alert in "${alerts[@]}"; do\n    rule_id=$(echo $alert | cut -d\'|\' -f1)\n    matches=$(echo $alert | cut -d\'|\' -f3)\n    stats+=("$rule_id:$matches")\ndone\n\n# Build statistics object\nstats_json="{"timestamp": "$(date -Iseconds)", "events": ["\nfor alert in "${events[@]}"; do\n    rule_id=$(echo $alert | cut -d\'|\' -f1)\n    severity=$(echo $alert | cut -d\'|\' -f2)\n    matches=$(echo $alert | cut -d\'|\' -f3)\n    ips=$(echo $alert | cut -d\'|\' -f4)\n    events_json+="{"id": "$rule_id", "severity": "$severity", "matches": $matches, "ips": "$ips""\\n    if [ $rule_id != "${events[-1]%|$*}" ]; then\n        events_json+=","\n    fi\ndone\nevents_json+="]"}\n\n# Add statistics\nstats_json+=", """\\n    """\n    stats_json+="    """\\n    """\n\n# We\'ll just do it with jq if available, else we\'ll construct manually.\n# For simplicity, we\'ll use jq to generate report.json with the same structure as alert.json but with events array.\n# We\'ll create a temporary JSON with events array and then merge statistics.\n# Let\'s do it with jq.\nif command -v jq >/dev/null 2>&1; then\n    # Build events array\n    events_array=""\n    for alert in "${events[@]}"; do\n        rule_id=$(echo $alert | cut -d\'|\' -f1)\n        severity=$(echo $alert | cut -d\'|\' -f2)\n        matches=$(echo $alert | cut -d\'|\' -f3)\n        ips=$(echo $alert | cut -d\'|\' -f4)\n        events_array+="{"id": \\"$rule_id\\", "severity": \\"$severity\\", "matches": $matches, "ips": \\"$ips\\"}"\n        if [ $rule_id != "${events[-1]%|$*}" ]; then\n            events_array+=",\n"\n        fi\n    done\n    # Create JSON object with events and statistics\n    jq -n --arg events "$events_array" --arg timestamp "$(date -Iseconds)" \'{timestamp: $timestamp, events: ($events | from_json), statistics: {}}\' > "$OUTPUT_DIR/report.json"\n    # Now add statistics\n    stats_json="$(jq -n --arg stats_json "$(cat "$OUTPUT_DIR/report.json" | grep -A 10 \'statistics\')" \'\' 2>/dev/null || true)\n    # We\'ll just replace the file with a properly formatted one.\n    # Let\'s do a simpler approach: create a temporary file with events array and then add statistics.\n    echo "{\\"timestamp\\": \\"$(date -Iseconds)\\", \\"events\\": [$events_array], \\"statistics\\": {" > "$OUTPUT_DIR/report.json"\n    for stat in "${stats[@]}"; do\n        rule_id=$(echo $stat | cut -d\':\' -f1)\n        count=$(echo $stat | cut -d\':\' -f2)\n        echo "    \\"$rule_id\\": $count" >> "$OUTPUT_DIR/report.json"\n    done\n    echo "  }}" >> "$OUTPUT_DIR/report.json"\nelse\n    # Fallback\n    echo "{\\"timestamp\\": \\"$(date -Iseconds)\\", \\"events\\": [], \\"statistics\\": {" > "$OUTPUT_DIR/report.json"\n    for stat in "${stats[@]}"; do\n        rule_id=$(echo $stat | cut -d\':\' -f1)\n        count=$(echo $stat | cut -d\':\' -f2)\n        echo "    \\"$rule_id\\": $count" >> "$OUTPUT_DIR/report.json"\n    done\n    echo "  }}" >> "$OUTPUT_DIR/report.json"\nfi\n\necho "Detection complete. Alerts written to $OUTPUT_DIR/"\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
