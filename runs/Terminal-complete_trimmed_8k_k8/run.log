json)}\' > /tmp/patch.json\n    jq --argfile patch /tmp/patch -n \'{timestamp: $timestamp, events: ($events_json | from_json), statistics: ($patch | from_json)}\' > "$OUTPUT_DIR/report.json"\n\nrm -f /tmp/rules.json /tmp/stats.json /tmp/patch.json\n\necho "Detection complete. Alerts written to $OUTPUT_DIR/"\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
