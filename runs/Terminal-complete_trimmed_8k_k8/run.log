Sending keys: ['cat > scraper.py << \'EOF\'\nimport requests\nfrom bs4 import BeautifulSoup\nimport pandas as pd\n\ndef main():\n    url = \'http://server:8000\'\n    response = requests.get(url)\n    soup = BeautifulSoup(response.text, \'html.parser\')\n    \n    books = []\n    for book in soup.find_all(\'div\', class_=\'book\'):\n        title = book.find(\'div\', class_=\'book-title\').text.strip()\n        author = book.find(\'div\', class_=\'book-author\').text.strip()\n        # Extract year, rating, price\n        details = book.find(\'div\', class_=\'book-details\')\n        year_span = details.find(\'span\', class_=\'book-year\')\n        rating_span = details.find(\'span\', class_=\'book-rating\')\n        price_span = details.find(\'span\', class_=\'book-price\')\n        \n        year = year_span.text.strip().split(\': \')[1]\n        rating = rating_span.text.strip().split(\': \')[1]\n        price = price_span.text.strip().replace(\'$\', \'\')\n        \n        books.append({\n            \'title\': title,\n            \'author\': author,\n            \'year\': year,\n            \'rating\': rating,\n            \'price\': price\n        })\n    \n    # Convert to DataFrame\n    df = pd.DataFrame(books, columns=[\'title\', \'author\', \'year\', \'rating\', \'price\'])\n    # Save to CSV\n    df.to_csv(\'books.csv\', index=False)\n    \n    # Summary\n    total = len(df)\n    avg_price = df[\'price\'].astype(float).mean()\n    highest_rated = df.loc[df[\'rating\'].astype(float).idxmax()]\n    \n    with open(\'report.txt\', \'w\') as f:\n        f.write(f\'Total number of books scraped: {total}\\n\')\n        f.write(f\'Average book price: ${avg_price:.2f}\\n\')\n        f.write(f\'Highest rated book: {highest_rated["title"]} by {highest_rated["author"]} (Rating: {highest_rated["rating"]})\\n\')\n    \n    print(\'Scraping complete. CSV and report saved.\')\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180