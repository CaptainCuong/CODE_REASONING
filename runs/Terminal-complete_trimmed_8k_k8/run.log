Sending keys: ["cat > process_csv2.py << 'EOF'\nimport csv\nimport json\nfrom datetime import datetime, timezone\n\n# Read departments\ndepartments = []\nwith open('data/departments.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        departments.append(row)\n\n# Read employees\nemployees = []\nwith open('data/employees.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        skills = row['skills'].split(';') if row['skills'] else []\n        emp = {\n            'id': row['id'],\n            'name': row['name'],\n            'position': row['position'],\n            'skills': skills,\n            'years_of_service': int(row['years_of_service']),\n            'department_id': row['department_id']\n        }\n        employees.append(emp)\n\n# Read projects\nprojects = []\nwith open('data/projects.csv', 'r') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        members = row['member_ids'].split(';') if row['member_ids'] else []\n        proj = {\n            'name': row['name'],\n            'status': row['status'],\n            'members': members,\n            'deadline': row['deadline'],\n            'department_id': row['department_id']\n        }\n        projects.append(proj)\n\n# Build organization structure\norg_departments = []\nfor dept in departments:\n    dept_id = dept['id']\n    dept_employees = [e for e in employees if e['department_id'] == dept_id]\n    # Remove department_id from employee objects\n    dept_employees = [e.copy() for e in dept_employees]\n    for e in dept_employees:\n        del e['department_id']\n    dept_projects = [p for p in projects if p['department_id'] == dept_id]\n    # Remove department_id from project objects\n    dept_projects = [p.copy() for p in dept_projects]\n    for p in dept_projects:\n        del p['department_id']\n    org_departments.append({\n        'id': dept_id,\n        'name': dept['name'],\n        'budget': float(dept['budget']),\n      