Sending keys: ["cat > print_pos.py << 'EOF'\nfrom PIL import Image\nimg = Image.open('chess_puzzle.png')\nwidth, height = img.size\nspacing = 80\nwhite = (240, 217, 181)\nblack = (181, 136, 99)\nwhite_set = set()\nblack_set = set()\nfor x in range(width):\n    for y in range(height):\n        r, g, b = img.getpixel((x, y))\n        if (r, g, b) == white:\n            white_set.add((x, y))\n        elif (r, g, b) == black:\n            black_set.add((x, y))\nsquares = {}\nfor x, y in white_set:\n    c = x // spacing\n    rank = 8 - (y // spacing)\n    squares[(c, rank)] = 'w'\nfor x, y in black_set:\n    c = x // spacing\n    rank = 8 - (y // spacing)\n    squares[(c, rank)] = 'b'\nfiles = ['a','b','c','d','e','f','g','h']\nprint('Position:')\nfor rank in range(1, 9):\n    line = ''\n    for file_idx in range(1, 9):\n        if (file_idx-1, rank) in squares:\n            line += squares[(file_idx-1, rank)]\n        else:\n            line += '.'\n    print(f'{rank}: {line}')\n# Count material\nmaterial = {'w': {'p':0, 'n':0, 'b':0, 'r':0, 'q':0, 'k':0}, 'b': {'p':0, 'n':0, 'b':0, 'r':0, 'q':0, 'k':0}}\nfor (c, rank), piece in squares.items():\n    f = files[c % 8]\n    # piece is either 'w' or 'b'\n    material[piece][f] += 1\nprint('\\nMaterial count:')\nfor color in ['w', 'b']:\n    print(f'{color}:', material[color])\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
