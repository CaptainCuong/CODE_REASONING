Sending keys: ["cat > train_model.py << 'EOF'\nimport pandas as pd\nimport fasttext\nimport numpy as np\n\n# Load data\ndf_train = pd.read_parquet('data/train-00000-of-00001.parquet')\ndf_test = pd.read_parquet('data/test-00000-of-00001.parquet')\n\n# Convert label to int\ndf_train['label'] = df_train['label'].astype(int)\ndf_test['label'] = df_test['label'].astype(int)\n\n# Prepare training and test sentences\nsentences_train = [f'{i}|{text}' for i, text in zip(df_train['label'], df_train['text'])]\nsentences_test = [f'{i}|{text}' for i, text in zip(df_test['label'], df_test['text'])]\n\n# Train model with word representation\nmodel = fasttext.FastText(wordvec_dim=300, epoch=20, loss='log_loss', word_representation='word', min_count=5, negative_sample=5)\n\n# Train\nmodel.fit(sentences_train, epochs=20)\n\n# Evaluate on test set\npred = model.predict(sentences_test, k=1)\n# pred is a list of (label, probability) pairs\n# We'll map back to label\nlabels_test = [int(p[0].split('|')[0]) for p in pred]\naccuracy = np.mean(labels_test == df_test['label'])\nprint(f'Accuracy: {accuracy:.4f}')\n\n# Save model\nmodel.save('model.bin')\nprint('Model saved to model.bin')\n\n# Check size\nimport os\nsize = os.path.getsize('model.bin')\nprint(f'Model size: {size} bytes')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
