Sending keys: ['cat > fit_peaks_final.py << \'EOF\'\nimport numpy as np\nfrom scipy.signal import argrelextrema\nfrom scipy.optimize import curve_fit\nimport json\n\ndef lorentzian(x, x0, gamma, amplitude, offset):\n    return amplitude / ((x - x0)**2 + gamma**2) + offset\n\n# Load data\nx_vals = []\ny_vals = []\nwith open(\'graphene.dat\', \'r\') as f:\n    for line in f:\n        parts = line.strip(\'\\n\').split(\',\')\n        combined = []\n        for part in parts:\n            if \'\\t\' in part:\n                combined.extend(part.split(\'\\t\'))\n            else:\n                combined.append(part)\n        if len(combined) >= 4:\n            x_vals.append(float(combined[0]))\n            y_vals.append(float(combined[3]))\nx = np.array(x_vals)\ny = np.array(y_vals)\n\n# Find peaks\npeaks = argrelextrema(y, np.greater)\nprint(f\'Found {len(peaks[0])} peaks\')\n# Sort peaks by intensity\npeak_indices = peaks[0]\npeak_intensities = y[peak_indices]\nsorted_indices = np.argsort(peak_intensities)[::-1]\ntop_indices = peak_indices[sorted_indices[:2]]  # top 2 peaks\nprint(\'Top 2 peaks indices:\', top_indices)\nprint(\'Top 2 peak values:\', y[top_indices])\n\n# Fit each peak\np0_G = [x[top_indices[0]], 20, 1000, 0]\np0_2D = [x[top_indices[1]], 20, 1000, 0]\n\ntry:\n    popt_G, pcov_G = curve_fit(lorentzian, x, y, p0=p0_G, maxfev=5000)\nexcept Exception as e:\n    print(f"G fit failed: {e}")\n    popt_G = p0_G\n\ntry:\n    popt_2D, pcov_2D = curve_fit(lorentzian, x, y, p0=p0_2D, maxfev=5000)\nexcept Exception as e:\n    print(f"2D fit failed: {e}")\n    popt_2D = p0_2D\n\nresults = {\n    "G": {\n        "x0": float(popt_G[0]),\n        "gamma": float(popt_G[1]),\n        "amplitude": float(popt_G[2]),\n        "offset": float(popt_G[3])\n    },\n    "2D": {\n        "x0": float(popt_2D[0]),\n        "gamma": float(popt_2D[1]),\n        "amplitude": float(popt_2D[2]),\n        "offset": float(popt_2D[3])\n    }\n}\n\nwith open(\'results.json\', \'w\') as f:\