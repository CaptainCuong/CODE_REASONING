Sending keys: ['cat > fit_peaks2.py << \'EOF\'\nimport numpy as np\nfrom scipy.optimize import curve_fit\nimport json\nimport re\n\n# Load data\nwith open(\'graphene.dat\', \'r\') as f:\n    lines = f.readlines()\n\nx_vals = []\ny_vals = []\nfor line in lines:\n    raw = line.rstrip(\'\\n\')\n    split_line = re.split(r\'[\\t,]\', raw)\n    if len(split_line) != 4:\n        continue\n    a, b, c, d = split_line\n    x_vals.append(float(b))  # wavenumber (second column)\n    y_vals.append(float(a))  # intensity (first column)\n\nx = np.array(x_vals)\ny = np.array(y_vals)\n\n# Gaussian function\ndef gaussian(x, x0, gamma, amplitude, offset):\n    return amplitude * np.exp(-0.5 * ((x - x0) / gamma) ** 2) + offset\n\n# Sum of two Gaussians\ndef model(x, x01, gamma1, amp1, offset1, x02, gamma2, amp2, offset2):\n    return gaussian(x, x01, gamma1, amp1, offset1) + gaussian(x, x02, gamma2, amp2, offset2)\n\n# Initial guesses\np0 = (1580, 10, 10000, 0, 2700, 30, 5000, 0)\n\n# Fit\ntry:\n    popt, pcov = curve_fit(model, x, y, p0=p0, maxfev=5000)\n    x01, gamma1, amp1, offset1, x02, gamma2, amp2, offset2 = popt\n    print(\'Fit successful\')\nexcept Exception as e:\n    print(f\'Fit failed: {e}\')\n    popt = None\n    x01, gamma1, amp1, offset1, x02, gamma2, amp2, offset2 = 0, 0, 0, 0, 0, 0, 0, 0\n\n# Prepare results\nresults = {\n    "G": {\n        "x0": float(x01),\n        "gamma": float(gamma1),\n        "amplitude": float(amp1),\n        "offset": float(offset1)\n    },\n    "2D": {\n        "x0": float(x02),\n        "gamma": float(gamma2),\n        "amplitude": float(amp2),\n        "offset": float(offset2)\n    }\n}\n\n# Write to file\nwith open(\'results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint(\'Results written to results.json\')\nprint(\'G:\', results[\'G\'])\nprint(\'2D:\', results[\'2D\'])\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
