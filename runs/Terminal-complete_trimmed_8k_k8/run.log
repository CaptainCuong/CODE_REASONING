Sending keys: ["cat > app.py << 'EOF'\nimport json\nfrom flask import Flask, request, jsonify\nimport sys\nimport os\nsys.path.insert(0, '/app/model_cache')\nfrom transformers import AutoModelForSequenceClassification\n\napp = Flask(__name__)\nmodel = AutoModelForSequenceClassification.from_pretrained('/app/model_cache/sentiment_model')\n\ndef get_sentiment(text):\n    # Input: list of text strings, output: list of probabilities (logits)\n    # The model expects a batch of inputs, returns a batch of probabilities.\n    # We'll get the probability for positive (class 1) and negative (class 0)\n    # The model's output is a tensor of shape (batch_size, num_classes)\n    # For binary classification, num_classes = 2.\n    outputs = model([text], return_dict=False)\n    # outputs is a list of probabilities (logits) for each input\n    prob = outputs[0]\n    # Assuming class 0 is negative, class 1 is positive\n    confidence_positive = prob[1]  # probability for positive\n    confidence_negative = prob[0]  # probability for negative\n    # Determine sentiment: positive if confidence_positive > 0.5 else negative\n    if confidence_positive > 0.5:\n        sentiment = 'positive'\n    else:\n        sentiment = 'negative'\n    return {\n        'sentiment': sentiment,\n        'confidence': {\n            'positive': float(confidence_positive),\n            'negative': float(confidence_negative)\n        }\n    }\n\n@app.route('/sentiment', methods=['POST'])\ndef sentiment():\n    try:\n        data = request.get_json()\n        if 'text' not in data:\n            return {'error': 'Missing text field'}\n        text = data['text']\n        if not isinstance(text, str):\n            return {'error': 'text must be a string'}\n        result = get_sentiment(text)\n        return result\n    except Exception as e:\n        return {'error': str(e)}\n\nif __name__ == '__main__':\n    app.run(host='0.0.0.0', port=5000, debug=False)\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
