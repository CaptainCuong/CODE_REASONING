Sending keys: ["cat > server.py << 'EOF'\nimport http.server\nimport json\nimport sys\nimport urllib.parse\n\nclass FibonacciHandler(http.server.SimpleHTTPRequestHandler):\n    def do_GET(self):\n        # Extract query string\n        query = self.path.split('?', 1)[1] if '?' in self.path else ''\n        if not query:\n            self.send_error(400, 'Missing query parameter n')\n            return\n        # Parse query parameters\n        params = urllib.parse.parse_qs(query)\n        if 'n' not in params:\n            self.send_error(400, 'Missing query parameter n')\n            return\n        n_str = params['n'][0]\n        try:\n            n = int(n_str)\n        except ValueError:\n            self.send_error(400, 'Parameter n must be an integer')\n            return\n        # Compute Fibonacci number\n        if n == 0:\n            result = 0\n        elif n == 1:\n            result = 1\n        else:\n            a, b = 0, 1\n            for _ in range(2, n+1):\n                a, b = b, a + b\n            result = b\n        # Return JSON\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.end_headers()\n        self.wfile.write(json.dumps({'result': result}).encode('utf-8'))\n\nif __name__ == '__main__':\n    server = http.server.HTTPServer(('0.0.0.0', 3000), FibonacciHandler)\n    print('Starting server on port 3000...')\n    server.serve_forever()\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
