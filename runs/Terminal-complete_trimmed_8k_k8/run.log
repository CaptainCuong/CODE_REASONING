": float(x02),\n        "gamma": float(gamma2),\n        "amplitude": float(amp2),\n        "offset": float(offset2)\n    }\n}\n\n# Write to file\nwith open(\'/app/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint(\'Results written to /app/results.json\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
