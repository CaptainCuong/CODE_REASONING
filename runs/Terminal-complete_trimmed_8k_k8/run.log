Sending keys: ["cat > load_model.py << 'EOF'\nimport tensorflow as tf\nimport os\n\n# Load the checkpoint\ncheckpoint_dir = 'gpt2-124M.ckpt'\n# Try to load as a directory\nif os.path.isdir(checkpoint_dir):\n    print('Checkpoint is a directory')\n    # List files\n    for f in os.listdir(checkpoint_dir):\n        print(f)\n    # If there are .bin files, we can load them\n    bin_files = [f for f in os.listdir(checkpoint_dir) if f.endswith('.bin')]\n    if bin_files:\n        # Load the graph from the bin files\n        # We'll try to load the graph from the bin files using tf.load_graph_def\n        # But we need to know the graph structure. Let's try to load the graph from the bin files by using the checkpoint.\n        # We'll use tf.load_checkpoint which expects a directory.\n        g = tf.Graph()\n        with g.as_default():\n            tf.load_checkpoint(checkpoint_dir, checkpoint_name='gpt2')\n        # Now print the nodes\n        for node in g.as_graph_def().node:\n            print(node.name, node.op, node.input[:5])\n        # Also print the input and output nodes\n        # We can get the input nodes by looking for nodes with name starting with 'input' or 'source'\n        # But let's just print all nodes.\n    else:\n        print('No .bin files found')\nelse:\n    print('Checkpoint is a file')\n    # Try to load the file as a checkpoint\n    # TensorFlow 1.x checkpoints are stored in a single file, but we can use tf.load_checkpoint which expects a directory.\n    # We can create a temporary directory and extract the bin files.\n    # Alternatively, we can use tf.load_graph_def to load the graph from the file.\n    # But we don't have the graph structure. Let's try to load the graph from the file by using tf.load_graph_def.\n    # We'll read the file as binary and parse the graph.\n    with open(checkpoint_dir, 'rb') as f:\n        data = f.read()\n    # Parse the graph\n    graph_def = tf.GraphDef()\n    graph_def.ParseFromString(data)\n    # Now print the nodes\n    for node in graph_def.node:\n        print(node.name, node.op, node.input[:5])\n    # Also print the input and output nodes\n    # We can get the input nodes by looking for nodes with name starting with 'input' or 'source'\n    # But let's just print all nodes.\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
