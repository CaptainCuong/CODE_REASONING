1,a2,g2,a3,off1,a4,g3,off2: \\\n                               lorentzian(x, a1,g1,a2,g2,off1) + lorentzian(x, a3,g3,a4,g4,off2), \\\n                               x_data, y_data, p0=p0, maxfev=10000)\n    print('Fit successful')\n    print('Optimal parameters:', popt)\nexcept Exception as e:\n    print('Fit failed:', e)\n    # Fallback to previous results\n    popt = None\n\nif popt is None:\n    # Use previous results\n    popt = [1720.7642965496277, -279.54186477175756, -4502300832.017437, -14340876.988289533, \n            2843.9918118061714, 30.485109443506143, 3505808.8768856595, 465571.6895986762]\n    print('Using previous results')\n\n# Convert to cm-1\nx0_G_cm = popt[0]\ngamma_G = popt[1]\namp_G = popt[2]\noffset_G = popt[3]\nx0_2D_cm = popt[4]\ngamma_2D = popt[5]\namp_2D = popt[6]\noffset_2D = popt[7]\n\nprint('Results:')\nprint('G: x0=', x0_G_cm, 'gamma=', gamma_G, 'amplitude=', amp_G, 'offset=', offset_G)\nprint('2D: x0=', x0_2D_cm, 'gamma=', gamma_2D, 'amplitude=', amp_2D, 'offset=', offset_2D)\n\n# Write results\nresults = {\n    'G': {\n        'x0': float(x0_G_cm),\n        'gamma': float(gamma_G),\n        'amplitude': float(amp_G),\n        'offset': float(offset_G)\n    },\n    '2D': {\n        'x0': float(x0_2D_cm),\n        'gamma': float(gamma_2D),\n        'amplitude': float(amp_2D),\n        'offset': float(offset_2D)\n    }\n}\n\nwith open('results.json', 'w') as f:\n    json.dump(results, f, indent=2)\nprint('Results written to results.json')\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
