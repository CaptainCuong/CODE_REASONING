Sending keys: ['cat > bitcoin_service.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nBitcoin Blockchain Service\n"""\n\nimport json\nimport sys\nfrom flask import Flask, request, abort\nfrom bitcoinlib import client\nfrom bitcoinlib.utils import to_bytes\nfrom typing import Dict, Any, List, Optional\n\n# Configuration\nRPC_HOST = \'localhost\'\nRPC_PORT = 8333\nAPI_PORT = 5000\n\napp = Flask(__name__)\n\n# RPC client\nrpc = client.RPCClient(RPC_HOST, RPC_PORT)\n\n# Helper function to convert hex strings to bytes for comparison\ndef hex_to_bytes(hex_str: str) -> bytes:\n    return bytes.fromhex(hex_str)\n\n# Helper function to convert bytes to hex string\ndef bytes_to_hex(b: bytes) -> str:\n    return b.hex()\n\n# Helper function to convert integer to hex string\ndef int_to_hex(i: int) -> str:\n    return format(i, \'x\')\n\n# Helper function to convert hex string to integer\ndef hex_to_int(hex_str: str) -> int:\n    return int(hex_str, 16)\n\n# Function to get block details\ndef get_block(block_hash: str) -> Dict[str, Any]:\n    """Return block details for given block hash."""\n    try:\n        block = rpc.get_block(block_hash)\n        # Convert block data to required schema\n        block_data = {\n            \'hash\': block[\'hash\'],\n            \'height\': block[\'height\'],\n            \'merkleroot\': block[\'merkleroot\'],\n            \'time\': block[\'time\'],\n            \'nonce\': block[\'nonce\'],\n            \'tx\': [tx[\'hash\'] for tx in block[\'transactions\']]\n        }\n        return block_data\n    except Exception as e:\n        raise e\n\n# Function to get transaction details\ndef get_transaction(txid: str) -> Dict[str, Any]:\n    """Return transaction details for given transaction ID."""\n    try:\n        tx = rpc.get_transaction(txid)\n        # Convert transaction data to required schema\n        vin = []\n        for input_obj in tx[\'inputs\']:\n            vin.append({\n                \'coinbase\': input_obj[\'script\'] if input_obj[\'script\'] else \'\',\n                \'sequence\': input_obj[\'sequence\']\n            })\n        vout = []\n        for output_obj in tx[\'outputs\']:\n            vout.append({\n                \'value\': output_obj[\'value\'],\n                \'n\': output_obj[\'n\'],\n                \'scriptPubKey\': {\n                    \'asm\': output_obj[\'script\'][\'asm\'],\n                    \'hex\': output_obj[\'script\'][\'hex\'],\n                    \'type\': output_obj[\'script\'][\'type\']\n                }\n            })\n        block_hash = tx[\'block_hash\']\n        tx_data = {\n            \'txid\': tx[\'txid\'],\n            \'blockhash\': block_hash,\n            \'vin\': vin,\n            \'vout\': vout\n        }\n        return tx_data\n    except Exception as e:\n        raise e\n\n# Function to get network status\ndef get_status() -> Dict[str, Any]:\n    """Return network status."""\n    try:\n        info = rpc.get_info()\n        return {\n            \'status\': \'online\'\n        }\n    except Exception as e:\n        return {\n            \'error\': str(e)\n        }\n\n# Error handling for invalid block hash\ndef block_not_found(block_hash: str):\n    return {\n        \'error\': f\'Block not found: {block_hash}\',\n        \'status\': 404\n    }\n\n# Error handling for invalid transaction ID\ndef transaction_not_found(txid: str):\n    return {\n        \'error\': f\'Transaction not found: {txid}\',\n        \'status\': 404\n    }\n\n# Error handling for connection issues\ndef connection_error():\n    return {\n        \'error\': \'Not connected to the Bitcoin network\',\n        \'status\': 503\n    }\n\n# Main route: /block/<block_hash>\n@app.route(\'/block/<block_hash>\', methods=[\'GET\'])\ndef block_endpoint(block_hash: str):\n    """Get block details."""\n    try:\n        block_data = get_block(block_hash)\n        return json.dumps(block_data), 200\n    except Exception as e:\n        error_msg = str(e)\n        if \'Block not found\' in error_msg:\n            return json.dumps({\'error\': error_msg}), 404\n        else:\n            return json.dumps({\'error\': error_msg}), 503\n\n# Main route: /transaction/<txid>\n@app.route(\'/transaction/<txid>\', methods=[\'GET\'])\ndef transaction_endpoint(txid: str):\n    """Get transaction details."""\n    try:\n        tx_data = get_transaction(txid)\n        return json.dumps(tx_data), 200\n    except Exception as e:\n        error_msg = str(e)\n        if \'Transaction not found\' in error_msg:\n            return json.dumps({\'error\': error_msg}), 404\n        else:\n            return json.dumps({\'error\': error_msg}), 503\n\n# Main route: /status\n@app.route(\'/status\', methods=[\'GET\'])\ndef status_endpoint():\n    """Get network status."""\n    status_data = get_status()\n    return json.dumps(status_data), 200\n\n# Error handler for other exceptions\n@app.errorhandler(500)\ndef handle_500(e):\n    return json.dumps({\'error\': str(e)}), 500\n\n# Start the server\nif __name__ == \'__main__\':\n    # Check if we can connect to the RPC server\n    try:\n        # Attempt to get a simple status\n        rpc.get_info()\n    except Exception as e:\n        print(f\'Error connecting to RPC server: {e}\', file=sys.stderr)\n        sys.exit(1)\n    \n    print(f\'Service started on http://localhost:{API_PORT}\')\n    app.run(host=\'localhost\', port=API_PORT, debug=False)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
