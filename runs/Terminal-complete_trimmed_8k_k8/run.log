Sending keys: ['cat > server.py << \'EOF\'\nimport http.server\nimport urllib.parse\nimport sys\n\n# Fibonacci function\ndef fib(n):\n    if n <= 0:\n        return 0\n    if n == 1:\n        return 1\n    return fib(n-1) + fib(n-2)\n\nclass FibonacciHandler(http.server.BaseHTTPRequestHandler):\n    def do_GET(self):\n        parsed = urllib.parse.urlparse(self.path)\n        query = urllib.parse.parse_qs(parsed.query)\n        \n        if parsed.path != \'/fib\':\n            self.send_error(400, \'Invalid request\')\n            return\n        \n        # Check for n parameter\n        if \'n\' not in query:\n            self.send_error(400, \'Missing query parameter n\')\n            return\n        \n        n_str = query[\'n\'][0]\n        # Validate integer\n        if not n_str.isdigit():\n            self.send_error(400, \'Query parameter n must be an integer\')\n            return\n        n = int(n_str)\n        if n < 0:\n            self.send_error(400, \'Query parameter n must be a non-negative integer\')\n            return\n        \n        result = fib(n)\n        self.send_response(200)\n        self.send_header(\'Content-Type\', \'application/json\')\n        self.end_headers()\n        self.wfile.write(f\'{{\\"result\\": {result}}}.encode()\')\n\nif __name__ == \'__main__\':\n    handler = FibonacciHandler\n    server = http.server.HTTPServer((\'0.0.0.0\', 3000), handler)\n    print(\'Starting server on port 3000...\')\n    server.serve_forever()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
