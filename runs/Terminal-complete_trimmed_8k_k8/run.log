    # Add summary\n    echo "" >> "$report_file"\n    echo "=== SUMMARY ===" >> "$report_file"\n    echo "Total lines in auth.log for IP: $(grep -c "from $ip" "$LOG_DIR/auth.log")" >> "$report_file"\n    echo "Total lines in http.log for IP: $(grep -c "$ip" "$LOG_DIR/http.log")" >> "$report_file"\n    \n    echo "Report written to $report_file"\n}\n\nmain\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
