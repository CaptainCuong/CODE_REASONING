Sending keys: ['cat > cli_tool.py << \'EOF\'\n#!/usr/bin/env python3\nimport sys\nimport json\nimport lodepng\nimport numpy as np\n\ndef load_weights():\n    with open(\'weights.json\', \'r\') as f:\n        data = json.load(f)\n    # Expected keys: input_layer.weight, input_layer.bias, hidden_layer.weight, hidden_layer.bias, output_layer.weight, output_layer.bias\n    # Convert to numpy arrays\n    weight_dict = {}\n    for key, val in data.items():\n        weight_dict[key] = np.array(val)\n    return weight_dict\n\ndef load_image(filename):\n    with open(filename, \'rb\') as f:\n        image_data, width, height = lodepng.load(f)\n    # image_data is a list of bytes (0-255)\n    img = np.array(image_data, dtype=np.uint8)\n    # Normalize to 0-1\n    img = img / 255.0\n    return img\n\ndef inference(weights, image):\n    # image shape (28,28)\n    input_layer_weight = weights[\'input_layer.weight\']\n    input_layer_bias = weights[\'input_layer.bias\']\n    hidden_layer_weight = weights[\'hidden_layer.weight\']\n    hidden_layer_bias = weights[\'hidden_layer.bias\']\n    output_layer_weight = weights[\'output_layer.weight\']\n    output_layer_bias = weights[\'output_layer.bias\']\n    \n    # Flatten image\n    input_size = 28 * 28\n    x = image.flatten()\n    \n    # Input layer\n    z1 = np.dot(x, input_layer_weight) + input_layer_bias\n    a1 = np.maximum(z1, 0)\n    \n    # Hidden layer\n    z2 = np.dot(a1, hidden_layer_weight) + hidden_layer_bias\n    a2 = np.maximum(z2, 0)\n    \n    # Output layer\n    z3 = np.dot(a2, output_layer_weight) + output_layer_bias\n    a3 = np.exp(z3) / np.sum(np.exp(z3))\n    \n    # Predict\n    predicted = np.argmax(a3)\n    return predicted\n\ndef main():\n    if len(sys.argv) != 3:\n        print("Usage: cli_tool weights.json image.png")\n        sys.exit(1)\n    weights = load_weights()\n    image = load_image(sys.argv[2])\n    predicted = inference(weights, image)\n    print(predicted)\n    with open(\'prediction.txt\',