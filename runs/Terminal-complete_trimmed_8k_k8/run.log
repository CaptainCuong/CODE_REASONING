Sending keys: ["cat > explore2.py << 'EOF'\nimport numpy as np\nimport csv\n\nwith open('graphene.dat', 'r') as f:\n    lines = f.readlines()\n# parse each line\nx = []\ny_g = []\ny_2d = []\nfor line in lines:\n    parts = line.strip().split(',')\n    # parts[0] and parts[2] are first and third numbers\n    # parts[1] and parts[3] are second and fourth\n    # Actually the second part contains a tab, so split again\n    y = []\n    for p in parts:\n        sub = p.split()\n        y.extend(sub)\n    # y[0] is first column, y[1] second, y[2] third (G), y[3] fourth (2D)\n    x.append(float(y[0]))\n    y_g.append(float(y[2]))\n    y_2d.append(float(y[3]))\n\nx = np.array(x)\ny_g = np.array(y_g)\ny_2d = np.array(y_2d)\nprint('Length:', len(x))\nprint('G column stats:')\nprint('  min:', y_g.min(), 'max:', y_g.max(), 'mean:', y_g.mean())\nprint('  max index:', np.argmax(y_g), 'max value:', y_g.max())\nprint('2D column stats:')\nprint('  min:', y_2d.min(), 'max:', y_2d.max(), 'mean:', y_2d.mean())\nprint('  max index:', np.argmax(y_2d), 'max value:', y_2d.max())\n# Find all local maxima in G column\nfrom scipy.signal import find_peaks\npeaks, _ = find_peaks(y_g, distance=10)\nprint('Number of peaks in G:', len(peaks))\nif len(peaks) > 0:\n    print('Peak positions:', x[peaks])\n    print('Peak heights:', y_g[peaks])\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
