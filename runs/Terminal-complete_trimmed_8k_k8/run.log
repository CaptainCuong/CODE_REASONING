ta, dict) and 'input_layer' in data:\n    # Convert to list of lists\n    weights = {\n        'W_input': data['input_layer']['weight'].tolist(),\n        'W_hidden': data['hidden_layer']['weight'].tolist(),\n        'W_output': data['output_layer']['weight'].tolist(),\n        'input_dim': data['input_layer']['weight'].shape[0],\n        'hidden_dim': data['hidden_layer']['weight'].shape[0],\n        'num_classes': data['output_layer']['weight'].shape[0]\n    }\n    import json\n    with open('weights.json', 'w') as f:\n        json.dump(weights, f, indent=2)\n    print('Saved weights from model.pth')\nelse:\n    print('No weights found in model.pth')\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
